{
  "info": {
    "name": "Inova CMS Open API — Indosatu",
    "description": "Open API CMS untuk integrasi sistem pihak ketiga. Isi variabel koleksi base_url, access_key, secret, portal_id, lalu jalankan Health. Signature HMAC dihitung otomatis oleh pre-request script koleksi. Dokumentasi lengkap: PANDUAN-OPEN-API-INDOSATU.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Menandatangani setiap request dengan HMAC-SHA256 (lihat PANDUAN-OPEN-API.md bagian 3).",
          "const CryptoJS = require('crypto-js');",
          "",
          "const accessKey = pm.variables.get('access_key');",
          "const secret = pm.variables.get('secret');",
          "if (!accessKey || !secret) {",
          "  throw new Error('Isi variabel koleksi access_key dan secret terlebih dahulu.');",
          "}",
          "",
          "const SAFE = /[A-Za-z0-9*\\-._]/;",
          "function formEncode(s) {",
          "  const bytes = unescape(encodeURIComponent(s)); // string UTF-8 per byte",
          "  let out = '';",
          "  for (let i = 0; i < bytes.length; i++) {",
          "    const ch = bytes[i];",
          "    if (SAFE.test(ch)) out += ch;",
          "    else if (ch === ' ') out += '+';",
          "    else out += '%' + ch.charCodeAt(0).toString(16).toUpperCase().padStart(2, '0');",
          "  }",
          "  return out;",
          "}",
          "function formDecode(s) {",
          "  try { return decodeURIComponent(s.replace(/\\+/g, ' ')); } catch (e) { return s; }",
          "}",
          "",
          "// Path lengkap setelah variabel {{base_url}} diganti, mis. /openapi/v1/articles",
          "const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "const path = resolvedUrl.replace(/^[a-z]+:\\/\\/[^/]+/i, '').split('#')[0].split('?')[0];",
          "",
          "// Canonical query: decode, urutkan key lalu value, encode form-urlencoded",
          "const pairs = pm.request.url.query.all()",
          "  .filter((q) => !q.disabled && q.key)",
          "  .map((q) => [formDecode(pm.variables.replaceIn(q.key)), formDecode(pm.variables.replaceIn(q.value || ''))])",
          "  .sort((a, b) => (a[0] === b[0] ? (a[1] < b[1] ? -1 : a[1] > b[1] ? 1 : 0) : a[0] < b[0] ? -1 : 1));",
          "const canonicalQuery = pairs.map(([k, v]) => formEncode(k) + '=' + formEncode(v)).join('&');",
          "",
          "const body = pm.request.body && pm.request.body.mode === 'raw'",
          "  ? pm.variables.replaceIn(pm.request.body.raw || '')",
          "  : '';",
          "const contentSha = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "const timestamp = new Date().toISOString().replace(/\\.\\d{3}Z$/, 'Z');",
          "const nonce = pm.variables.replaceIn('{{$guid}}');",
          "",
          "const canonical = [pm.request.method.toUpperCase(), path, canonicalQuery, timestamp, nonce, contentSha].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
          "",
          "pm.request.headers.upsert({ key: 'X-AIV-Access-Key', value: accessKey });",
          "pm.request.headers.upsert({ key: 'X-AIV-Timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-AIV-Nonce', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-AIV-Content-SHA256', value: contentSha });",
          "pm.request.headers.upsert({ key: 'X-AIV-Signature', value: signature });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (body) pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "",
          "console.log('Canonical string:\\n' + canonical);"
        ]
      }
    }
  ],
