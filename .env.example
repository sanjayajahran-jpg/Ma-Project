# Portal & API Configuration (Backend Berita Mentor)
PUBLIC_PORTAL_DOMAIN=evhub.id
PUBLIC_SITE_URL=https://evhub.id
PUBLIC_API_URL=https://api-cms.bukin.id/api/v1
SERVER_API_URL=https://api-cms.bukin.id/api/v1
PUBLIC_SITE_NAME=EVHUB
PUBLIC_SITE_PUBLISHER=EVHub Media Elektrifikasi
# Set true jika domain belum terdaftar di database CMS mentor, agar menggunakan data fallback
PUBLIC_USE_FALLBACK_DATA=true

# Local Theme Override (default: Automotive untuk EVNesia)
PUBLIC_THEME=Automotive

