---
/** Tombol bagikan ringan tanpa framework (S5-9). Link dibangun di klien. */
interface Props {
  title: string;
  class?: string;
}
const { title, class: cls = "" } = Astro.props;
const btn =
  "inline-grid h-9 w-9 place-items-center rounded-full ring-1 ring-line text-ink hover:bg-cream transition-colors";
---

<div class:list={["flex items-center gap-2", cls]} data-share data-title={title}>
  <span class="kicker mr-1 text-muted">Bagikan</span>

  <a class={btn} data-net="twitter" target="_blank" rel="noopener" aria-label="Bagikan ke X" href="#">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>
  <a class={btn} data-net="wa" target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp" href="#">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.34-.5.04-1.13.21-3.65-.76-3.07-1.21-5.04-4.33-5.2-4.53-.15-.2-1.24-1.65-1.24-3.15s.79-2.24 1.07-2.55c.28-.31.61-.38.81-.38.2 0 .4 0 .58.01.19.01.44-.07.69.53.24.6.83 2.07.9 2.22.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.18-.31.39-.45.53-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.71.81 2 .96.3.15.5.22.57.34.07.13.07.73-.17 1.42z"/></svg>
  </a>
  <a class={btn} data-net="fb" target="_blank" rel="noopener" aria-label="Bagikan ke Facebook" href="#">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07z"/></svg>
  </a>
  <button type="button" class={btn} data-copy aria-label="Salin tautan">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
  </button>
</div>

<script>
  function initShare() {
    const url = window.location.href;
    document.querySelectorAll<HTMLElement>("[data-share]").forEach((box) => {
      const title = box.dataset.title || document.title;
      const enc = encodeURIComponent;
      const links: Record<string, string> = {
        twitter: `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`,
        wa: `https://wa.me/?text=${enc(title + " " + url)}`,
        fb: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
      };
      box.querySelectorAll<HTMLAnchorElement>("a[data-net]").forEach((aEl) => {
        const net = aEl.dataset.net!;
        if (links[net]) aEl.href = links[net];
      });
      const copyBtn = box.querySelector<HTMLButtonElement>("[data-copy]");
      copyBtn?.addEventListener("click", async () => {
        try {
          if (navigator.share) {
            await navigator.share({ title, url });
          } else {
            await navigator.clipboard.writeText(url);
            copyBtn.setAttribute("aria-label", "Tautan tersalin");
            copyBtn.classList.add("bg-cream");
            setTimeout(() => copyBtn.setAttribute("aria-label", "Salin tautan"), 1500);
          }
        } catch {}
      });
    });
  }
  document.addEventListener("astro:page-load", initShare);
</script>
