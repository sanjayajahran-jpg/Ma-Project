---
// Featured Hero Showcase Section - EVnesia Top Hero Banner
const FEATURED_HERO = {
  category: "UJI JALAN EKSKLUSIF",
  badge: "LIPUTAN UTAMA EV",
  title: "2026 Porsche Taycan Turbo GT: Rekor Baru Nürburgring & Electric Performance 1.092 HP",
  description: "Pengujian komprehensif versi produksi paling bertenaga dari Porsche dengan dual-motor Attack Mode, akselerasi 0-100 km/j dalam 2.2 detik, serta efisiensi pengisian DC 320 kW (10-80% dalam 18 menit).",
  author: "Redaksi EVnesia",
  date: "23 Agustus 2026",
  readTime: "5 menit baca",
  link: "/kategori/ulasan-test-drive",
  image: "https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?q=75&w=900&auto=format&fit=crop",
  stats: [
    { label: "Tenaga Listrik", val: "1.092 HP" },
    { label: "0-100 km/j", val: "2.2 Detik" },
    { label: "Jarak Tempuh", val: "555 km" },
    { label: "Fast Charge DC", val: "18 Menit" }
  ]
};

const SIDE_TRENDING = [
  {
    id: "toyota-solid-state",
    category: "TEKNOLOGI BATERAI",
    title: "Baterai Solid-State Jarak 1.200 KM Siap Produksi Massal di 2027",
    time: "15 mnt lalu",
    img: "https://images.unsplash.com/photo-1555215695-3004980adade?q=70&w=240&auto=format&fit=crop",
    link: "/kategori/ev-teknologi"
  },
  {
    id: "spklu-trans-jawa",
    category: "PANDUAN SPKLU",
    title: "Peta 45 Titik SPKLU Ultra-Fast Charging Tol Trans-Jawa 2026",
    time: "35 mnt lalu",
    img: "https://images.unsplash.com/photo-1558981806-ec527fa84c39?q=70&w=240&auto=format&fit=crop",
    link: "/kategori/ev-teknologi"
  },
  {
    id: "byd-yangwang",
    category: "SUPERCAR LISTRIK",
    title: "BYD Yangwang U9 Tembus 375 km/j dengan Platform e4 Quad-Motor",
    time: "1 jam lalu",
    img: "https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?q=70&w=240&auto=format&fit=crop",
    link: "/kategori/berita"
  }
];
---

<div class="grid gap-6 lg:grid-cols-[1.6fr_1fr] items-stretch">
  <!-- MAIN FEATURED HERO BANNER (Left Side Large Spotlight with Breathing Room for Photo) -->
  <div class="relative overflow-hidden rounded-3xl border border-line shadow-2xl group min-h-115 flex flex-col justify-end">
    <!-- Background Hero Image with High LCP Priority -->
    <img
      src={FEATURED_HERO.image}
      alt={FEATURED_HERO.title}
      width="900"
      height="506"
      class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-out"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Gradient Overlay for Contrast & Legibility -->
    <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 to-transparent"></div>

    <!-- Top Badge Row -->
    <div class="absolute top-4 left-4 sm:top-5 sm:left-5 z-10 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-brand px-3 py-1 text-[10px] font-black uppercase tracking-wider text-white shadow-lg backdrop-blur-md flex items-center gap-1.5">
        <img src="/icons/award.svg" class="w-3.5 h-3.5 invert inline-block" alt="" />
        <span>{FEATURED_HERO.badge}</span>
      </span>
      <span class="rounded-full bg-black/70 backdrop-blur-md border border-white/30 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-cyan-200">
        {FEATURED_HERO.category}
      </span>
    </div>

    <!-- Main Content at Bottom (Sleek Compact Typography) -->
    <div class="relative z-10 p-5 sm:p-6 space-y-2.5 text-white">
      <!-- Title (H1 for Main Page Spot) -->
      <h1 class="font-headline text-lg sm:text-xl xl:text-2xl font-black text-white leading-snug tracking-tight drop-shadow-md max-w-xl">
        <a href={FEATURED_HERO.link} class="hover:text-cyan-300 transition">
          {FEATURED_HERO.title}
        </a>
      </h1>

      <!-- Description Excerpt -->
      <p class="text-xs text-slate-100 font-medium line-clamp-2 leading-relaxed max-w-xl drop-shadow-sm">
        {FEATURED_HERO.description}
      </p>

      <!-- Key Vehicle Stats Bar (Compact Layout) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-white/20">
        {FEATURED_HERO.stats.map((st) => (
          <div class="rounded-xl bg-white/15 backdrop-blur-md border border-white/20 p-1.5 text-center">
            <span class="text-[8px] font-extrabold uppercase text-cyan-300 block tracking-wider">{st.label}</span>
            <span class="font-headline text-xs font-black text-white">{st.val}</span>
          </div>
        ))}
      </div>

      <!-- Action Buttons & Meta -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <div class="flex items-center gap-2 text-[10px] font-extrabold text-slate-200">
          <span>{FEATURED_HERO.author}</span>
          <span>•</span>
          <span>{FEATURED_HERO.date}</span>
          <span>•</span>
          <span class="text-cyan-300">{FEATURED_HERO.readTime}</span>
        </div>

        <a
          href={FEATURED_HERO.link}
          class="inline-flex items-center gap-1.5 rounded-full bg-brand hover:bg-brand-hover px-4 py-2 text-[11px] font-black uppercase tracking-wider text-white shadow-lg shadow-sky-500/30 transition transform hover:scale-105"
        >
          <span>Baca Ulasan Lengkap</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- RIGHT SIDE: TRENDING AUTOMOTIVE TOPICS (Apple Liquid Glass Column) -->
  <div class="rounded-3xl apple-liquid-glass p-5 sm:p-6 space-y-4 shadow-2xl flex flex-col justify-between transition-colors duration-300">
    <div class="space-y-4">
      <!-- Section Header (Sequential H2) -->
      <div class="flex items-center justify-between border-b border-line pb-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-brand animate-ping"></span>
          <h2 class="font-headline text-base sm:text-lg font-black text-slate-900 dark:text-white">
            Topik Otomotif Terpopuler
          </h2>
        </div>
        <span class="text-[10px] font-extrabold uppercase text-brand tracking-widest">TERKINI</span>
      </div>

      <!-- 3 Compact Trending Cards Stack (Sequential H3 Titles) -->
      <div class="space-y-3">
        {SIDE_TRENDING.map((item) => (
          <a
            href={item.link}
            class="inner-glass-card group flex gap-3.5 items-center p-3 rounded-2xl border transition-all duration-300 shadow-sm backdrop-blur-md hover:border-brand hover:-translate-y-0.5"
          >
            <!-- Card Thumbnail Image -->
            <div class="relative h-18 w-22 shrink-0 overflow-hidden rounded-xl border border-line bg-paper">
              <img
                src={item.img}
                alt={item.title}
                width="88"
                height="72"
                class="h-full w-full object-cover group-hover:scale-105 transition duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Content Details -->
            <div class="space-y-1 min-w-0 flex-1">
              <div class="flex items-center gap-2 text-[9px] font-extrabold">
                <span class="text-brand uppercase tracking-wider">{item.category}</span>
                <span class="text-slate-500 dark:text-slate-400">•</span>
                <span class="text-slate-700 dark:text-cyan-200 font-extrabold">{item.time}</span>
              </div>
              <h3 class="font-headline text-xs font-black text-slate-900 dark:text-white group-hover:text-brand transition line-clamp-2 leading-snug">
                {item.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Quick Partner Highlight Badge -->
    <div class="inner-glass-card rounded-2xl p-3.5 flex items-center gap-3 backdrop-blur-md">
      <div class="grid h-9 w-9 place-items-center rounded-xl bg-brand text-white font-black text-base shrink-0 shadow-md">
        <img src="/icons/zap.svg" class="w-4 h-4 invert" alt="" />
      </div>
      <div class="text-[11px] min-w-0">
        <span class="font-extrabold text-slate-900 dark:text-white block truncate">Jurnal & Pengujian Resmi Otomotif</span>
        <span class="text-slate-700 dark:text-slate-200 font-bold block text-[10px]">Data spesifikasi terverifikasi & independen.</span>
      </div>
    </div>
  </div>
</div>
