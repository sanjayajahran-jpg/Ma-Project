---
import Logo from "./Logo.astro";
---

<footer class="footer-gradient text-ink transition-colors duration-300">
  <!-- Newsletter Briefing Box — Light: clear cyan | Dark: navy gradient -->
  <div class="py-4 sm:py-8 px-3 sm:px-4">
    <div class="mx-auto max-w-7xl rounded-2xl sm:rounded-3xl footer-newsletter-gradient p-4 sm:p-8 shadow-md sm:shadow-xl dark:shadow-2xl dark:shadow-blue-950/60 flex flex-col md:flex-row items-center justify-between gap-3.5 sm:gap-6 overflow-hidden relative">
      <!-- Glow blobs -->
      <div class="absolute -top-20 -left-10 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="space-y-1 text-center md:text-left max-w-xl relative z-10">
        <span class="text-[9px] sm:text-[10px] font-extrabold uppercase tracking-widest text-cyan-600 dark:text-cyan-300 block">Edisi Elektrifikasi EVnesia</span>
        <h2 class="font-headline text-base sm:text-2xl font-black text-slate-800 dark:text-white">
          Dapatkan Briefing Mingguan
        </h2>
        <p class="text-[11px] sm:text-xs text-slate-600 dark:text-cyan-100/80 font-medium leading-relaxed line-clamp-2 sm:line-clamp-none">
          Ulasan mobil listrik (BEV), komparasi efisiensi hybrid (HEV/PHEV), dan peta sebaran jaringan SPKLU baru.
        </p>
      </div>

      <form action="/subscribe" method="post" class="flex flex-col sm:flex-row w-full md:w-auto items-stretch sm:items-center gap-1.5 sm:gap-2 max-w-md relative z-10">
        <input
          type="email"
          aria-label="Alamat email untuk berlangganan briefing elektrifikasi"
          placeholder="Masukkan alamat email Anda..."
          required
          class="w-full rounded-xl bg-white/70 dark:bg-white/10 backdrop-blur-md border border-cyan-300 dark:border-cyan-400/30 px-3 py-2 text-xs font-semibold outline-hidden focus:ring-2 focus:ring-cyan-500 text-slate-700 dark:text-white dark:placeholder:text-cyan-200/60"
        />
        <button
          type="submit"
          class="gradient-btn rounded-xl px-4 py-2 text-xs font-black uppercase shadow-md shrink-0 cursor-pointer flex items-center justify-center text-center"
        >
          <span>Langganan</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Gradient Divider -->
  <div class="gradient-divider mx-3 sm:mx-4"></div>

  <!-- Footer Navigation Links & Identity (Compact Multi-col on Mobile) -->
  <div class="mx-auto max-w-7xl px-3 sm:px-4 py-6 sm:py-10 grid gap-5 sm:gap-8 grid-cols-2 lg:grid-cols-5">
    <!-- Brand Info (Spans 2 Cols) -->
    <div class="col-span-2 space-y-2 sm:space-y-3">
      <Logo class="h-8 sm:h-9 w-auto" variant="dark" />
      <p class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-medium max-w-md">
        EVnesia — Portal Media, Ulasan &amp; Pusat Data Kendaraan Elektrifikasi (BEV, PHEV, HEV) resmi di Indonesia.
      </p>
      <div class="flex items-center gap-2 text-[10px] sm:text-xs font-bold text-slate-500 dark:text-slate-500 pt-0.5">
        <span>© 2026 EVnesia. Hak cipta dilindungi undang-undang.</span>
      </div>
    </div>

    <!-- Sitemap Navigation -->
    <div class="space-y-1.5 sm:space-y-2.5">
      <h3 class="font-headline text-[10px] sm:text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400">Elektrifikasi &amp; Spek</h3>
      <ul class="space-y-1 sm:space-y-1.5 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-400">
        <li><a href="/katalog-mobil" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Katalog Mobil Listrik</a></li>
        <li><a href="/spklu" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Jaringan SPKLU & Charging</a></li>
        <li><a href="/kalkulator" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Kalkulator Hemat BBM</a></li>
        <li><a href="/komparasi" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Komparasi Spesifikasi</a></li>
        <li><a href="/kategori/berita" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Berita Elektrifikasi</a></li>
      </ul>
    </div>

    <!-- Halaman Utama & Pedoman -->
    <div class="space-y-1.5 sm:space-y-2.5">
      <h3 class="font-headline text-[10px] sm:text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400">Navigasi Portal</h3>
      <ul class="space-y-1 sm:space-y-1.5 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-400">
        <li><a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Beranda</a></li>
        <li><a href="/tentang" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Tentang Kami</a></li>
        <li><a href="/redaksi" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Susunan Redaksi</a></li>
        <li><a href="/pedoman-pemberitaan" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Pedoman Media Siber</a></li>
        <li><a href="/pedoman-ai" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Kebijakan AI</a></li>
      </ul>
    </div>

    <!-- Kontak & Monetisasi (Spans 2 cols on mobile to fill row) -->
    <div class="col-span-2 sm:col-span-1 space-y-1.5 sm:space-y-2.5">
      <h3 class="font-headline text-[10px] sm:text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400">Monetisasi &amp; Kontak</h3>
      <ul class="flex flex-wrap sm:flex-col gap-x-4 gap-y-1 sm:space-y-1.5 text-[11px] sm:text-xs font-semibold text-slate-600 dark:text-slate-400">
        <li><a href="/pasang-iklan" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Pasang Iklan</a></li>
        <li><a href="/gabung" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Karir Penulis</a></li>
        <li><a href="/privasi" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Kebijakan Privasi</a></li>
        <li><a href="/kontak" class="hover:text-cyan-600 dark:hover:text-cyan-300 transition">Hubungi Redaksi</a></li>
      </ul>
    </div>
  </div>
</footer>
