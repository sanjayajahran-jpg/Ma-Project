---
// Section: Rekomendasi Mobil Elektrifikasi Terpopuler (Sederhana, Ringkas & Mobile-Optimized)
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";

// Curated flagship electrified cars in Indonesia
const CURATED_SLUGS = [
  "byd-seal",
  "hyundai-ioniq-5",
  "chery-j6",
  "wuling-binguo-ev",
  "aletra-l8",
  "denza-d9",
  "zeekr-009",
  "chery-omoda-e5"
];

const featuredCars = CURATED_SLUGS.map((slug) => {
  const found: any = ELECTRIFIED_CARS_DATA.find((c: any) => c.slug === slug || (c.slug || "").includes(slug));
  if (!found) return null;
  return {
    slug: found.slug,
    brand: found.brand,
    model: found.name,
    category: found.bodyType ? found.bodyType.toUpperCase() : "SUV",
    engineType: found.engineType?.toUpperCase() || "BEV",
    price: found.price,
    range: found.consumption || `${found.specs?.electric_range_km || 450} km`,
    acc: found.acc || `${found.specs?.top_speed_kmh ? "< 8.0s" : "Instan"}`,
    battery: `${found.specs?.battery_capacity_kwh || 50} kWh`,
    image: found.img || "/images/cars/default-car.png",
    link: `/mobil/${found.slug}`,
    badge: found.badge || (found.engineType === "bev" ? "100% BEV" : "Hybrid"),
  };
}).filter(Boolean);
---

<div class="space-y-2.5 sm:space-y-3 py-2">
  <!-- Section Title Header -->
  <div class="flex items-center justify-between gap-2 sm:gap-3 border-b border-slate-200/60 dark:border-white/10 pb-2 sm:pb-2.5">
    <div class="min-w-0">
      <span class="text-[9px] sm:text-[10px] font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block">
        REKOMENDASI PILIHAN REDAKSI
      </span>
      <h3 class="font-headline text-xs sm:text-base font-bold tracking-tight text-slate-900 dark:text-white mt-0.5 truncate">
        Mobil Listrik & Hybrid Unggulan Resmi Indonesia
      </h3>
    </div>
    <a href="/katalog-mobil" class="text-[11px] sm:text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline shrink-0 whitespace-nowrap">
      Katalog Lengkap ({ELECTRIFIED_CARS_DATA.length} Unit) →
    </a>
  </div>

  <!-- Mobile Horizontal Snap Carousel / Desktop 4-Col Grid -->
  <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-3 overflow-x-auto sm:overflow-visible no-scrollbar snap-x snap-mandatory py-1">
    {featuredCars.map((car: any) => (
      <a
        href={car.link}
        class="group flex flex-col justify-between p-3 sm:p-4 rounded-2xl apple-liquid-glass border border-slate-200/80 dark:border-white/10 hover:border-cyan-400/60 hover:-translate-y-1 transition-all duration-300 shadow-2xs text-slate-900 dark:text-white w-65 sm:w-auto shrink-0 snap-start select-none"
      >
        <!-- Top Badge & Category -->
        <div class="flex items-center justify-between text-[9px] sm:text-[10px] font-extrabold uppercase">
          <span class="px-2 py-0.5 rounded-md bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 truncate max-w-32">
            {car.badge}
          </span>
          <span class="text-slate-600 dark:text-slate-400 font-bold">
            {car.brand}
          </span>
        </div>

        <!-- Car Image -->
        <div class="w-full aspect-video flex items-center justify-center p-2 my-1 relative">
          <div class="absolute bottom-1 w-3/4 h-4 rounded-full bg-cyan-500/15 blur-sm"></div>
          <img
            src={car.image}
            alt={car.model}
            class="max-h-24 sm:max-h-32 w-auto object-contain group-hover:scale-105 transition-transform duration-300 filter drop-shadow-sm relative z-10"
            loading="lazy"
            onerror="this.onerror=null; this.src='/images/cars/default-car.png';"
          />
        </div>

        <!-- Details -->
        <div class="space-y-1 sm:space-y-1.5 pt-2 border-t border-slate-100 dark:border-white/10">
          <span class="font-headline text-xs sm:text-base font-black text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors block truncate">
            {car.model}
          </span>

          <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-600 dark:text-slate-300 font-medium">
            <span>Jarak: <strong class="text-slate-900 dark:text-white font-bold">{car.range}</strong></span>
            <span>Baterai: <strong class="text-slate-900 dark:text-white font-bold">{car.battery}</strong></span>
          </div>

          <div class="pt-1 flex items-center justify-between">
            <span class="font-headline text-xs sm:text-sm font-black text-cyan-700 dark:text-cyan-400">
              {car.price}
            </span>
            <span class="text-[11px] sm:text-xs font-bold text-slate-600 dark:text-slate-400 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 group-hover:translate-x-0.5 transition-all flex items-center gap-0.5">
              <span>Lihat Spek</span>
              <span>→</span>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

