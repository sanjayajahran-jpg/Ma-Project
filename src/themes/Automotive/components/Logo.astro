---
interface Props {
  class?: string;
  name?: string;
  logoUrl?: string;
  darkLogoUrl?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  whiteText?: boolean;
  variant?: "light" | "dark";
}
const {
  class: cls = "",
  name = "EVnesia",
  logoUrl = "",
  darkLogoUrl = "",
  loading = "eager",
  fetchpriority = "high",
  variant = "light",
} = Astro.props;
---

<a href="/" class:list={["inline-flex min-w-0 items-center gap-2.5 group", cls]} aria-label="EVnesia — Beranda">
  {
    logoUrl ? (
      <>
        <img
          src={logoUrl}
          alt={name}
          width={390}
          height={40}
          class:list={["auto-brand-logo-light h-8 w-auto max-w-52 object-contain sm:h-9 sm:max-w-80 lg:h-10", darkLogoUrl && "has-dark-logo"]}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
        />
        {darkLogoUrl ? (
          <img
            src={darkLogoUrl}
            alt=""
            aria-hidden="true"
            width={390}
            height={40}
            class="auto-brand-logo-dark h-8 w-auto max-w-52 object-contain sm:h-9 sm:max-w-80 lg:h-10"
            loading={loading}
            fetchpriority={fetchpriority}
            decoding="async"
          />
        ) : null}
        <span class="sr-only">{name}</span>
      </>
    ) : (
      <div class="flex items-center gap-2.5">
        <!-- XPENG Minimalist Geometric Icon Badge -->
        <div class="relative grid h-8 sm:h-9 w-8 sm:w-9 place-items-center rounded-xl bg-slate-900 text-white dark:bg-cyan-500/15 dark:text-cyan-400 border border-slate-700/60 dark:border-cyan-500/30 group-hover:scale-105 transition-transform duration-200 shadow-xs">
          <svg class="h-4 sm:h-4.5 w-4 sm:w-4.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </div>

        <div class="flex flex-col">
          <div class="flex items-center gap-1.5 leading-none">
            <span class="font-headline font-black text-lg sm:text-xl tracking-tight text-slate-900 dark:text-white uppercase">
              EVNESIA
            </span>
            <span class="text-[9px] font-black text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-500/20 tracking-wider">
              ID
            </span>
          </div>
          <span class="text-[9px] font-medium text-slate-500 dark:text-slate-400 tracking-wider uppercase leading-none mt-1">
            Mobil Listrik & Hybrid
          </span>
        </div>
      </div>
    )
  }
</a>

<style>
  .auto-brand-logo-dark { display: none; }
  :global(html[data-color-scheme="dark"]) .auto-brand-logo-light.has-dark-logo { display: none; }
  :global(html[data-color-scheme="dark"]) .auto-brand-logo-dark { display: block; }
</style>
