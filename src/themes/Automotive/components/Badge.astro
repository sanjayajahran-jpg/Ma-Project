---
interface Props {
  tone?: "premium" | "sponsored" | "neutral" | "brand";
  class?: string;
}
const { tone = "neutral", class: cls = "" } = Astro.props;

const tones: Record<string, string> = {
  premium: "bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 ring-1 ring-cyan-500/30",
  sponsored: "bg-amber-500/15 text-amber-700 dark:text-amber-300 ring-1 ring-amber-500/30",
  neutral: "bg-slate-500/10 text-slate-700 dark:text-slate-300 ring-1 ring-slate-500/20",
  brand: "bg-cyan-600 dark:bg-cyan-500 text-white shadow-xs",
};
---

<span
  class:list={[
    "kicker inline-flex items-center gap-1 rounded-full px-2 py-0.75 leading-none",
    tones[tone],
    cls,
  ]}
>
  <slot />
</span>
