---
import type { Author } from "@/types";
import { formatPublicationTime, isoDate } from "@/lib/format";
interface Props {
  author: Author;
  date: string;
  readingTime: number;
  class?: string;
}
const { author, date, class: cls = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3", cls]}>
  <a href={`/penulis/${author.slug}`} aria-hidden="true" tabindex="-1">
    <img
      src={author.avatar}
      alt=""
      width="44"
      height="44"
      loading="eager"
      class="h-11 w-11 rounded-full bg-cream object-cover"
    />
  </a>
  <div class="text-sm">
    <div>
      <a href={`/penulis/${author.slug}`} class="font-semibold text-ink hover:text-brand"
        >{author.name}</a
      >
      <span class="text-muted"> · {author.role}</span>
    </div>
    <div class="text-muted">
      <time datetime={isoDate(date)}>{formatPublicationTime(date)}</time>
    </div>
  </div>
</div>
