---
import type { Article } from "@/types";
import { articleUrl } from "@/types";

interface Props {
  articles?: Article[];
}

const { articles = [] } = Astro.props;

// Default news items matching Reference Image 1 if fallback needed
const defaultNews = [
  {
    title: "Audi Q6 E-tron 2027 Tembus Rekor Jarak Tempuh EPA dalam Uji Coba Nyata",
    category: "EV Zone",
    img: "https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=1000&auto=format&fit=crop",
    link: "/kategori/ev-teknologi"
  },
  {
    title: "Volkswagen Hadirkan Varian Hybrid Atlas & Tiguan: Ini Bocoran Spesifikasinya",
    category: "Berita",
    img: "https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?q=80&w=600&auto=format&fit=crop",
    link: "/kategori/berita"
  },
  {
    title: "Cadillac Escalade IQ Dapatkan Paket Kustomisasi Warna Mewah Eksklusif",
    category: "Berita",
    img: "https://images.unsplash.com/photo-1555215695-3004980adade?q=80&w=600&auto=format&fit=crop",
    link: "/kategori/berita"
  },
  {
    title: "Volkswagen Atlas Cross Sport 2027: Tinjauan Pertama SUV Mewah Dua Baris",
    category: "Ulasan",
    img: "https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?q=80&w=1000&auto=format&fit=crop",
    link: "/kategori/ulasan-test-drive"
  }
];

const heroArticle = articles[0];
const sub1Article = articles[1];
const sub2Article = articles[2];
const sub3Article = articles[3];
---

<div class="space-y-3 sm:space-y-6">
  <!-- Section Header (Sequential H2) -->
  <div class="flex items-center justify-between border-b border-line pb-1.5 sm:pb-3">
    <div>
      <span class="text-[9px] sm:text-[10px] font-extrabold text-brand uppercase tracking-widest block">Ulasan Independen & Berita Redaksi</span>
      <h2 class="font-headline text-sm sm:text-3xl font-black text-ink">
        Berita Otomotif Terbaru dari Pakar Redaksi
      </h2>
    </div>
    <a href="/kategori/berita" class="text-[10px] sm:text-xs font-extrabold text-brand hover:underline hidden sm:inline">
      Lihat Semua Berita →
    </a>
  </div>

  <!-- Asymmetric Pre-Footer News Grid (Desktop) / Proportional Mobile Layout -->
  <div class="grid gap-3 sm:gap-4 lg:grid-cols-2">
    <!-- HERO ARTICLE (Left 50% on Desktop, Top Featured on Mobile) -->
    <a
      href={heroArticle ? articleUrl(heroArticle) : defaultNews[0].link}
      class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-line bg-paper aspect-video sm:aspect-auto min-h-44 sm:min-h-112 flex items-end shadow-sm sm:shadow-2xl"
    >
      <img
        src={heroArticle?.cover || defaultNews[0].img}
        alt={heroArticle?.title || defaultNews[0].title}
        class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition duration-700"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 to-transparent"></div>

      <div class="relative z-10 p-3 sm:p-8 space-y-1 sm:space-y-2 text-white">
        <span class="inline-block rounded bg-brand px-1.5 py-0.5 sm:px-2.5 sm:py-1 text-[8px] sm:text-[10px] font-extrabold uppercase tracking-wider text-white shadow">
          {heroArticle?.category?.name || defaultNews[0].category}
        </span>
        <h3 class="font-headline text-xs sm:text-3xl font-black leading-tight text-white drop-shadow-md group-hover:text-cyan-300 transition line-clamp-2 sm:line-clamp-none">
          {heroArticle?.title || defaultNews[0].title}
        </h3>
      </div>
    </a>

    <!-- MOBILE-ONLY COMPACT LIST (3 Sub Articles in Proportional Rows) -->
    <div class="sm:hidden space-y-2">
      <!-- Sub News 1 Mobile Row -->
      <a
        href={sub1Article ? articleUrl(sub1Article) : defaultNews[1].link}
        class="flex items-center gap-2.5 p-2 rounded-xl bg-white dark:bg-slate-900/60 border border-line shadow-2xs hover:border-brand/40 transition group"
      >
        <img
          src={sub1Article?.cover || defaultNews[1].img}
          alt={sub1Article?.title || defaultNews[1].title}
          class="w-18 h-18 rounded-lg object-cover shrink-0"
          loading="lazy"
        />
        <div class="space-y-0.5 min-w-0 flex-1">
          <span class="text-[8px] font-extrabold text-brand uppercase tracking-wider block">
            {sub1Article?.category?.name || defaultNews[1].category}
          </span>
          <h4 class="font-headline text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand line-clamp-2 leading-snug">
            {sub1Article?.title || defaultNews[1].title}
          </h4>
        </div>
      </a>

      <!-- Sub News 2 Mobile Row -->
      <a
        href={sub2Article ? articleUrl(sub2Article) : defaultNews[2].link}
        class="flex items-center gap-2.5 p-2 rounded-xl bg-white dark:bg-slate-900/60 border border-line shadow-2xs hover:border-brand/40 transition group"
      >
        <img
          src={sub2Article?.cover || defaultNews[2].img}
          alt={sub2Article?.title || defaultNews[2].title}
          class="w-18 h-18 rounded-lg object-cover shrink-0"
          loading="lazy"
        />
        <div class="space-y-0.5 min-w-0 flex-1">
          <span class="text-[8px] font-extrabold text-brand uppercase tracking-wider block">
            {sub2Article?.category?.name || defaultNews[2].category}
          </span>
          <h4 class="font-headline text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand line-clamp-2 leading-snug">
            {sub2Article?.title || defaultNews[2].title}
          </h4>
        </div>
      </a>

      <!-- Sub News 3 Mobile Row -->
      <a
        href={sub3Article ? articleUrl(sub3Article) : defaultNews[3].link}
        class="flex items-center gap-2.5 p-2 rounded-xl bg-white dark:bg-slate-900/60 border border-line shadow-2xs hover:border-brand/40 transition group"
      >
        <img
          src={sub3Article?.cover || defaultNews[3].img}
          alt={sub3Article?.title || defaultNews[3].title}
          class="w-18 h-18 rounded-lg object-cover shrink-0"
          loading="lazy"
        />
        <div class="space-y-0.5 min-w-0 flex-1">
          <span class="text-[8px] font-extrabold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block">
            {sub3Article?.category?.name || defaultNews[3].category}
          </span>
          <h4 class="font-headline text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand line-clamp-2 leading-snug">
            {sub3Article?.title || defaultNews[3].title}
          </h4>
        </div>
      </a>
    </div>

    <!-- DESKTOP 50% WIDTH: 2 Small Cards Top + 1 Wide Card Bottom -->
    <div class="hidden sm:grid gap-3 sm:gap-4">
      <!-- TOP RIGHT: 2 Sub News Cards (Sequential H3 Titles) -->
      <div class="grid gap-3 sm:gap-4 grid-cols-2">
        <!-- Sub News 1 -->
        <a
          href={sub1Article ? articleUrl(sub1Article) : defaultNews[1].link}
          class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-line bg-paper min-h-52 flex items-end shadow-md sm:shadow-xl"
        >
          <img
            src={sub1Article?.cover || defaultNews[1].img}
            alt={sub1Article?.title || defaultNews[1].title}
            class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 to-transparent"></div>

          <div class="relative z-10 p-3 sm:p-4 space-y-1 text-white">
            <h3 class="font-headline text-xs sm:text-sm font-extrabold leading-snug line-clamp-3 text-white group-hover:text-cyan-300 transition">
              {sub1Article?.title || defaultNews[1].title}
            </h3>
          </div>
        </a>

        <!-- Sub News 2 -->
        <a
          href={sub2Article ? articleUrl(sub2Article) : defaultNews[2].link}
          class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-line bg-paper min-h-52 flex items-end shadow-md sm:shadow-xl"
        >
          <img
            src={sub2Article?.cover || defaultNews[2].img}
            alt={sub2Article?.title || defaultNews[2].title}
            class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 to-transparent"></div>

          <div class="relative z-10 p-3 sm:p-4 space-y-1 text-white">
            <h3 class="font-headline text-xs sm:text-sm font-extrabold leading-snug line-clamp-3 text-white group-hover:text-cyan-300 transition">
              {sub2Article?.title || defaultNews[2].title}
            </h3>
          </div>
        </a>
      </div>

      <!-- BOTTOM RIGHT WIDE CARD: Sub News 3 (Sequential H3 Title) -->
      <a
        href={sub3Article ? articleUrl(sub3Article) : defaultNews[3].link}
        class="group relative overflow-hidden rounded-xl sm:rounded-2xl border border-line bg-paper min-h-48 flex items-end shadow-md sm:shadow-xl"
      >
        <img
          src={sub3Article?.cover || defaultNews[3].img}
          alt={sub3Article?.title || defaultNews[3].title}
          class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition duration-500"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/45 to-transparent"></div>

        <div class="relative z-10 p-3.5 sm:p-5 space-y-1 text-white">
          <span class="rounded bg-black/70 backdrop-blur px-2 py-0.5 text-[9px] font-extrabold text-cyan-300 border border-cyan-300/40">
            TINJAUAN PERTAMA
          </span>
          <h3 class="font-headline text-xs sm:text-lg font-extrabold leading-snug text-white group-hover:text-cyan-300 transition">
            {sub3Article?.title || defaultNews[3].title}
          </h3>
        </div>
      </a>
    </div>
  </div>
</div>
