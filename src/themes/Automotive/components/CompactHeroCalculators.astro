---
// Ultra-Compact Mobile-First & Full Desktop Hero EV Calculator Hub
// Features: Sleek compact mobile layout + Full desktop view + Interactive BBM vs EV and SPKLU simulator
---

<div class="rounded-2xl sm:rounded-3xl apple-liquid-glass p-3 sm:p-5 lg:p-7 shadow-lg sm:shadow-2xl border border-slate-200/80 dark:border-white/10 text-slate-900 dark:text-white transition-all duration-300">
  
  <!-- Header: Sleek Compact Title & Dual Switcher Tabs -->
  <div class="flex items-center justify-between gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2 sm:pb-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse shrink-0"></span>
      <div>
        <h2 class="font-headline text-xs sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
          <span class="sm:hidden">Simulasi Hemat Energi EV</span>
          <span class="hidden sm:inline">Simulasi Biaya Pengisian & Kehematan Energi EV</span>
        </h2>
        <p class="hidden sm:block text-xs text-slate-500 dark:text-slate-400 font-medium">
          Kalkulator interaktif komparasi konsumsi energi harian dan efisiensi mobil listrik vs bensin di Indonesia.
        </p>
      </div>
    </div>

    <!-- Toggle Buttons: Biaya Pengisian vs Kehematan BBM -->
    <div class="inline-flex p-0.5 sm:p-1 rounded-xl sm:rounded-2xl bg-slate-100 dark:bg-slate-900/90 border border-slate-200/70 dark:border-white/10 shadow-inner shrink-0" role="tablist">
      <button
        type="button"
        id="tab-btn-savings"
        role="tab"
        aria-selected="true"
        class="calc-tab-btn px-2 sm:px-3.5 py-1 sm:py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-black transition-all duration-200 cursor-pointer bg-white dark:bg-cyan-600 text-cyan-700 dark:text-white shadow-xs flex items-center justify-center gap-1 text-center"
      >
        <img src="/icons/droplet.svg" class="w-3.5 h-3.5 opacity-80" alt="" />
        <span>Hemat BBM</span>
      </button>
      <button
        type="button"
        id="tab-btn-charging"
        role="tab"
        aria-selected="false"
        class="calc-tab-btn px-2 sm:px-3.5 py-1 sm:py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-black transition-all duration-200 cursor-pointer text-slate-600 dark:text-slate-300 hover:text-cyan-500 flex items-center justify-center gap-1 text-center"
      >
        <img src="/icons/battery-bolt.svg" class="w-3.5 h-3.5 opacity-80" alt="" />
        <span>SPKLU</span>
      </button>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- PANEL 1: KALKULATOR KEHEMATAN BBM VS EV (ACTIVE BY DEFAULT) -->
  <!-- ================================================================= -->
  <div id="panel-savings" class="calc-panel pt-2.5 sm:pt-4 space-y-2.5 sm:space-y-4 block">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 sm:gap-5 items-stretch">
      
      <!-- Left Form Controls (7 Cols on Desktop) -->
      <div class="lg:col-span-7 space-y-2 sm:space-y-3 flex flex-col justify-between">
        
        <!-- Quick Comparison Presets: Horizontal Scrollable Chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <span class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider shrink-0 pr-0.5">
            Preset:
          </span>
          <button
            type="button"
            class="preset-compare-btn active-preset shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-bold border transition cursor-pointer bg-cyan-500/10 text-cyan-600 dark:text-cyan-300 border-cyan-500/40"
            data-fuel-kml="11"
            data-ev-kwh="6.2"
            data-dist="60"
          >
            Camry vs Seal
          </button>
          <button
            type="button"
            class="preset-compare-btn shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-cyan-400 transition cursor-pointer"
            data-fuel-kml="10"
            data-ev-kwh="5.8"
            data-dist="50"
          >
            Innova vs BYD M6
          </button>
          <button
            type="button"
            class="preset-compare-btn shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-cyan-400 transition cursor-pointer"
            data-fuel-kml="13"
            data-ev-kwh="6.5"
            data-dist="45"
          >
            HR-V vs Omoda E5
          </button>
          <button
            type="button"
            class="preset-compare-btn shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-cyan-400 transition cursor-pointer"
            data-fuel-kml="15"
            data-ev-kwh="8.5"
            data-dist="30"
          >
            Brio vs Air ev
          </button>
        </div>

        <!-- Slider Jarak Tempuh Harian (Ultra Slim) -->
        <div class="space-y-1 bg-slate-50 dark:bg-slate-900/60 p-2 sm:p-3 rounded-xl sm:rounded-2xl border border-slate-200/70 dark:border-white/10">
          <div class="flex justify-between items-center text-[10px] sm:text-xs font-bold">
            <label for="sav-dist-slider" class="text-slate-700 dark:text-slate-300">Jarak Tempuh Harian:</label>
            <span id="sav-dist-label" class="font-headline font-black text-[11px] sm:text-xs text-cyan-600 dark:text-cyan-400 px-1.5 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-500/20 tabular-nums">
              60 km/hari
            </span>
          </div>
          <input
            type="range"
            id="sav-dist-slider"
            min="10"
            max="200"
            step="5"
            value="60"
            class="w-full h-1.5 sm:h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
          />
          <div class="flex justify-between text-[8px] sm:text-[10px] text-slate-400 font-medium">
            <span>10 km (Kota)</span>
            <span>60 km (Komuter)</span>
            <span>120 km</span>
            <span>200 km (Trip)</span>
          </div>
        </div>

        <!-- Customizable Input Parameters: Collapsible on Mobile, Grid on Desktop -->
        <div id="sav-custom-wrapper" class="hidden lg:grid grid-cols-2 sm:grid-cols-4 gap-1.5 sm:gap-2.5">
          <!-- 1. Harga BBM -->
          <div class="space-y-0.5 bg-white dark:bg-slate-900/70 p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl border border-slate-200 dark:border-white/10 shadow-2xs">
            <label for="sav-fuel-price" class="block text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 leading-tight">
              Harga BBM (Rp/L):
            </label>
            <input
              type="number"
              id="sav-fuel-price"
              value="13700"
              step="100"
              class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5 sm:py-1 text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white outline-hidden focus:ring-2 focus:ring-cyan-500 tabular-nums"
            />
          </div>

          <!-- 2. Tarif Listrik -->
          <div class="space-y-0.5 bg-white dark:bg-slate-900/70 p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl border border-slate-200 dark:border-white/10 shadow-2xs">
            <label for="sav-ev-price" class="block text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 leading-tight">
              Tarif EV (Rp/kWh):
            </label>
            <input
              type="number"
              id="sav-ev-price"
              value="1700"
              step="50"
              class="w-full bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5 sm:py-1 text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white outline-hidden focus:ring-2 focus:ring-cyan-500 tabular-nums"
            />
          </div>

          <!-- 3. Konsumsi BBM -->
          <div class="space-y-0.5 bg-white dark:bg-slate-900/70 p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl border border-slate-200 dark:border-white/10 shadow-2xs">
            <label for="sav-fuel-kml" class="block text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 leading-tight">
              Efisiensi BBM (km/L):
            </label>
            <input
              type="number"
              id="sav-fuel-kml"
              value="11"
              step="0.5"
              min="4"
              max="35"
              class="w-full bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5 sm:py-1 text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white outline-hidden focus:ring-2 focus:ring-cyan-500 tabular-nums"
            />
          </div>

          <!-- 4. Konsumsi EV -->
          <div class="space-y-0.5 bg-white dark:bg-slate-900/70 p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl border border-slate-200 dark:border-white/10 shadow-2xs">
            <label for="sav-ev-kwh" class="block text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 leading-tight">
              Efisiensi EV (km/kWh):
            </label>
            <input
              type="number"
              id="sav-ev-kwh"
              value="6.2"
              step="0.1"
              min="2"
              max="15"
              class="w-full bg-slate-50 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5 sm:py-1 text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white outline-hidden focus:ring-2 focus:ring-cyan-500 tabular-nums"
            />
          </div>
        </div>
      </div>

      <!-- Right Summary Output Card (5 Cols on Desktop) -->
      <div class="lg:col-span-5 bg-white dark:bg-linear-to-br dark:from-[rgba(4,15,32,0.88)] dark:via-[rgba(5,22,50,0.85)] dark:to-[rgba(7,40,80,0.82)] dark:backdrop-blur-xl text-slate-900 dark:text-white p-2.5 sm:p-5 lg:p-6 rounded-xl sm:rounded-3xl border border-cyan-200 dark:border-cyan-500/25 shadow-xs sm:shadow-xl dark:shadow-cyan-950/40 flex flex-col justify-between gap-2 sm:gap-3">
        
        <!-- Big Number Savings & Badge -->
        <div>
          <div class="flex items-center justify-between">
            <span class="text-[8px] sm:text-[10px] font-black uppercase text-cyan-700 dark:text-cyan-400 tracking-wider">
              ESTIMASI PENGHEMATAN
            </span>
            <span class="px-1.5 py-0.5 rounded-md bg-cyan-100 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 text-[8px] sm:text-[10px] font-extrabold border border-cyan-300 dark:border-cyan-500/30">
              Hemat ~75%
            </span>
          </div>

          <div class="mt-0.5 sm:mt-2 flex items-baseline justify-between sm:block">
            <div class="font-headline text-base sm:text-2xl lg:text-3xl font-black text-cyan-600 dark:text-cyan-300 tracking-tight tabular-nums" id="sav-annual-result">
              Rp 20.979.238
            </div>
            <span class="text-[9px] sm:text-xs text-slate-500 dark:text-slate-300 font-medium">
              / tahun vs mobil bensin
            </span>
          </div>
        </div>

        <!-- Monthly Breakdown Table (Compact Pill Grid on Mobile) -->
        <div class="grid grid-cols-3 sm:grid-cols-1 gap-1 sm:gap-1.5 border-t border-slate-100 dark:border-white/10 pt-1.5 sm:pt-2.5 text-[9px] sm:text-xs">
          <div class="bg-slate-50 dark:bg-white/5 p-1 sm:p-0 rounded sm:rounded-none flex flex-col sm:flex-row sm:justify-between">
            <span class="text-[8px] sm:text-xs text-slate-400">Bensin/bln:</span>
            <span id="sav-fuel-monthly" class="font-bold text-rose-500 dark:text-rose-300 tabular-nums">Rp 2,2jt</span>
          </div>
          <div class="bg-slate-50 dark:bg-white/5 p-1 sm:p-0 rounded sm:rounded-none flex flex-col sm:flex-row sm:justify-between">
            <span class="text-[8px] sm:text-xs text-slate-400">Listrik/bln:</span>
            <span id="sav-ev-monthly" class="font-bold text-cyan-600 dark:text-cyan-300 tabular-nums">Rp 493rb</span>
          </div>
          <div class="bg-cyan-50/70 dark:bg-cyan-950/40 p-1 sm:p-0 rounded sm:rounded-none flex flex-col sm:flex-row sm:justify-between font-bold text-cyan-700 dark:text-cyan-300 sm:border-t sm:border-slate-100 sm:dark:border-white/10 sm:pt-1.5">
            <span class="text-[8px] sm:text-xs">Hemat/bln:</span>
            <span id="sav-monthly-result" class="font-black tabular-nums">Rp 1,7jt</span>
          </div>
        </div>

        <!-- Action Row: Custom Params Toggle (Mobile) + Direct CTA -->
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            id="toggle-savings-params-btn"
            class="lg:hidden px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-bold shrink-0 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer flex items-center gap-1"
            title="Ubah tarif dan konsumsi"
          >
            <img src="/icons/settings.svg" class="w-3 h-3 opacity-70 inline-block" alt="" />
            <span>Edit Nilai</span>
          </button>
          <a href="/katalog-mobil" class="flex-1 py-1.5 sm:py-2 px-2 sm:px-4 rounded-lg sm:rounded-xl bg-linear-to-r from-[#0284c7] to-[#06b6d4] hover:from-[#0ea5e9] hover:to-[#22d3ee] text-white font-black text-[10px] sm:text-xs text-center transition-all shadow-xs shadow-cyan-500/30 truncate">
            Eksplor Mobil Listrik Irit →
          </a>
        </div>
      </div>

    </div>
  </div>


  <!-- ================================================================= -->
  <!-- PANEL 2: KALKULATOR BIAYA PENGISIAN (SPKLU & HOME CHARGING) -->
  <!-- ================================================================= -->
  <div id="panel-charging" class="calc-panel pt-2.5 sm:pt-4 space-y-2.5 sm:space-y-4 hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 sm:gap-5 items-stretch">
      
      <!-- Left Controls (7 Cols on Desktop) -->
      <div class="lg:col-span-7 space-y-2 sm:space-y-3 flex flex-col justify-between">
        <!-- Quick Preset Pills: Horizontal Scrolling -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <span class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 dark:text-slate-500 uppercase tracking-wider shrink-0 pr-0.5">
            Model:
          </span>
          <button type="button" class="spklu-chip active-chip shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-bold border transition cursor-pointer bg-cyan-500/10 text-cyan-600 dark:text-cyan-300 border-cyan-500/40" data-kwh="82.5" data-name="BYD Seal">
            BYD Seal (82.5 kWh)
          </button>
          <button type="button" class="spklu-chip shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-cyan-400 text-slate-700 dark:text-slate-300 transition cursor-pointer" data-kwh="77.4" data-name="Ioniq 5">
            Ioniq 5 (77.4 kWh)
          </button>
          <button type="button" class="spklu-chip shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-cyan-400 text-slate-700 dark:text-slate-300 transition cursor-pointer" data-kwh="61" data-name="Omoda E5">
            Omoda E5 (61 kWh)
          </button>
          <button type="button" class="spklu-chip shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-cyan-400 text-slate-700 dark:text-slate-300 transition cursor-pointer" data-kwh="37.9" data-name="BinguoEV">
            BinguoEV (38 kWh)
          </button>
          <button type="button" class="spklu-chip shrink-0 whitespace-nowrap px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold border border-slate-200 dark:border-slate-700 hover:border-cyan-400 text-slate-700 dark:text-slate-300 transition cursor-pointer" data-kwh="26.7" data-name="Air ev">
            Air ev (27 kWh)
          </button>
        </div>

        <!-- Slider Range Capacity + Direct Input -->
        <div class="space-y-1 bg-slate-50 dark:bg-slate-900/60 p-2 sm:p-3 rounded-xl sm:rounded-2xl border border-slate-200/70 dark:border-white/10">
          <div class="flex justify-between items-center text-[10px] sm:text-xs font-bold">
            <label for="chg-cap-slider" class="text-slate-700 dark:text-slate-300">Kapasitas Baterai:</label>
            <div class="flex items-center gap-1">
              <input
                type="number"
                id="chg-cap-input"
                value="82.5"
                step="0.5"
                min="10"
                max="140"
                class="w-14 sm:w-16 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md px-1 py-0.5 text-[11px] sm:text-xs font-black text-cyan-600 dark:text-cyan-400 text-right outline-hidden"
              />
              <span class="text-[10px] sm:text-xs text-slate-500 font-bold">kWh</span>
            </div>
          </div>
          <input
            type="range"
            id="chg-cap-slider"
            min="15"
            max="120"
            step="0.5"
            value="82.5"
            class="w-full h-1.5 sm:h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
          />
        </div>

        <!-- Scenario Mode & Custom Tariff Options (Collapsible on Mobile, Grid on Desktop) -->
        <div id="chg-custom-wrapper" class="hidden lg:grid grid-cols-1 sm:grid-cols-2 gap-1.5 sm:gap-3">
          <!-- Skenario Pengisian -->
          <div class="space-y-0.5 sm:space-y-1">
            <span class="text-[8px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block">
              Skenario Pengisian:
            </span>
            <div class="grid grid-cols-2 gap-1 sm:gap-1.5">
              <label class="scenario-option flex items-center justify-center p-1.5 sm:p-2 rounded-lg sm:rounded-xl border border-cyan-500/40 bg-cyan-500/10 cursor-pointer text-[10px] sm:text-xs font-bold text-slate-800 dark:text-white">
                <input type="radio" name="chg-scenario" value="daily" checked class="hidden" />
                <span class="flex items-center gap-1"><img src="/icons/battery-bolt.svg" class="w-3 h-3 opacity-70 inline-block" alt="" /> 20% → 80%</span>
              </label>
              <label class="scenario-option flex items-center justify-center p-1.5 sm:p-2 rounded-lg sm:rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer text-[10px] sm:text-xs font-bold text-slate-800 dark:text-white">
                <input type="radio" name="chg-scenario" value="full" class="hidden" />
                <span class="flex items-center gap-1"><img src="/icons/battery.svg" class="w-3 h-3 opacity-70 inline-block" alt="" /> 10% → 100%</span>
              </label>
            </div>
          </div>

          <!-- Tarif Listrik SPKLU Input -->
          <div class="space-y-0.5 sm:space-y-1">
            <span class="text-[8px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block">
              Tarif SPKLU (Rp/kWh):
            </span>
            <div class="flex items-center gap-1.5">
              <input
                type="number"
                id="spklu-tariff-input"
                value="2466"
                step="50"
                class="w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg sm:rounded-xl px-2 py-0.5 sm:py-1.5 text-[11px] sm:text-xs font-bold text-slate-900 dark:text-white outline-hidden focus:ring-2 focus:ring-cyan-500 tabular-nums"
              />
              <span class="text-[9px] font-semibold text-slate-400 shrink-0">Resmi PLN</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Output Card (5 Cols on Desktop) -->
      <div class="lg:col-span-5 bg-white dark:bg-linear-to-br dark:from-[rgba(4,15,32,0.88)] dark:via-[rgba(5,22,50,0.85)] dark:to-[rgba(7,40,80,0.82)] dark:backdrop-blur-xl text-slate-900 dark:text-white p-2.5 sm:p-5 lg:p-6 rounded-xl sm:rounded-3xl border border-cyan-200 dark:border-cyan-500/25 shadow-xs sm:shadow-xl dark:shadow-cyan-950/40 flex flex-col justify-between gap-2 sm:gap-3">
        <div>
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-white/10 pb-1.5">
            <span class="text-[8px] sm:text-[10px] font-black uppercase text-cyan-700 dark:text-cyan-400 tracking-wider">Kebutuhan Daya</span>
            <span id="chg-energy-needed" class="text-[11px] sm:text-xs font-black text-slate-800 dark:text-white tabular-nums">49.5 kWh</span>
          </div>

          <!-- Cost Comparison Grid -->
          <div class="grid grid-cols-2 gap-1.5 sm:gap-2.5 mt-1.5 sm:mt-3">
            <div class="p-2 sm:p-3 rounded-lg sm:rounded-2xl bg-cyan-50 dark:bg-white/8 border border-cyan-200 dark:border-cyan-500/20 space-y-0.5">
              <span class="text-[8px] sm:text-[10px] font-extrabold text-cyan-700 dark:text-cyan-400 uppercase block">SPKLU Fast DC</span>
              <span id="chg-cost-spklu" class="text-xs sm:text-base lg:text-lg font-black text-slate-800 dark:text-white block tabular-nums">Rp 122.067</span>
              <span id="chg-time-spklu" class="text-[8px] sm:text-[10px] text-slate-400 block">~25 - 35 menit</span>
            </div>

            <div class="p-2 sm:p-3 rounded-lg sm:rounded-2xl bg-sky-50 dark:bg-white/8 border border-sky-200 dark:border-sky-400/25 space-y-0.5">
              <span class="text-[8px] sm:text-[10px] font-extrabold text-sky-600 dark:text-sky-300 uppercase block">Home Charging</span>
              <span id="chg-cost-home" class="text-xs sm:text-base lg:text-lg font-black text-sky-700 dark:text-sky-200 block tabular-nums">Rp 58.806</span>
              <span class="text-[8px] sm:text-[10px] text-sky-500 dark:text-sky-300/70 block">Diskon 30% Malam</span>
            </div>
          </div>
        </div>

        <div class="text-[9px] sm:text-[11px] text-slate-500 dark:text-slate-300 border-t border-slate-100 dark:border-white/10 pt-1.5 sm:pt-3 flex justify-between font-medium">
          <span>Jarak Tambahan: <strong id="chg-range-added" class="text-cyan-600 dark:text-cyan-300">~340 km</strong></span>
          <span>Biaya Home: <strong class="text-sky-600 dark:text-sky-300">Rp 172/km</strong></span>
        </div>

        <!-- Action Row: Custom Tariff Toggle (Mobile) + Direct CTA -->
        <div class="flex items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            id="toggle-charging-params-btn"
            class="lg:hidden px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-bold shrink-0 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer flex items-center gap-1"
            title="Ubah tarif SPKLU"
          >
            <img src="/icons/settings.svg" class="w-3 h-3 opacity-70 inline-block" alt="" />
            <span>Skenario</span>
          </button>
          <a href="/spklu" class="flex-1 py-1.5 sm:py-2 px-2 sm:px-4 rounded-lg sm:rounded-xl bg-linear-to-r from-[#0284c7] to-[#06b6d4] hover:from-[#0ea5e9] hover:to-[#22d3ee] text-white font-black text-[10px] sm:text-xs text-center transition-all shadow-xs shadow-cyan-500/30 truncate">
            Cari Titik SPKLU Terdekat →
          </a>
        </div>
      </div>

    </div>
  </div>


</div>

<!-- Interactive Calculator Script -->
<script>
  function initHeroCalculators() {
    const tabCharging = document.getElementById('tab-btn-charging');
    const tabSavings = document.getElementById('tab-btn-savings');
    const panelCharging = document.getElementById('panel-charging');
    const panelSavings = document.getElementById('panel-savings');

    // Mobile Collapsible Toggles
    const toggleSavingsBtn = document.getElementById('toggle-savings-params-btn');
    const savCustomWrapper = document.getElementById('sav-custom-wrapper');
    if (toggleSavingsBtn && savCustomWrapper) {
      toggleSavingsBtn.addEventListener('click', () => {
        savCustomWrapper.classList.toggle('hidden');
        const isHidden = savCustomWrapper.classList.contains('hidden');
        toggleSavingsBtn.innerHTML = isHidden ? '<img src="/icons/settings.svg" class="w-3 h-3 opacity-70 inline-block" alt="" /> <span>Edit Nilai</span>' : '▲ <span>Tutup Edit</span>';
      });
    }

    const toggleChargingBtn = document.getElementById('toggle-charging-params-btn');
    const chgCustomWrapper = document.getElementById('chg-custom-wrapper');
    if (toggleChargingBtn && chgCustomWrapper) {
      toggleChargingBtn.addEventListener('click', () => {
        chgCustomWrapper.classList.toggle('hidden');
        const isHidden = chgCustomWrapper.classList.contains('hidden');
        toggleChargingBtn.innerHTML = isHidden ? '<img src="/icons/settings.svg" class="w-3 h-3 opacity-70 inline-block" alt="" /> <span>Skenario</span>' : '▲ <span>Tutup Skenario</span>';
      });
    }

    if (tabCharging && tabSavings && panelCharging && panelSavings) {
      tabCharging.addEventListener('click', () => {
        panelCharging.classList.remove('hidden');
        panelCharging.classList.add('block');
        panelSavings.classList.remove('block');
        panelSavings.classList.add('hidden');

        tabCharging.classList.add('bg-white', 'dark:bg-cyan-600', 'text-cyan-700', 'dark:text-white', 'shadow-xs');
        tabCharging.classList.remove('text-slate-600', 'dark:text-slate-300');
        tabSavings.classList.remove('bg-white', 'dark:bg-cyan-600', 'text-cyan-700', 'dark:text-white', 'shadow-xs');
        tabSavings.classList.add('text-slate-600', 'dark:text-slate-300');
      });

      tabSavings.addEventListener('click', () => {
        panelSavings.classList.remove('hidden');
        panelSavings.classList.add('block');
        panelCharging.classList.remove('block');
        panelCharging.classList.add('hidden');

        tabSavings.classList.add('bg-white', 'dark:bg-cyan-600', 'text-cyan-700', 'dark:text-white', 'shadow-xs');
        tabSavings.classList.remove('text-slate-600', 'dark:text-slate-300');
        tabCharging.classList.remove('bg-white', 'dark:bg-cyan-600', 'text-cyan-700', 'dark:text-white', 'shadow-xs');
        tabCharging.classList.add('text-slate-600', 'dark:text-slate-300');
      });
    }

    // ==========================================
    // 1. Savings Simulator Logic
    // ==========================================
    const savDistSlider = document.getElementById('sav-dist-slider') as HTMLInputElement | null;
    const savDistLabel = document.getElementById('sav-dist-label');
    const savFuelPrice = document.getElementById('sav-fuel-price') as HTMLInputElement | null;
    const savEvPrice = document.getElementById('sav-ev-price') as HTMLInputElement | null;
    const savFuelKml = document.getElementById('sav-fuel-kml') as HTMLInputElement | null;
    const savEvKwh = document.getElementById('sav-ev-kwh') as HTMLInputElement | null;
    const savAnnualResult = document.getElementById('sav-annual-result');
    const savFuelMonthly = document.getElementById('sav-fuel-monthly');
    const savEvMonthly = document.getElementById('sav-ev-monthly');
    const savMonthlyResult = document.getElementById('sav-monthly-result');
    const presetCompareBtns = document.querySelectorAll('.preset-compare-btn');

    function updateSavingsCalc() {
      if (!savDistSlider || !savDistLabel || !savFuelPrice || !savEvPrice || !savFuelKml || !savEvKwh || !savAnnualResult || !savFuelMonthly || !savEvMonthly || !savMonthlyResult) return;

      const kmPerDay = parseFloat(savDistSlider.value) || 50;
      savDistLabel.textContent = `${kmPerDay} km/hari`;

      const fuelPrice = parseFloat(savFuelPrice.value) || 13700;
      const evPrice = parseFloat(savEvPrice.value) || 1700;
      const fuelKml = parseFloat(savFuelKml.value) || 11;
      const evKwh = parseFloat(savEvKwh.value) || 6.2;

      const monthlyKm = kmPerDay * 30;
      const monthlyFuelCost = (monthlyKm / fuelKml) * fuelPrice;
      const monthlyEvCost = (monthlyKm / evKwh) * evPrice;
      const monthlySavings = Math.max(0, monthlyFuelCost - monthlyEvCost);
      const annualSavings = monthlySavings * 12;

      savFuelMonthly.textContent = `Rp ${Math.round(monthlyFuelCost).toLocaleString('id-ID')}`;
      savEvMonthly.textContent = `Rp ${Math.round(monthlyEvCost).toLocaleString('id-ID')}`;
      savMonthlyResult.textContent = `Rp ${Math.round(monthlySavings).toLocaleString('id-ID')}`;
      savAnnualResult.textContent = `Rp ${Math.round(annualSavings).toLocaleString('id-ID')}`;
    }

    if (savDistSlider) savDistSlider.addEventListener('input', updateSavingsCalc);
    if (savFuelPrice) savFuelPrice.addEventListener('input', updateSavingsCalc);
    if (savEvPrice) savEvPrice.addEventListener('input', updateSavingsCalc);
    if (savFuelKml) savFuelKml.addEventListener('input', updateSavingsCalc);
    if (savEvKwh) savEvKwh.addEventListener('input', updateSavingsCalc);

    presetCompareBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetCompareBtns.forEach(b => b.classList.remove('active-preset', 'bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-300', 'border-cyan-500/40'));
        btn.classList.add('active-preset', 'bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-300', 'border-cyan-500/40');

        const kml = btn.getAttribute('data-fuel-kml');
        const kwh = btn.getAttribute('data-ev-kwh');
        const dist = btn.getAttribute('data-dist');

        if (kml && savFuelKml) savFuelKml.value = kml;
        if (kwh && savEvKwh) savEvKwh.value = kwh;
        if (dist && savDistSlider) savDistSlider.value = dist;

        updateSavingsCalc();
      });
    });

    // ==========================================
    // 2. Charging Simulator Logic
    // ==========================================
    const chgCapSlider = document.getElementById('chg-cap-slider') as HTMLInputElement | null;
    const chgCapInput = document.getElementById('chg-cap-input') as HTMLInputElement | null;
    const chgEnergyNeeded = document.getElementById('chg-energy-needed');
    const chgCostSpklu = document.getElementById('chg-cost-spklu');
    const chgCostHome = document.getElementById('chg-cost-home');
    const chgRangeAdded = document.getElementById('chg-range-added');
    const spkluTariffInput = document.getElementById('spklu-tariff-input') as HTMLInputElement | null;
    const chgChips = document.querySelectorAll('.spklu-chip');
    const scenarioRadios = document.querySelectorAll('input[name="chg-scenario"]');

    function updateChargingCalc() {
      if (!chgCapSlider || !chgCapInput || !chgEnergyNeeded || !chgCostSpklu || !chgCostHome || !spkluTariffInput) return;

      const cap = parseFloat(chgCapSlider.value) || 60;
      chgCapInput.value = cap.toString();

      const isDaily = (document.querySelector('input[name="chg-scenario"]:checked') as HTMLInputElement)?.value === 'daily';
      const percentage = isDaily ? 0.60 : 0.90; // 20->80% or 10->100%
      const kwhNeeded = cap * percentage;
      chgEnergyNeeded.textContent = `${kwhNeeded.toFixed(1)} kWh`;

      const spkluTariff = parseFloat(spkluTariffInput.value) || 2466;
      const homeTariff = 1189; // PLN home charging night discount 30%

      const costSpklu = Math.round(kwhNeeded * spkluTariff);
      const costHome = Math.round(kwhNeeded * homeTariff);

      chgCostSpklu.textContent = `Rp ${costSpklu.toLocaleString('id-ID')}`;
      chgCostHome.textContent = `Rp ${costHome.toLocaleString('id-ID')}`;

      if (chgRangeAdded) {
        const estKm = Math.round(kwhNeeded * 6.5);
        chgRangeAdded.textContent = `~${estKm} km`;
      }
    }

    if (chgCapSlider) {
      chgCapSlider.addEventListener('input', () => {
        chgChips.forEach(c => c.classList.remove('active-chip', 'bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-300', 'border-cyan-500/40'));
        updateChargingCalc();
      });
    }

    if (chgCapInput) {
      chgCapInput.addEventListener('input', () => {
        if (chgCapSlider) chgCapSlider.value = chgCapInput.value;
        updateChargingCalc();
      });
    }

    if (spkluTariffInput) {
      spkluTariffInput.addEventListener('input', updateChargingCalc);
    }

    chgChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const kwh = chip.getAttribute('data-kwh');
        if (kwh && chgCapSlider && chgCapInput) {
          chgChips.forEach(c => c.classList.remove('active-chip', 'bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-300', 'border-cyan-500/40'));
          chip.classList.add('active-chip', 'bg-cyan-500/10', 'text-cyan-600', 'dark:text-cyan-300', 'border-cyan-500/40');
          chgCapSlider.value = kwh;
          chgCapInput.value = kwh;
          updateChargingCalc();
        }
      });
    });

    scenarioRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.scenario-option').forEach(el => {
          el.classList.remove('border-cyan-500/40', 'bg-cyan-500/10');
          el.classList.add('border-slate-200', 'dark:border-slate-700');
        });
        const parent = radio.closest('.scenario-option');
        if (parent) {
          parent.classList.remove('border-slate-200', 'dark:border-slate-700');
          parent.classList.add('border-cyan-500/40', 'bg-cyan-500/10');
        }
        updateChargingCalc();
      });
    });

    updateSavingsCalc();
    updateChargingCalc();
  }

  initHeroCalculators();
  document.addEventListener('astro:page-load', initHeroCalculators);
</script>
