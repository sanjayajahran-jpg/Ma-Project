---
// EVnesia Automotive Catalog & Smart Instant Search Component
// Advanced Multi-Stage Filtering: Range Slider, Powertrain, Min Range (>400km), Body Type, Brand & Sorting
// Fast In-Memory Client Filtering, URL Synced State, Zero Obstructive Overlays
// Pure Minimalist Scandinavian / Executive UI (Zero Emojis, Crisp Vector SVG Assets)
import { fetchCarsFromApi, fetchBrandsFromApi } from "@/lib/api";
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";

interface Props {
  initialBrand?: string;
}

const { initialBrand = "all" } = Astro.props;

// Powertrain Categories for Instant Filtering (Clean SVG Assets)
const ENGINE_TYPES_LIST = [
  { val: "all", label: "Semua Powertrain", short: "Semua", icon: "/icons/zap.svg" },
  { val: "bev", label: "BEV (Murni Listrik)", short: "BEV Listrik", icon: "/icons/battery-bolt.svg", desc: "100% Listrik Murni" },
  { val: "phev", label: "PHEV (Plug-in Hybrid)", short: "PHEV", icon: "/icons/plug.svg", desc: "Colok Listrik + Bensin" },
  { val: "hev", label: "HEV (Full Hybrid)", short: "Hybrid", icon: "/icons/leaf.svg", desc: "Self-Charging Bensin Irit" }
];

// Body Types Categories (Clean SVG Assets)
const BODY_TYPES = [
  { id: "all", label: "Semua Bodi", icon: "/icons/car.svg" },
  { id: "suv", label: "SUV & Crossover", icon: "/icons/suv.svg" },
  { id: "mpv", label: "MPV Keluarga", icon: "/icons/van.svg" },
  { id: "sedan", label: "Sedan & Coupe", icon: "/icons/sedan.svg" },
  { id: "citycar", label: "City Car & Hatchback", icon: "/icons/hatchback.svg" }
];

// Quick Minimum Range Presets
const RANGE_PRESETS = [
  { val: 0, label: "Semua Jarak" },
  { val: 300, label: "≥ 300 km", hint: "Harian Kota" },
  { val: 400, label: "≥ 400 km", hint: "Luar Kota" },
  { val: 500, label: "≥ 500 km", hint: "Antar Provinsi" },
  { val: 600, label: "≥ 600 km", hint: "Ultra Long" }
];

// Quick Budget Presets
const BUDGET_PRESETS = [
  { min: 0, max: 1500, label: "Semua Budget" },
  { min: 0, max: 400, label: "< Rp 400 Jt" },
  { min: 400, max: 800, label: "Rp 400 - 800 Jt" },
  { min: 800, max: 1200, label: "Rp 800 Jt - 1,2 M" },
  { min: 1200, max: 9999, label: "> Rp 1,2 Miliar" }
];

const INITIAL_FALLBACK_CARS = ELECTRIFIED_CARS_DATA;

// Helper normalize brand for matching
const normBrand = (s: string) => (s || "").toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, "");

// Calculate real model counts per brand from dataset
const brandModelCounts: Record<string, number> = {};
const engineTypeCounts: Record<string, number> = { all: ELECTRIFIED_CARS_DATA.length, bev: 0, phev: 0, hev: 0 };
const bodyTypeCounts: Record<string, number> = { all: ELECTRIFIED_CARS_DATA.length, suv: 0, mpv: 0, sedan: 0, citycar: 0 };

ELECTRIFIED_CARS_DATA.forEach((c: any) => {
  const bk = normBrand(c.brand);
  brandModelCounts[bk] = (brandModelCounts[bk] || 0) + 1;

  const eng = (c.engineType || "").toLowerCase();
  if (eng === "bev" || eng === "ev") engineTypeCounts.bev = (engineTypeCounts.bev || 0) + 1;
  else if (eng === "phev") engineTypeCounts.phev = (engineTypeCounts.phev || 0) + 1;
  else if (eng === "hev" || eng === "hybrid") engineTypeCounts.hev = (engineTypeCounts.hev || 0) + 1;

  const bdy = (c.bodyType || "").toLowerCase();
  if (bdy === "suv" || bdy === "crossover") bodyTypeCounts.suv = (bodyTypeCounts.suv || 0) + 1;
  else if (bdy === "mpv") bodyTypeCounts.mpv = (bodyTypeCounts.mpv || 0) + 1;
  else if (bdy === "sedan" || bdy === "coupe") bodyTypeCounts.sedan = (bodyTypeCounts.sedan || 0) + 1;
  else if (bdy === "hatchback" || bdy === "city car" || bdy === "citycar" || bdy === "compact") bodyTypeCounts.citycar = (bodyTypeCounts.citycar || 0) + 1;
});

// Dynamically generate unique brands from dataset
const uniqueBrands = Array.from(new Set(ELECTRIFIED_CARS_DATA.map((c: any) => c.brand))).filter(Boolean).sort();
const DEFAULT_BRANDS = [
  { val: "all", label: "Semua Merek", count: ELECTRIFIED_CARS_DATA.length },
  ...uniqueBrands.map(b => ({
    val: b,
    label: b,
    count: brandModelCounts[normBrand(b)] || 0
  }))
];

const BRAND_LOGOS: Record<string, string> = {
  "aletra": "/images/brands/aletra-logo.svg",
  "baic": "/images/brands/baic-logo.svg",
  "bmw": "/images/brands/bmw-logo.svg",
  "byd": "/images/brands/byd-logo.svg",
  "changan": "/images/brands/changan-logo.svg",
  "chery": "/images/brands/chery-logo.svg",
  "citroen": "/images/brands/citroen-logo.svg",
  "citroën": "/images/brands/citroen-logo.svg",
  "daihatsu": "/images/brands/daihatsu-logo.svg",
  "denza": "/images/brands/denza-logo.svg",
  "dfsk": "/images/brands/dfsk-logo.svg",
  "foton": "/images/brands/foton-logo.svg",
  "gac": "/images/brands/gac-logo.svg",
  "gac aion": "/images/brands/gac-logo.svg",
  "geely": "/images/brands/geely-logo.svg",
  "gwm": "/images/brands/gwm-logo.svg",
  "honda": "/images/brands/honda-logo.svg",
  "hyundai": "/images/brands/hyundai-logo.svg",
  "icar": "/images/brands/icar-seeklogo.svg",
  "jaecoo": "/images/brands/jaecoo-logo.svg",
  "jetour": "/images/brands/jetour-logo.svg",
  "kia": "/images/brands/kia-logo.svg",
  "leapmotor": "/images/brands/leapmotor-logo.svg",
  "lepas": "/images/brands/lepas-logo.svg",
  "lexus": "/images/brands/lexus-logo.svg",
  "maxus": "/images/brands/maxus-logo.svg",
  "mazda": "/images/brands/mazda-logo.svg",
  "mercedes-benz": "/images/brands/mercedes-benz-logo.svg",
  "mg": "/images/brands/mg-logo.svg",
  "mini": "/images/brands/mini-logo.svg",
  "mitsubishi": "/images/brands/mitsubishi-logo.svg",
  "nissan": "/images/brands/nissan-logo.svg",
  "polytron": "/images/brands/polytron-logo.svg",
  "porsche": "/images/brands/porsche-logo.svg",
  "seres": "/images/brands/seres-logo.svg",
  "tesla": "/images/brands/tesla-logo.svg",
  "toyota": "/images/brands/toyota-logo.svg",
  "vinfast": "/images/brands/vinfast-logo.svg",
  "volkswagen": "/images/brands/volkswagen-logo.svg",
  "volvo": "/images/brands/volvo-logo.svg",
  "wuling": "/images/brands/wuling-logo.svg",
  "xpeng": "/images/brands/xpeng-logo.svg",
  "zeekr": "/images/brands/zeekr-logo.svg",
};

// SSR Hybrid Fetch: try to get live cars from backend API, fall back to curated dataset
const [liveApiCars, liveApiBrands] = await Promise.all([
  fetchCarsFromApi(200),
  fetchBrandsFromApi()
]);

const BRANDS = liveApiBrands && liveApiBrands.length
  ? [{ val: "all", label: "Semua Merek", count: ELECTRIFIED_CARS_DATA.length }, ...liveApiBrands.map((b: any) => ({
      val: b.name,
      label: b.name,
      count: b.car_count || brandModelCounts[normBrand(b.name)] || 0
    }))]
  : DEFAULT_BRANDS;

const INITIAL_CARS = (liveApiCars && liveApiCars.length >= 5)
  ? liveApiCars.map((c: any) => {
      const fallbackMatch = INITIAL_FALLBACK_CARS.find(f => f.slug === c.slug || f.name.toLowerCase() === c.name.toLowerCase());
      return {
        id: c.id,
        slug: c.slug,
        name: c.name,
        brand: c.brand_name || fallbackMatch?.brand || "EVnesia",
        bodyType: c.body_type_slug || fallbackMatch?.bodyType || "suv",
        engineType: c.engine_type_slug || fallbackMatch?.engineType || "bev",
        engineLabel: c.engine_type_slug === 'bev' || c.engine_type_slug === 'ev' ? 'Electric (BEV)' : c.engine_type_slug === 'phev' ? 'Plug-in Hybrid (PHEV)' : 'Full Hybrid (HEV)',
        price: c.price_start ? `Rp ${Math.round(c.price_start / 1000000)} Juta` : (fallbackMatch?.price || "Hubungi APM"),
        priceVal: c.price_start ? Math.round(c.price_start / 1000000) : (fallbackMatch?.priceVal || 500),
        img: c.image_url || fallbackMatch?.img || "https://images.unsplash.com/photo-1617788138017-80ad40651399?q=80&w=800",
        hp: fallbackMatch?.hp || "200 HP",
        torque: fallbackMatch?.torque || "350 Nm",
        acc: fallbackMatch?.acc || "6.5s",
        consumption: fallbackMatch?.consumption || "Jarak 450 km",
        badge: fallbackMatch?.badge || "PRO VERIFIED",
        tagline: c.tagline || fallbackMatch?.tagline || "",
        description: c.description || fallbackMatch?.description || "",
        specs: c.specs || fallbackMatch?.specs || {},
        variants: (c.variants && c.variants.length) ? c.variants : (fallbackMatch?.variants || [])
      };
    })
  : INITIAL_FALLBACK_CARS;
---

<div class="space-y-8 car-finder-root" data-initial-brand={initialBrand}>
  <!-- Top Header Title -->
  <div class="border-b border-slate-200/60 dark:border-white/10 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="text-[10px] font-extrabold text-cyan-600 dark:text-cyan-400 uppercase tracking-widest block">
        KATALOG RESMI & SPESIFIKASI MOBIL ELEKTRIFIKASI
      </span>
      <h1 class="font-headline text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
        Pencarian Pintar & Filter Spesifikasi EV
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal mt-1 max-w-3xl">
        Temukan mobil listrik & hybrid idaman berdasarkan rentang harga, teknologi baterai, jarak tempuh nyata, dan tipe bodi secara instan.
      </p>
    </div>
    
    <!-- Live Status Indicator Badge -->
    <div class="flex items-center gap-2 self-start sm:self-auto shrink-0 bg-white dark:bg-slate-900/60 px-3.5 py-1.5 rounded-full border border-slate-200 dark:border-white/10 text-[11px] font-bold shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" id="api-live-indicator-dot"></span>
      <span class="text-slate-600 dark:text-slate-300" id="api-live-status-text">Database Neon Active ({INITIAL_CARS.length} Unit)</span>
    </div>
  </div>

  <!-- Multi-Stage Filter Control Panel Card (Sleek Apple Liquid Glass) -->
  <div class="rounded-3xl apple-liquid-glass p-5 sm:p-7 space-y-6 shadow-xl border border-slate-200/80 dark:border-white/10 transition-all duration-300">
    
    <!-- 0. BARIS PENCARIAN SMART INSTANT MULTI-KATA & KEYWORDS -->
    <div class="space-y-2.5">
      <div class="relative flex items-center">
        <i class="absolute left-4 text-cyan-600 dark:text-cyan-400 pointer-events-none flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </i>
        <input
          type="text"
          id="car-search-input"
          placeholder="Ketik model, pabrikan, atau fitur (contoh: Ioniq 5, BYD Seal, LFP, AWD, V2L, ADAS)..."
          class="w-full pl-11 pr-24 py-3 sm:py-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-white text-xs sm:text-sm font-medium shadow-xs focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition placeholder-slate-400"
          autocomplete="off"
        />
        <div class="absolute right-3 flex items-center gap-1.5">
          <span class="hidden sm:inline-block px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-[10px] font-mono text-slate-400 border border-slate-200 dark:border-slate-700 select-none">
            /
          </span>
          <button
            type="button"
            id="clear-search-btn"
            class="px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white text-[11px] font-bold hidden transition cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

      <!-- Quick Suggestion Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar text-xs font-semibold">
        <span class="text-slate-400 shrink-0 text-[11px] font-bold">Populer:</span>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="BYD Seal">BYD Seal</button>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="Ioniq 5">Ioniq 5</button>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="Binguo">Wuling Binguo</button>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="Zenix">Innova Zenix Hybrid</button>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="Omoda E5">Chery Omoda E5</button>
        <button type="button" class="quick-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer" data-keyword="Blade">Baterai LFP Blade</button>
      </div>
    </div>

    <!-- 1. TIPE POWERTRAIN (Instant Segmented Toggle) -->
    <div class="space-y-2.5 border-t border-slate-200/60 dark:border-white/10 pt-4">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
          1. Tipe Powertrain Elektrifikasi:
        </label>
        <span class="text-[11px] font-medium text-slate-400" id="powertrain-active-desc">Semua Teknologi Mesin</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="engine-filter-group">
        {ENGINE_TYPES_LIST.map((eng, idx) => (
          <button
            type="button"
            data-engine-val={eng.val}
            data-active={idx === 0 ? "true" : "false"}
            class="powertrain-filter-btn flex items-center justify-between p-2.5 sm:p-3 rounded-2xl text-left border transition-all cursor-pointer bg-slate-50 dark:bg-slate-900 border-slate-200/80 dark:border-slate-800 hover:border-cyan-400 hover:shadow-xs group"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-8 h-8 rounded-xl bg-slate-200/60 dark:bg-slate-800 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <img src={eng.icon} alt="" class="w-4 h-4 opacity-80 group-hover:opacity-100 dark:invert" />
              </span>
              <div class="truncate">
                <span class="block text-xs font-bold text-slate-900 dark:text-white truncate">{eng.short}</span>
                <span class="hidden sm:block text-[10px] text-slate-400 dark:text-slate-500 truncate">{eng.desc || 'Listrik & Hybrid'}</span>
              </div>
            </div>
            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-full bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-400 shrink-0">
              {engineTypeCounts[eng.val] ?? ELECTRIFIED_CARS_DATA.length}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- 2. TIPE BODI KENDARAAN (SUV, MPV, Sedan, City Car) -->
    <div class="space-y-2.5 border-t border-slate-200/60 dark:border-white/10 pt-4">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
          2. Tipe Bodi Kendaraan:
        </label>
        <span class="text-[11px] font-medium text-slate-400">SUV, MPV, Sedan, City Car</span>
      </div>
      <div class="flex flex-wrap gap-2" id="body-filter-group">
        {BODY_TYPES.map((type, idx) => (
          <button
            type="button"
            data-body-type={type.id}
            data-active={idx === 0 ? "true" : "false"}
            class="body-filter-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-cyan-400 cursor-pointer"
          >
            <img src={type.icon} alt="" class="w-3.5 h-3.5 opacity-75 dark:invert shrink-0" />
            <span>{type.label}</span>
            <span class="text-[10px] font-mono opacity-60 ml-0.5">
              ({bodyTypeCounts[type.id] ?? ELECTRIFIED_CARS_DATA.length})
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- 3 & 4. DUAL SLIDERS: RENTANG HARGA & JARAK TEMPUH MINIMAL -->
    <div class="grid gap-6 md:grid-cols-2 border-t border-slate-200/60 dark:border-white/10 pt-4">
      
      <!-- 3. RENTANG HARGA (SLIDER + PRESETS) -->
      <div class="space-y-3 bg-white/60 dark:bg-slate-900/40 p-4 rounded-2xl border border-slate-200/60 dark:border-slate-800/80">
        <div class="flex justify-between items-center text-xs font-bold">
          <label for="budget-range-input" class="text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
            <img src="/icons/wallet.svg" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
            <span>3. Budget Maksimal:</span>
          </label>
          <span id="budget-value-display" class="font-headline font-black text-cyan-600 dark:text-cyan-400 text-sm">
            Semua Budget (Rp 1,5 M+)
          </span>
        </div>

        <input
          type="range"
          id="budget-range-input"
          min="150"
          max="1500"
          step="50"
          value="1500"
          class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
          aria-label="Rentang Budget Harga Mobil"
        />

        <div class="flex justify-between text-[10px] text-slate-400 font-medium">
          <span>Rp 150 Jt</span>
          <span>Rp 500 Jt</span>
          <span>Rp 1 M</span>
          <span>Rp 1,5 M+</span>
        </div>

        <!-- Budget Quick Presets -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          {BUDGET_PRESETS.map((bp) => (
            <button
              type="button"
              class="budget-preset-pill px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-[10px] font-bold text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-cyan-400 hover:text-cyan-500 transition cursor-pointer"
              data-max-budget={bp.max}
              data-min-budget={bp.min}
            >
              {bp.label}
            </button>
          ))}
        </div>
      </div>

      <!-- 4. JARAK TEMPUH MINIMAL (SLIDER + PRESETS) -->
      <div class="space-y-3 bg-white/60 dark:bg-slate-900/40 p-4 rounded-2xl border border-slate-200/60 dark:border-slate-800/80">
        <div class="flex justify-between items-center text-xs font-bold">
          <label for="range-slider-input" class="text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
            <img src="/icons/route.svg" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
            <span>4. Jarak Tempuh Minimal:</span>
          </label>
          <span id="range-value-display" class="font-headline font-black text-emerald-600 dark:text-emerald-400 text-sm">
            Semua Jarak (≥ 0 km)
          </span>
        </div>

        <input
          type="range"
          id="range-slider-input"
          min="0"
          max="700"
          step="50"
          value="0"
          class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500"
          aria-label="Jarak Tempuh Minimal Mobil Listrik"
        />

        <div class="flex justify-between text-[10px] text-slate-400 font-medium">
          <span>0 km</span>
          <span>300 km</span>
          <span>500 km</span>
          <span>700 km+</span>
        </div>

        <!-- Range Quick Presets -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          {RANGE_PRESETS.map((rp) => (
            <button
              type="button"
              class="range-preset-pill px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-[10px] font-bold text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-emerald-400 hover:text-emerald-500 transition cursor-pointer"
              data-min-range={rp.val}
            >
              {rp.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- 5. FILTER MEREK & URUTAN HASIL (SORTING) -->
    <div class="grid gap-4 sm:grid-cols-2 border-t border-slate-200/60 dark:border-white/10 pt-4">
      
      <!-- Brand Selector Dropdown -->
      <div class="space-y-1.5 relative" id="custom-brand-dropdown-container">
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
          5. Pabrikan / Brand:
        </label>
        
        <button
          type="button"
          id="brand-dropdown-trigger"
          class="w-full flex items-center justify-between rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-4 py-2.5 text-xs font-bold text-slate-900 dark:text-white outline-none hover:border-cyan-400 transition shadow-xs cursor-pointer"
        >
