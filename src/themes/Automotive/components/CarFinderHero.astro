            <a
              href={`/mobil/${car.slug}`}
              data-astro-prefetch="hover"
              class="inline-flex items-center justify-center gap-1 px-3.5 sm:px-4 py-2 rounded-xl bg-[#002b49] hover:bg-[#003b66] dark:bg-cyan-600 dark:hover:bg-cyan-500 text-xs font-bold text-white transition-all shadow-xs hover:shadow-md active:scale-95 group/btn whitespace-nowrap"
