          <!-- Key Metrics Grid: Range, Battery, Power, Accel (Minimalist Vector Icons) -->
          <div class="grid grid-cols-2 gap-2 rounded-2xl bg-slate-50/80 dark:bg-slate-900/80 p-2.5 text-[11px] border border-slate-100 dark:border-slate-800 tracking-tight tabular-nums">
            <div class="space-y-0.5">
