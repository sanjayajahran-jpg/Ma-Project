              class="inline-flex items-center justify-center p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-cyan-50 dark:hover:bg-cyan-950/60 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 text-xs font-bold transition border border-slate-200/80 dark:border-slate-700 cursor-pointer"
              title="Bandingkan mobil ini"
            >
              <img src="/icons/scale.svg" alt="Bandingkan" class="w-3.5 h-3.5 opacity-80 dark:invert" />
