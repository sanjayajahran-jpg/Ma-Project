  <!-- Empty State (Shown if no car matches search/filter) -->
  <div id="no-cars-fallback" class="hidden text-center py-16 px-4 rounded-3xl apple-liquid-glass border border-slate-200/80 dark:border-white/10 space-y-4">
    <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 text-cyan-500 flex items-center justify-center mx-auto border border-cyan-400/20">
      <img src="/icons/search.svg" alt="" class="w-7 h-7 opacity-70 dark:invert" />
    </div>
    <div class="space-y-1">
      <h3 class="font-headline text-lg font-extrabold text-slate-900 dark:text-white">Tidak Ada Kendaraan yang Cocok</h3>
