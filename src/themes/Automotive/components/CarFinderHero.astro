  <!-- Filtered Car Cards Grid -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 min-h-60" id="car-catalog-grid">
    {INITIAL_CARS.map((car) => {
      const bSlug = (car.brand || '').toLowerCase().replace(/\s*\(.*?\)/g, '').trim();
      const bLogo = BRAND_LOGOS[bSlug] || BRAND_LOGOS[bSlug.split(' ')[0]] || null;
