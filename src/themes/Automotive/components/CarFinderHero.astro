</div>

<script>
  function initCarFinderFilter() {
    const rootEl = document.querySelector('.car-finder-root') as HTMLElement | null;
    const initialBrandProp = rootEl?.dataset.initialBrand || "all";

    const params = new URLSearchParams(window.location.search);
    let currentPage = parseInt(params.get("page") || "1", 10);
    const PAGE_SIZE = 9;

    // Filter controls
    const searchInput = document.getElementById('car-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const engineBtns = document.querySelectorAll<HTMLButtonElement>('.powertrain-filter-btn');
    const bodyBtnGroup = document.querySelectorAll<HTMLButtonElement>('.body-filter-btn');
    const budgetInput = document.getElementById('budget-range-input') as HTMLInputElement | null;
    const budgetDisplay = document.getElementById('budget-value-display');
    const rangeSlider = document.getElementById('range-slider-input') as HTMLInputElement | null;
    const rangeDisplay = document.getElementById('range-value-display');
    const sortSelect = document.getElementById('catalog-sort-select') as HTMLSelectElement | null;
    
    // Summary & Meta
    const resultsCountDisplay = document.getElementById('results-count-display');
    const paginationInfoText = document.getElementById('pagination-info-text');
    const paginationStatusCounter = document.getElementById('pagination-status-counter');
    const paginationButtonsWrapper = document.getElementById('pagination-buttons-wrapper');
    const noCarsFallback = document.getElementById('no-cars-fallback');
    const activeFilterTagsContainer = document.getElementById('active-filter-tags-container');
    const resetAllBtn = document.getElementById('reset-all-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-filters-btn');
    const powertrainDesc = document.getElementById('powertrain-active-desc');

    const carCards = Array.from(document.querySelectorAll<HTMLElement>('.car-card'));

    // Normalizer and Matcher Functions
    const norm = (s: string) => (s || "").toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, "");

    function brandsMatch(b1: string, b2: string): boolean {
      if (!b1 || !b2 || b1 === "all" || b2 === "all") return true;
      const n1 = norm(b1);
      const n2 = norm(b2);
      if (n1 === n2) return true;
      if (n1.startsWith(n2) || n2.startsWith(n1)) return true;
      return false;
    }

    function enginesMatch(itemEngine: string, selectedEngine: string): boolean {
      if (!selectedEngine || selectedEngine === "all") return true;
      const ie = (itemEngine || "").toLowerCase();
      const se = (selectedEngine || "").toLowerCase();
      if (ie === se) return true;
      if (se === "bev" && (ie === "ev" || ie === "electric" || ie === "listrik")) return true;
      if ((se === "ev" || se === "electric" || se === "listrik") && (ie === "bev" || ie === "ev")) return true;
      if (se === "hybrid") return ie === "hev" || ie === "phev" || ie === "hybrid";
      if (se === "hev" && (ie === "hybrid" || ie === "hev")) return true;
      if (se === "phev" && (ie === "phev" || ie === "plug-in")) return true;
      return false;
    }

    function bodiesMatch(itemBody: string, selectedBody: string): boolean {
      if (!selectedBody || selectedBody === "all") return true;
      const ib = (itemBody || "").toLowerCase();
      const sb = (selectedBody || "").toLowerCase();
      if (ib === sb) return true;
      if (sb === "suv" && (ib === "crossover" || ib === "suv")) return true;
      if (sb === "mpv" && ib === "mpv") return true;
      if (sb === "sedan" && (ib === "sedan" || ib === "coupe")) return true;
      if (sb === "citycar" && (ib === "hatchback" || ib === "city car" || ib === "citycar" || ib === "compact" || ib === "mini")) return true;
      return false;
    }

    // In-memory Card Cache for ultra-fast filtering
    const cachedCardData = carCards.map((card) => {
      const raw = card.dataset.carData || "";
      const name = card.dataset.name || "";
      const brand = card.dataset.brand || "";
      const body = card.dataset.body || "";
      const engine = card.dataset.engine || "";
      const price = parseFloat(card.dataset.price || "0");
      const range = parseFloat(card.dataset.range || "0");
      const hp = parseFloat(card.dataset.hp || "0");
      const acc = parseFloat(card.dataset.acc || "0");
      const battery = parseFloat(card.dataset.battery || "0");
      
      const plainLower = `${name} ${brand} ${body} ${engine} ${raw}`.toLowerCase();
      const normalizedAll = norm(plainLower);

      return {
        el: card,
        name,
        brand,
        body: body.toLowerCase(),
        engine: engine.toLowerCase(),
        price,
        range,
        hp,
        acc,
        battery,
        searchableText: `${plainLower} ${normalizedAll}`
      };
    });

    // Dropdown Elements for Brand
    const brandTrigger = document.getElementById('brand-dropdown-trigger');
    const brandMenu = document.getElementById('brand-dropdown-menu');
    const brandLabel = document.getElementById('brand-dropdown-label');
    const brandArrow = document.getElementById('brand-dropdown-arrow');
    const brandItems = document.querySelectorAll<HTMLButtonElement>('[data-brand-val]');

    // Current State
    let searchQuery = params.get("q") || "";
    let selectedBody = params.get("body") || "all";
    let selectedEngine = params.get("engine") || params.get("powertrain") || "all";
    let selectedBrand = params.get("brand") || initialBrandProp || "all";
    let selectedBudget = parseFloat(params.get("budget") || "1500");
    let selectedMinRange = parseFloat(params.get("min_range") || "0");
    let currentSort = params.get("sort") || "featured";

    // Restore UI from URL params
    if (searchInput && searchQuery) {
      searchInput.value = searchQuery;
      if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
    }

    if (budgetInput && selectedBudget) {
      budgetInput.value = String(selectedBudget);
      if (budgetDisplay) {
        budgetDisplay.textContent = selectedBudget >= 1500 ? "Semua Budget (Rp 1,5 M+)" : `Maksimal: Rp ${selectedBudget} Juta`;
      }
    }

    if (rangeSlider && selectedMinRange) {
      rangeSlider.value = String(selectedMinRange);
      if (rangeDisplay) {
        rangeDisplay.textContent = selectedMinRange <= 0 ? "Semua Jarak (≥ 0 km)" : `Minimal: ≥ ${selectedMinRange} km`;
      }
    }

    if (sortSelect && currentSort) {
      sortSelect.value = currentSort;
    }

    function updatePowertrainUI() {
      engineBtns.forEach((btn) => {
        const val = btn.dataset.engineVal || "all";
        const isActive = val.toLowerCase() === selectedEngine.toLowerCase();
        btn.setAttribute('data-active', String(isActive));
        if (isActive) {
          btn.classList.add('border-cyan-500', 'bg-cyan-500/10', 'text-cyan-700', 'dark:text-cyan-300', 'shadow-xs');
          btn.classList.remove('bg-slate-50', 'dark:bg-slate-900', 'border-slate-200/80', 'dark:border-slate-800');
        } else {
          btn.classList.remove('border-cyan-500', 'bg-cyan-500/10', 'text-cyan-700', 'dark:text-cyan-300', 'shadow-xs');
          btn.classList.add('bg-slate-50', 'dark:bg-slate-900', 'border-slate-200/80', 'dark:border-slate-800');
        }
      });
      if (powertrainDesc) {
        if (selectedEngine === "bev") powertrainDesc.textContent = "Hanya Mobil Listrik Murni 100% BEV";
        else if (selectedEngine === "phev") powertrainDesc.textContent = "Hanya Mobil Plug-in Hybrid (Colok + Bensin)";
        else if (selectedEngine === "hev") powertrainDesc.textContent = "Hanya Mobil Full Hybrid (BBM Irit)";
        else powertrainDesc.textContent = "Semua Teknologi Mesin";
      }
    }

    function updateBodyUI() {
      bodyBtnGroup.forEach((btn) => {
        const bType = btn.dataset.bodyType || "all";
        const isActive = bType.toLowerCase() === selectedBody.toLowerCase();
        btn.setAttribute('data-active', String(isActive));
        if (isActive) {
          btn.classList.add('bg-cyan-600', 'text-white', 'border-cyan-600', 'shadow-xs');
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
        } else {
          btn.classList.remove('bg-cyan-600', 'text-white', 'border-cyan-600', 'shadow-xs');
          btn.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
        }
      });
    }

    function updateBrandUI(brandName: string) {
      if (brandName && brandName.toLowerCase() !== "all") {
        const matchItem = Array.from(brandItems).find(i => brandsMatch(i.dataset.brandVal || "", brandName));
        if (matchItem && brandLabel) {
          brandLabel.innerHTML = `<img src="/icons/car.svg" alt="" class="w-3.5 h-3.5 opacity-75 dark:invert shrink-0" /><span>${brandName}</span>`;
        }
      } else {
        if (brandLabel) brandLabel.innerHTML = `<img src="/icons/car.svg" alt="" class="w-3.5 h-3.5 opacity-75 dark:invert shrink-0" /><span>Semua Merek</span>`;
      }
    }

    updatePowertrainUI();
    updateBodyUI();
    updateBrandUI(selectedBrand);

    // Toggle Dropdowns
    function closeAllDropdowns() {
      if (brandMenu) brandMenu.classList.add('hidden');
      if (brandArrow) brandArrow.style.transform = 'rotate(0deg)';
    }

    if (brandTrigger && brandMenu && brandArrow) {
      brandTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = brandMenu.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
          brandMenu.classList.remove('hidden');
          brandArrow.style.transform = 'rotate(180deg)';
        }
      });
    }

    brandItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedBrand = item.dataset.brandVal || "all";
        updateBrandUI(selectedBrand);
        closeAllDropdowns();
        currentPage = 1;
        applyFiltersAndPagination();
      });
    });

    if (!(window as any).__carFinderDropdownClickAttached) {
      (window as any).__carFinderDropdownClickAttached = true;
      document.addEventListener('click', closeAllDropdowns);
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') closeAllDropdowns();
        if (e.key === '/' && document.activeElement !== searchInput) {
          e.preventDefault();
          searchInput?.focus();
        }
      });
    }

    // Engine Buttons Click
    engineBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedEngine = btn.dataset.engineVal || "all";
        updatePowertrainUI();
        currentPage = 1;
        applyFiltersAndPagination();
      });
    });

    // Body Buttons Click
    bodyBtnGroup.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedBody = btn.dataset.bodyType || "all";
        updateBodyUI();
        currentPage = 1;
        applyFiltersAndPagination();
      });
    });

    // Budget Slider Event
    if (budgetInput) {
      budgetInput.addEventListener('input', () => {
        selectedBudget = parseFloat(budgetInput.value) || 1500;
        if (budgetDisplay) {
          budgetDisplay.textContent = selectedBudget >= 1500 ? "Semua Budget (Rp 1,5 M+)" : `Maksimal: Rp ${selectedBudget} Juta`;
        }
        currentPage = 1;
        applyFiltersAndPagination();
      });
    }

    // Budget Preset Pills
    document.querySelectorAll<HTMLButtonElement>('.budget-preset-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const maxVal = parseFloat(pill.dataset.maxBudget || "1500");
        selectedBudget = maxVal;
        if (budgetInput) budgetInput.value = String(Math.min(maxVal, 1500));
        if (budgetDisplay) {
          budgetDisplay.textContent = maxVal >= 1500 ? "Semua Budget (Rp 1,5 M+)" : `Maksimal: Rp ${maxVal} Juta`;
        }
        currentPage = 1;
        applyFiltersAndPagination();
      });
    });

    // Range Slider Event
    if (rangeSlider) {
      rangeSlider.addEventListener('input', () => {
        selectedMinRange = parseFloat(rangeSlider.value) || 0;
        if (rangeDisplay) {
          rangeDisplay.textContent = selectedMinRange <= 0 ? "Semua Jarak (≥ 0 km)" : `Minimal: ≥ ${selectedMinRange} km`;
        }
        currentPage = 1;
        applyFiltersAndPagination();
      });
    }

    // Range Preset Pills
    document.querySelectorAll<HTMLButtonElement>('.range-preset-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const minVal = parseFloat(pill.dataset.minRange || "0");
        selectedMinRange = minVal;
        if (rangeSlider) rangeSlider.value = String(minVal);
        if (rangeDisplay) {
          rangeDisplay.textContent = minVal <= 0 ? "Semua Jarak (≥ 0 km)" : `Minimal: ≥ ${minVal} km`;
        }
        currentPage = 1;
        applyFiltersAndPagination();
      });
    });

    // Sorting Selector Event
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value || "featured";
        currentPage = 1;
        applyFiltersAndPagination();
      });
    }

    // Search Input Event
    let searchDebounceTimer: any;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          searchQuery = searchInput.value.trim();
          if (clearSearchBtn) {
            if (searchQuery) clearSearchBtn.classList.remove('hidden');
            else clearSearchBtn.classList.add('hidden');
          }
          currentPage = 1;
          applyFiltersAndPagination();
        }, 120);
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        currentPage = 1;
        applyFiltersAndPagination();
      });
    }

    // Quick Pill buttons
    document.querySelectorAll<HTMLButtonElement>('.quick-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const kw = pill.dataset.keyword || '';
        if (searchInput) {
          searchInput.value = kw;
          searchQuery = kw;
          if (clearSearchBtn) clearSearchBtn.classList.remove('hidden');
          currentPage = 1;
          applyFiltersAndPagination();
        }
      });
    });

    // Reset All Filters
    function resetAllFilters() {
      selectedBody = "all";
      selectedEngine = "all";
      selectedBrand = "all";
      selectedBudget = 1500;
      selectedMinRange = 0;
      searchQuery = "";
      currentSort = "featured";
      currentPage = 1;

      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
      if (budgetInput) budgetInput.value = "1500";
      if (budgetDisplay) budgetDisplay.textContent = "Semua Budget (Rp 1,5 M+)";
      if (rangeSlider) rangeSlider.value = "0";
      if (rangeDisplay) rangeDisplay.textContent = "Semua Jarak (≥ 0 km)";
      if (sortSelect) sortSelect.value = "featured";

      updatePowertrainUI();
      updateBodyUI();
      updateBrandUI("all");
      applyFiltersAndPagination();
    }

    if (resetAllBtn) resetAllBtn.addEventListener('click', resetAllFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAllFilters);

    // ----------------------------------------------------
    // Core Filter, Sort & URL-Synchronized Pagination Engine
    // ----------------------------------------------------
    function applyFiltersAndPagination() {
      const queryTokens = searchQuery.toLowerCase().split(/\s+/).filter(Boolean);
      let matchingItems: typeof cachedCardData = [];

      for (let i = 0; i < cachedCardData.length; i++) {
        const item = cachedCardData[i];

        // 1. Powertrain Match
        const matchEngine = enginesMatch(item.engine, selectedEngine);
        if (!matchEngine) continue;

        // 2. Body Match
        const matchBody = bodiesMatch(item.body, selectedBody);
        if (!matchBody) continue;

        // 3. Brand Match
        const matchBrand = brandsMatch(item.brand, selectedBrand);
        if (!matchBrand) continue;

        // 4. Budget Match (slider max)
        const matchBudget = selectedBudget >= 1500
          ? true
          : (item.price > 0 && item.price <= selectedBudget);
        if (!matchBudget) continue;

        // 5. Min Range Match
        const matchRange = selectedMinRange <= 0
          ? true
          : (item.range >= selectedMinRange);
        if (!matchRange) continue;

        // 6. Search Match
        const matchSearch = queryTokens.length === 0 || queryTokens.every(t => {
          const normToken = norm(t);
          return item.searchableText.includes(t) || (normToken && item.searchableText.includes(normToken));
        });
        if (!matchSearch) continue;

        matchingItems.push(item);
      }

      // 7. Apply Sorting
      if (currentSort === "price_asc") {
        matchingItems.sort((a, b) => (a.price || 99999) - (b.price || 99999));
      } else if (currentSort === "price_desc") {
        matchingItems.sort((a, b) => (b.price || 0) - (a.price || 0));
      } else if (currentSort === "range_desc") {
        matchingItems.sort((a, b) => (b.range || 0) - (a.range || 0));
      } else if (currentSort === "power_desc") {
        matchingItems.sort((a, b) => (b.hp || 0) - (a.hp || 0));
      } else if (currentSort === "acc_asc") {
        matchingItems.sort((a, b) => (a.acc || 99) - (b.acc || 99));
      }

      const totalMatches = matchingItems.length;
      const totalPages = Math.max(1, Math.ceil(totalMatches / PAGE_SIZE));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Slice cards for current page with high-performance O(1) Set lookup
      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = startIndex + PAGE_SIZE;
      const visibleSet = new Set(matchingItems.slice(startIndex, endIndex).map(m => m.el));

      // Re-order DOM elements according to sorted array
      const grid = document.getElementById('car-catalog-grid');
      if (grid && currentSort !== "featured") {
        matchingItems.slice(startIndex, endIndex).forEach(item => {
          grid.appendChild(item.el);
        });
      }

      for (let i = 0; i < carCards.length; i++) {
        const card = carCards[i];
        card.style.display = visibleSet.has(card) ? "flex" : "none";
      }

      // Update counters & UI
      if (resultsCountDisplay) {
        resultsCountDisplay.textContent = `${totalMatches} Unit`;
      }
      if (paginationInfoText) {
        if (totalMatches > 0) {
          const displayStart = startIndex + 1;
          const displayEnd = Math.min(endIndex, totalMatches);
          paginationInfoText.textContent = `Menampilkan ${displayStart} - ${displayEnd} dari ${totalMatches} kendaraan`;
        } else {
          paginationInfoText.textContent = `Tidak ditemukan kendaraan yang sesuai kriteria`;
        }
      }

      // Empty state toggle
      if (noCarsFallback) {
        if (totalMatches === 0) noCarsFallback.classList.remove('hidden');
        else noCarsFallback.classList.add('hidden');
      }

      // Render Active Filter Tags
      renderActiveFilterTags();

      // Render Pagination Buttons
      renderPaginationControls(totalPages, totalMatches);

      // Synchronize URL query parameters
      syncUrlState();
    }

    function renderActiveFilterTags() {
      if (!activeFilterTagsContainer) return;
      let tagsHtml = `
        <span class="text-xs font-bold text-cyan-800 dark:text-cyan-300 flex items-center gap-1.5">
          <img src="/icons/filter.svg" alt="" class="w-3.5 h-3.5 opacity-80 dark:invert shrink-0" />
          <span>Filter Aktif:</span>
        </span>
      `;
      let hasActiveFilter = false;

      if (selectedEngine !== "all") {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="engine">
            <span>Powertrain: ${selectedEngine.toUpperCase()}</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (selectedBody !== "all") {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="body">
            <span>Bodi: ${selectedBody.toUpperCase()}</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (selectedBrand !== "all") {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="brand">
            <span>Merek: ${selectedBrand}</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (selectedBudget < 1500) {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="budget">
            <span>Maks: Rp ${selectedBudget} Jt</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (selectedMinRange > 0) {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="range">
            <span>Jarak: ≥ ${selectedMinRange} km</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (searchQuery) {
        hasActiveFilter = true;
        tagsHtml += `
          <button type="button" class="filter-dismiss-tag inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-cyan-600 text-white text-[11px] font-bold cursor-pointer" data-dismiss="search">
            <span>“${searchQuery}”</span>
            <span class="opacity-70 hover:opacity-100">✕</span>
          </button>
        `;
      }

      if (!hasActiveFilter) {
        tagsHtml += `<span class="text-slate-400 text-[11px] font-normal italic">Menampilkan seluruh data tanpa batasan filter</span>`;
      }

      activeFilterTagsContainer.innerHTML = tagsHtml;

      // Attach dismiss events
      activeFilterTagsContainer.querySelectorAll<HTMLButtonElement>('.filter-dismiss-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const dismissType = tag.dataset.dismiss;
          if (dismissType === 'engine') selectedEngine = "all";
          else if (dismissType === 'body') selectedBody = "all";
          else if (dismissType === 'brand') selectedBrand = "all";
          else if (dismissType === 'budget') {
            selectedBudget = 1500;
            if (budgetInput) budgetInput.value = "1500";
            if (budgetDisplay) budgetDisplay.textContent = "Semua Budget (Rp 1,5 M+)";
          } else if (dismissType === 'range') {
            selectedMinRange = 0;
            if (rangeSlider) rangeSlider.value = "0";
            if (rangeDisplay) rangeDisplay.textContent = "Semua Jarak (≥ 0 km)";
          } else if (dismissType === 'search') {
            searchQuery = "";
            if (searchInput) searchInput.value = "";
            if (clearSearchBtn) clearSearchBtn.classList.add('hidden');
          }

          updatePowertrainUI();
          updateBodyUI();
          updateBrandUI(selectedBrand);
          currentPage = 1;
          applyFiltersAndPagination();
        });
      });
    }

    function renderPaginationControls(totalPages: number, totalMatches: number) {
      if (!paginationButtonsWrapper || !paginationStatusCounter) return;

      paginationStatusCounter.innerHTML = `Menampilkan <strong class="text-slate-900 dark:text-white font-bold">Halaman ${currentPage}</strong> dari <strong class="text-slate-900 dark:text-white font-bold">${totalPages}</strong> <span class="text-slate-400">(${totalMatches} unit)</span>`;

      if (totalPages <= 1) {
        paginationButtonsWrapper.innerHTML = '';
        return;
      }

      // Calculate visible page items (windowing + ellipsis)
      let pages: (number | string)[] = [];
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        if (currentPage <= 4) {
          pages = [1, 2, 3, 4, 5, '...', totalPages];
        } else if (currentPage >= totalPages - 3) {
          pages = [1, '...', totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
        } else {
          pages = [1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages];
        }
      }

      let html = `
        <div class="flex items-center gap-1 bg-slate-50/90 dark:bg-slate-900/80 p-1.5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xs backdrop-blur-sm">
          <button
            type="button"
            data-page-nav="prev"
            ${currentPage === 1 ? 'disabled' : ''}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#002b49] dark:hover:text-cyan-400 hover:shadow-2xs disabled:opacity-25 disabled:pointer-events-none transition-all cursor-pointer"
          >
            <span>←</span>
            <span class="hidden sm:inline text-[11px] font-bold">Sebelumnya</span>
          </button>

          <div class="flex items-center gap-1 px-1 border-x border-slate-200/60 dark:border-slate-800">
      `;

      pages.forEach((p) => {
        if (p === '...') {
          html += `
            <span class="w-6 h-8 flex items-center justify-center text-xs font-bold text-slate-400 select-none tracking-widest">
              …
            </span>
          `;
        } else {
          const isActive = p === currentPage;
          html += `
            <button
              type="button"
              data-page-num="${p}"
              class="w-8 h-8 flex items-center justify-center rounded-xl text-xs font-bold transition-all cursor-pointer ${
                isActive
                  ? 'bg-[#002b49] dark:bg-cyan-600 text-white shadow-xs scale-105'
                  : 'text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'
              }"
            >
              ${p}
            </button>
          `;
        }
      });

      html += `
          </div>

          <button
            type="button"
            data-page-nav="next"
            ${currentPage === totalPages ? 'disabled' : ''}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-800 hover:text-[#002b49] dark:hover:text-cyan-400 hover:shadow-2xs disabled:opacity-25 disabled:pointer-events-none transition-all cursor-pointer"
          >
            <span class="hidden sm:inline text-[11px] font-bold">Berikutnya</span>
            <span>→</span>
          </button>
        </div>
      `;

      paginationButtonsWrapper.innerHTML = html;

      paginationButtonsWrapper.querySelectorAll<HTMLButtonElement>('[data-page-num]').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.dataset.pageNum || '1', 10);
          applyFiltersAndPagination();
          scrollToGrid();
        });
      });

      const prevBtn = paginationButtonsWrapper.querySelector<HTMLButtonElement>('[data-page-nav="prev"]');
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            applyFiltersAndPagination();
            scrollToGrid();
          }
        });
      }

      const nextBtn = paginationButtonsWrapper.querySelector<HTMLButtonElement>('[data-page-nav="next"]');
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            applyFiltersAndPagination();
            scrollToGrid();
          }
        });
      }
    }

    function scrollToGrid() {
      const gridHeader = document.getElementById('car-catalog-grid');
      if (gridHeader) {
        gridHeader.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function syncUrlState() {
      const newParams = new URLSearchParams();
      if (searchQuery) newParams.set("q", searchQuery);
      if (selectedBrand !== "all") newParams.set("brand", selectedBrand);
      if (selectedEngine !== "all") newParams.set("engine", selectedEngine);
      if (selectedBody !== "all") newParams.set("body", selectedBody);
      if (selectedBudget < 1500) newParams.set("budget", String(selectedBudget));
      if (selectedMinRange > 0) newParams.set("min_range", String(selectedMinRange));
      if (currentSort !== "featured") newParams.set("sort", currentSort);
      if (currentPage > 1) newParams.set("page", String(currentPage));

      const newUrl = `${window.location.pathname}${newParams.toString() ? '?' + newParams.toString() : ''}`;
      window.history.replaceState({}, '', newUrl);
    }

    // Expose Global Helper for External Brand Card Clicks
    (window as any).filterCarFinderByBrand = function(brandName: string) {
      if (brandName && brandName !== "all") {
        selectedBrand = brandName;
        updateBrandUI(brandName);
        currentPage = 1;
        applyFiltersAndPagination();
      } else {
        selectedBrand = "all";
        updateBrandUI("all");
        currentPage = 1;
        applyFiltersAndPagination();
      }
    };

    applyFiltersAndPagination();
  }

  document.addEventListener('astro:page-load', initCarFinderFilter);
</script>

