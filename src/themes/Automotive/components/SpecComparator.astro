---
// SpecComparator Component (Multi-Model Head-to-Head Comparison)
// Side-by-Side 2 or 3 Vehicle Comparison with Auto-Scoring & Winner Badges
// Integrated with Neon Postgres specs & Neon Cloud Storage Assets
// Pure Minimalist Scandinavian UI (Zero Emojis, Crisp SVG Vector Assets)
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";

interface Props {
  initialCar1?: string;
  initialCar2?: string;
  initialCar3?: string;
}

const {
  initialCar1 = "byd-seal",
  initialCar2 = "hyundai-ioniq-5",
  initialCar3 = "wuling-binguo-ev"
} = Astro.props;

// Normalizing & Flattening Vehicle Data from Neon
const ALL_CARS = ELECTRIFIED_CARS_DATA.map((c: any) => {
  const specs = c.specs || {};
  return {
    slug: c.slug,
    name: c.name,
    brand: c.brand,
    engineType: c.engineType || "bev",
    engineLabel: c.engineType === "bev" ? "100% Listrik (BEV)" : c.engineType === "phev" ? "Plug-in Hybrid (PHEV)" : "Full Hybrid (HEV)",
    price: c.price && c.price !== "0" ? c.price : "Hubungi APM",
    priceVal: c.priceVal || 0,
    image: c.img || "/images/cars/default-car.webp",
    brochureUrl: c.brochureUrl || null,
    tagline: c.tagline || "",
    // Performance & Motor
    hp: specs.horsepower || (parseInt(c.hp?.match(/\d+/)?.[0] || "0", 10)) || 0,
    hpStr: specs.horsepower ? `${specs.horsepower} HP` : (c.hp || "-"),
    torque: specs.torque_nm || (parseInt(c.torque?.match(/\d+/)?.[0] || "0", 10)) || 0,
    torqueStr: specs.torque_nm ? `${specs.torque_nm} Nm` : (c.torque || "-"),
    acc: specs.acceleration_0_100 || (parseFloat(c.acc?.replace('s','') || "0")) || 0,
    accStr: specs.acceleration_0_100 ? `${specs.acceleration_0_100} detik` : (c.acc || "-"),
    topSpeed: specs.top_speed_kmh || null,
    drivetrain: specs.drivetrain || "FWD",
    transmission: specs.transmission || "Single Speed Reduction Gear",
    // Battery & Range
    rangeKm: specs.electric_range_km || (parseInt(c.consumption?.match(/\d+/)?.[0] || "0", 10)) || 0,
    rangeStr: specs.electric_range_km ? `${specs.electric_range_km} km (${specs.range_standard || 'WLTP'})` : (c.consumption || "-"),
    batteryCapacity: specs.battery_capacity_kwh || null,
    batteryType: specs.battery_type || "Lithium Iron Phosphate (LFP)",
    chargingTime: specs.fast_charging_minutes ? `${specs.fast_charging_minutes} menit (10-80% DC)` : "30-45 menit Fast Charging",
    v2l: specs.v2l_support || "Ya (Vehicle-to-Load)",
    // Dimensions & Practicality
    dimensions: specs.length_mm && specs.width_mm && specs.height_mm ? `${specs.length_mm} × ${specs.width_mm} × ${specs.height_mm} mm` : "-",
    wheelbase: specs.wheelbase_mm || null,
    groundClearance: specs.ground_clearance_mm || null,
    seating: specs.seating_capacity || 5,
    trunkVolume: specs.trunk_volume_liters || null,
    // Safety & Warranty
    airbags: specs.airbag_count || 6,
    adas: specs.safety_adas_full || specs.adas_name || (specs.adas ? "Fitur ADAS Lengkap" : "Standar Keselamatan Pasif"),
    warrantyBattery: specs.warranty_battery || "8 Tahun / 160.000 km",
    warrantyVehicle: specs.warranty_vehicle || "5 Tahun / 150.000 km",
    annualTax: specs.annual_tax_estimate || "Rp 0 - Rp 350.000 / th (Insentif Pajak EV)",
    assembly: specs.assembly_status || "CBU"
  };
});

// Curated Comparison Presets
const PRESETS = [
  { id: "sedan-duel", title: "BYD Seal vs Ioniq 5 vs Binguo", slugs: ["byd-seal", "hyundai-ioniq-5", "wuling-binguo-ev"] },
  { id: "budget-ev", title: "City Car: Air EV vs Binguo vs Neta V", slugs: ["wuling-air-ev", "wuling-binguo-ev", "neta-v-ii"] },
  { id: "suv-battle", title: "SUV: Omoda E5 vs Atto 3 vs Kona", slugs: ["chery-omoda-e5", "byd-atto-3", "hyundai-all-new-kona-electric"] },
  { id: "hybrid-mpv", title: "Family: Innova Zenix vs Aletra L8", slugs: ["toyota-kijang-innova-zenix-hev", "aletra-l8"] }
];
---

<div class="space-y-8 spec-comparator-v2" data-all-cars={JSON.stringify(ALL_CARS)} data-presets={JSON.stringify(PRESETS)} data-defaults={JSON.stringify([initialCar1, initialCar2, initialCar3])}>
  
  <!-- HERO BANNER SECTION (Clean Minimalist Glass) -->
  <div class="rounded-3xl bg-linear-to-r from-cyan-900/40 via-slate-900 to-[#002b49] p-6 sm:p-8 border border-white/10 shadow-2xl relative overflow-hidden backdrop-blur-xl">
    <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 rounded-full bg-cyan-500/15 px-3.5 py-1 text-xs font-black tracking-wider uppercase text-cyan-400 border border-cyan-500/30">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>Matrix Perbandingan Spesifikasi Resmi</span>
        </div>
        <h1 class="font-headline text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Komparasi Mobil Listrik & Hybrid
        </h1>
        <p class="text-sm text-slate-300 max-w-2xl font-medium">
          Bandingkan 2 hingga 3 mobil secara berdampingan. Sistem otomatis menandai keunggulan terbaik (Harga, Jarak Tempuh, Akselerasi, dan Dimensi) berdasarkan database live Neon Cloud.
        </p>
      </div>

      <!-- Controls: Toggle 2 or 3 Cars + Share -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <div class="inline-flex p-1 rounded-2xl bg-slate-800/80 border border-white/10 shadow-inner">
          <button 
            type="button" 
            id="btn-mode-2" 
            class="mode-toggle-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all cursor-pointer text-slate-300 hover:text-white"
            data-mode="2"
          >
            2 Mobil
          </button>
          <button 
            type="button" 
            id="btn-mode-3" 
            class="mode-toggle-btn active px-4 py-2 rounded-xl text-xs font-extrabold transition-all cursor-pointer bg-cyan-600 text-white shadow-md shadow-cyan-600/30"
            data-mode="3"
          >
            3 Mobil
          </button>
        </div>

        <button 
          type="button" 
          id="btn-share-comp" 
          class="px-4 py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/15 text-white text-xs font-bold transition flex items-center gap-2 cursor-pointer shadow-xs"
          title="Salin tautan komparasi ini"
        >
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span>Bagikan Komparasi</span>
        </button>
      </div>
    </div>

    <!-- PRESET REKOMENDASI PILLS -->
    <div class="mt-6 pt-5 border-t border-white/10 flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold text-slate-400 mr-1 flex items-center gap-1.5">
        <img src="/icons/sparkles.svg" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
        <span>Rekomendasi:</span>
      </span>
      {PRESETS.map((preset) => (
        <button
          type="button"
          class="preset-pill px-3.5 py-1.5 rounded-full text-xs font-bold bg-white/5 hover:bg-cyan-500/20 text-slate-300 hover:text-cyan-300 border border-white/10 transition cursor-pointer"
          data-preset-id={preset.id}
        >
          {preset.title}
        </button>
      ))}
    </div>
  </div>

  <!-- VEHICLE SELECTORS BAR (STICKY RESPONSIVE) -->
  <div class="sticky top-20 z-30 rounded-3xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl p-4 sm:p-5 border border-slate-200/80 dark:border-white/10 shadow-xl transition-all">
    <div id="selector-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      
      <!-- Slot 1 -->
      <div class="space-y-1.5 relative">
        <div class="flex items-center justify-between">
          <label class="text-[11px] font-black uppercase tracking-wider text-cyan-600 dark:text-cyan-400">
            Mobil #1
          </label>
          <span class="slot-badge text-[10px] font-bold px-2 py-0.5 rounded-md bg-cyan-500/10 text-cyan-600 dark:text-cyan-300">Utama</span>
        </div>
        <select 
          id="select-car-1" 
          class="car-selector w-full px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-xs sm:text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none transition cursor-pointer"
        >
          {ALL_CARS.map(c => (
            <option value={c.slug}>{c.name} ({c.brand})</option>
          ))}
        </select>
      </div>

      <!-- Slot 2 -->
      <div class="space-y-1.5 relative">
        <div class="flex items-center justify-between">
          <label class="text-[11px] font-black uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Mobil #2
          </label>
          <button 
            type="button" 
            id="btn-swap-1-2" 
            class="text-[10px] font-bold text-slate-500 hover:text-cyan-500 flex items-center gap-1 cursor-pointer transition"
            title="Tukar urutan posisi Mobil 1 dan Mobil 2"
          >
            <img src="/icons/swap.svg" alt="" class="w-3 h-3 opacity-70 dark:invert shrink-0" />
            <span>Tukar Posisi</span>
          </button>
        </div>
        <select 
          id="select-car-2" 
          class="car-selector w-full px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-xs sm:text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none transition cursor-pointer"
        >
          {ALL_CARS.map(c => (
            <option value={c.slug}>{c.name} ({c.brand})</option>
          ))}
        </select>
      </div>

      <!-- Slot 3 -->
      <div id="slot-3-container" class="space-y-1.5 relative">
        <div class="flex items-center justify-between">
          <label class="text-[11px] font-black uppercase tracking-wider text-purple-600 dark:text-purple-400">
            Mobil #3
          </label>
          <span class="slot-badge text-[10px] font-bold px-2 py-0.5 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-300">Komparasi</span>
        </div>
        <select 
          id="select-car-3" 
          class="car-selector w-full px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-white/10 text-xs sm:text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none transition cursor-pointer"
        >
          {ALL_CARS.map(c => (
            <option value={c.slug}>{c.name} ({c.brand})</option>
          ))}
        </select>
      </div>

    </div>
  </div>

  <!-- HIGHLIGHT KEUNGGULAN BANNER (WINNER BADGES SUMMARY) -->
  <div id="winner-summary-card" class="rounded-3xl bg-linear-to-r from-emerald-500/10 via-cyan-500/10 to-transparent p-5 sm:p-6 border border-emerald-500/20 shadow-md">
    <div class="flex items-center gap-2 mb-3">
      <img src="/icons/award.svg" alt="" class="w-5 h-5 opacity-90 dark:invert shrink-0" />
      <h3 class="font-headline text-sm sm:text-base font-extrabold text-slate-900 dark:text-white tracking-tight">
        Highlight Keunggulan & Rekomendasi Teratas
      </h3>
    </div>
    <div id="winner-badges-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <!-- Injected dynamically by JS -->
    </div>
  </div>

  <!-- VEHICLE OVERVIEW HERO CARDS (PHOTO & CORE SPECS) -->
  <div id="vehicle-cards-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Card 1, 2, 3 injected dynamically -->
  </div>

  <!-- COMPLETE RELATIONAL SPECIFICATION MATRIX -->
  <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-2xl overflow-hidden">
    
    <div class="bg-slate-50 dark:bg-slate-800/60 p-6 border-b border-slate-200 dark:border-white/10 flex items-center justify-between">
      <div>
        <h2 class="font-headline text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Matrix Spesifikasi Komprehensif
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Data bersumber langsung dari Neon Cloud Database & Spesifikasi Resmi APM.
        </p>
      </div>
      <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
        <img src="/icons/star.svg" alt="" class="w-3 h-3 text-emerald-500 shrink-0" />
        <span>Highlight Hijau = Paling Unggul</span>
      </span>
    </div>

    <!-- MATRIX SECTIONS ACCORDION / TABLE -->
    <div id="matrix-table-container" class="divide-y divide-slate-100 dark:divide-white/5">
      <!-- Injected dynamically by JS -->
    </div>

  </div>
</div>

<!-- TOAST FOR SHARING / COPY LINK -->
<div id="comp-toast" class="fixed bottom-6 right-6 z-50 px-5 py-3.5 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold shadow-2xl opacity-0 pointer-events-none transition-all duration-300">
  Tautan komparasi berhasil disalin ke clipboard!
</div>

<style>
  .car-selector {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.75rem center;
    background-repeat: no-repeat;
    background-size: 1.25em 1.25em;
    padding-right: 2.5rem;
    appearance: none;
  }
  .best-cell {
    background-color: rgba(16, 185, 129, 0.08) !important;
    font-weight: 800 !important;
    position: relative;
  }
  .dark .best-cell {
    background-color: rgba(16, 185, 129, 0.15) !important;
  }
</style>

<script is:inline>
  (function() {
    const root = document.querySelector(".spec-comparator-v2");
    if (!root) return;

    const allCars = JSON.parse(root.dataset.allCars || "[]");
    const presets = JSON.parse(root.dataset.presets || "[]");
    const defaults = JSON.parse(root.dataset.defaults || "[]");

    let activeMode = 3; // 2 or 3 cars
    let selectedSlugs = [...defaults];

    // Read URL Search Params on load
    const urlParams = new URLSearchParams(window.location.search);
    const paramCars = urlParams.get("cars")?.split(",") || [
      urlParams.get("c1"),
      urlParams.get("c2"),
      urlParams.get("c3")
    ].filter(Boolean);

    if (paramCars.length >= 2) {
      selectedSlugs = paramCars.slice(0, 3);
      activeMode = selectedSlugs.length === 3 ? 3 : 2;
    }

    // Ensure valid fallback slugs
    if (!allCars.some(c => c.slug === selectedSlugs[0])) selectedSlugs[0] = allCars[0]?.slug;
    if (!allCars.some(c => c.slug === selectedSlugs[1])) selectedSlugs[1] = allCars[1]?.slug;
    if (!allCars.some(c => c.slug === selectedSlugs[2])) selectedSlugs[2] = allCars[2]?.slug;

    // Elements
    const btnMode2 = document.getElementById("btn-mode-2");
    const btnMode3 = document.getElementById("btn-mode-3");
    const slot3Container = document.getElementById("slot-3-container");
    const selectorGrid = document.getElementById("selector-grid");
    const select1 = document.getElementById("select-car-1");
    const select2 = document.getElementById("select-car-2");
    const select3 = document.getElementById("select-car-3");
    const btnSwap = document.getElementById("btn-swap-1-2");
    const btnShare = document.getElementById("btn-share-comp");

    // Format Currency Helper
    function formatJuta(val) {
      if (!val || val <= 0) return "Hubungi APM";
      return "Rp " + val.toLocaleString("id-ID") + " Jt";
    }

    // Update Mode UI
    function setMode(mode) {
      activeMode = mode;
      if (mode === 2) {
        btnMode2.classList.add("bg-cyan-600", "text-white", "shadow-md");
        btnMode2.classList.remove("text-slate-300");
        btnMode3.classList.remove("bg-cyan-600", "text-white", "shadow-md");
        btnMode3.classList.add("text-slate-300");

        slot3Container.classList.add("hidden");
        selectorGrid.classList.remove("md:grid-cols-3");
        selectorGrid.classList.add("md:grid-cols-2");
      } else {
        btnMode3.classList.add("bg-cyan-600", "text-white", "shadow-md");
        btnMode3.classList.remove("text-slate-300");
        btnMode2.classList.remove("bg-cyan-600", "text-white", "shadow-md");
        btnMode2.classList.add("text-slate-300");

        slot3Container.classList.remove("hidden");
        selectorGrid.classList.remove("md:grid-cols-2");
        selectorGrid.classList.add("md:grid-cols-3");
      }
      renderAll();
      updateUrlParams();
    }

    btnMode2.onclick = () => setMode(2);
    btnMode3.onclick = () => setMode(3);

    // Swap 1 and 2
    btnSwap.onclick = () => {
      const temp = selectedSlugs[0];
      selectedSlugs[0] = selectedSlugs[1];
      selectedSlugs[1] = temp;
      select1.value = selectedSlugs[0];
      select2.value = selectedSlugs[1];
      renderAll();
      updateUrlParams();
    };

    // Preset Buttons
    document.querySelectorAll(".preset-pill").forEach(btn => {
      btn.onclick = () => {
        const pId = btn.dataset.presetId;
        const p = presets.find(item => item.id === pId);
        if (p) {
          selectedSlugs = [...p.slugs];
          activeMode = selectedSlugs.length >= 3 ? 3 : 2;
          select1.value = selectedSlugs[0];
          select2.value = selectedSlugs[1];
          if (selectedSlugs[2]) select3.value = selectedSlugs[2];
          setMode(activeMode);
        }
      };
    });

    // Select Changes
    select1.onchange = () => { selectedSlugs[0] = select1.value; renderAll(); updateUrlParams(); };
    select2.onchange = () => { selectedSlugs[1] = select2.value; renderAll(); updateUrlParams(); };
    select3.onchange = () => { selectedSlugs[2] = select3.value; renderAll(); updateUrlParams(); };

    // Share / Copy Link
    btnShare.onclick = () => {
      const url = new URL(window.location.href);
      url.searchParams.set("cars", selectedSlugs.slice(0, activeMode).join(","));
      navigator.clipboard.writeText(url.toString()).then(() => {
        const toast = document.getElementById("comp-toast");
        toast.style.opacity = "1";
        toast.style.transform = "translateY(-4px)";
        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transform = "translateY(0)";
        }, 3000);
      });
    };

    function updateUrlParams() {
      const url = new URL(window.location.href);
      url.searchParams.set("cars", selectedSlugs.slice(0, activeMode).join(","));
      window.history.replaceState({}, "", url.toString());
    }

    // MAIN RENDER FUNCTION
    function renderAll() {
      const activeCars = selectedSlugs
        .slice(0, activeMode)
        .map(slug => allCars.find(c => c.slug === slug))
        .filter(Boolean);

      renderWinnerBadges(activeCars);
      renderVehicleCards(activeCars);
      renderMatrixTable(activeCars);
    }

    // 1. RENDER WINNER BADGES (Using Clean SVG Icons)
    function renderWinnerBadges(cars) {
      const container = document.getElementById("winner-badges-grid");
      if (!container) return;

      const validPrices = cars.filter(c => c.priceVal > 0);
      const lowestPriceCar = validPrices.length ? [...validPrices].sort((a,b) => a.priceVal - b.priceVal)[0] : null;

      const validAccs = cars.filter(c => c.acc && c.acc > 0);
      const fastestAccCar = validAccs.length ? [...validAccs].sort((a,b) => a.acc - b.acc)[0] : null;

      const validRanges = cars.filter(c => c.rangeKm && c.rangeKm > 0);
      const longestRangeCar = validRanges.length ? [...validRanges].sort((a,b) => b.rangeKm - a.rangeKm)[0] : null;

      const validHps = cars.filter(c => c.hp && c.hp > 0);
      const mostPowerCar = validHps.length ? [...validHps].sort((a,b) => b.hp - a.hp)[0] : null;

      const validTrunks = cars.filter(c => c.trunkVolume && c.trunkVolume > 0);
      const largestTrunkCar = validTrunks.length ? [...validTrunks].sort((a,b) => b.trunkVolume - a.trunkVolume)[0] : null;

      const validBatteries = cars.filter(c => c.batteryCapacity && c.batteryCapacity > 0);
      const largestBatCar = validBatteries.length ? [...validBatteries].sort((a,b) => b.batteryCapacity - a.batteryCapacity)[0] : null;

      const badges = [
        {
          icon: "/icons/wallet.svg",
          label: "Paling Terjangkau",
          winner: lowestPriceCar ? lowestPriceCar.name : "-",
          metric: lowestPriceCar ? formatJuta(lowestPriceCar.priceVal) : "-"
        },
        {
          icon: "/icons/speedometer.svg",
          label: "Akselerasi Tercepat",
          winner: fastestAccCar ? fastestAccCar.name : "-",
          metric: fastestAccCar ? `${fastestAccCar.acc} detik` : "-"
        },
        {
          icon: "/icons/route.svg",
          label: "Jarak Tempuh Terjauh",
          winner: longestRangeCar ? longestRangeCar.name : "-",
          metric: longestRangeCar ? `${longestRangeCar.rangeKm} km` : "-"
        },
        {
          icon: "/icons/gauge.svg",
          label: "Tenaga Tertinggi",
          winner: mostPowerCar ? mostPowerCar.name : "-",
          metric: mostPowerCar ? `${mostPowerCar.hp} HP` : "-"
        },
        {
          icon: "/icons/battery.svg",
          label: "Baterai Terbesar",
          winner: largestBatCar ? largestBatCar.name : "-",
          metric: largestBatCar ? `${largestBatCar.batteryCapacity} kWh` : "-"
        },
        {
          icon: "/icons/box.svg",
          label: "Bagasi Terluas",
          winner: largestTrunkCar ? largestTrunkCar.name : "-",
          metric: largestTrunkCar ? `${largestTrunkCar.trunkVolume} Liter` : "-"
        }
      ];

      container.innerHTML = badges.map(b => `
        <div class="rounded-2xl bg-white/70 dark:bg-slate-800/70 p-3 border border-slate-200/80 dark:border-white/10 shadow-xs flex flex-col justify-between">
          <div class="flex items-center gap-1.5 text-xs font-black text-slate-500 dark:text-slate-400">
            <img src="${b.icon}" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
            <span class="truncate text-[10px] uppercase tracking-wider">${b.label}</span>
          </div>
          <div class="mt-2">
            <div class="text-xs font-extrabold text-slate-900 dark:text-white truncate" title="${b.winner}">
              ${b.winner}
            </div>
            <div class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">
              ${b.metric}
            </div>
          </div>
        </div>
      `).join("");
    }

    // 2. RENDER VEHICLE OVERVIEW HERO CARDS
    function renderVehicleCards(cars) {
      const container = document.getElementById("vehicle-cards-grid");
      if (!container) return;

      container.className = `grid grid-cols-1 ${activeMode === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'} gap-6`;

      container.innerHTML = cars.map((c, i) => `
        <div class="rounded-3xl bg-white dark:bg-slate-900 p-5 sm:p-6 border border-slate-200/80 dark:border-white/10 shadow-xl space-y-4 hover:border-cyan-500/40 transition-all group">
          <div class="aspect-video rounded-2xl overflow-hidden bg-slate-950 relative border border-slate-100 dark:border-white/5">
            <img 
              src="${c.image}" 
              alt="${c.name}" 
              class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform duration-300"
              onerror="this.src='/images/brands/byd-logo.svg'" 
            />
            <span class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-slate-900/80 text-white backdrop-blur-md border border-white/20">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              <span>${c.engineLabel}</span>
            </span>
          </div>

          <div>
            <div class="text-xs font-black text-cyan-600 dark:text-cyan-400 uppercase tracking-widest">${c.brand}</div>
            <h3 class="font-headline text-lg sm:text-xl font-black text-slate-900 dark:text-white mt-0.5 leading-snug">${c.name}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">${c.tagline || 'Mobil Listrik Modern'}</p>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-white/5 flex items-center justify-between">
            <div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Harga OTR Jakarta</div>
              <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white">${c.price}</div>
            </div>
            <div class="text-right">
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">0-100 km/j</div>
              <div class="text-sm sm:text-base font-extrabold text-cyan-600 dark:text-cyan-400">${c.accStr}</div>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <a 
              href="/mobil/${c.slug}" 
              class="flex-1 text-center py-2.5 px-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition shadow-md shadow-cyan-600/20"
            >
              Lihat Detail
            </a>
            ${c.brochureUrl ? `
              <a 
                href="${c.brochureUrl}" 
                target="_blank" 
                class="px-3.5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-red-500 hover:text-white text-slate-700 dark:text-slate-300 text-xs font-bold transition flex items-center gap-1.5"
                title="Buka Brosur PDF Resmi"
              >
                <img src="/icons/file-text.svg" alt="" class="w-3.5 h-3.5 opacity-80 dark:invert shrink-0" />
                <span class="hidden sm:inline">Brosur</span>
              </a>
            ` : ''}
          </div>
        </div>
      `).join("");
    }

    // 3. RENDER MATRIX TABLE WITH AUTOMATIC BEST-IN-CLASS HIGHLIGHT
    function renderMatrixTable(cars) {
      const container = document.getElementById("matrix-table-container");
      if (!container) return;

      const numCols = activeMode;

      // Definisi Parameter Komparasi (Clean Minimalist Titles)
      const sections = [
        {
          title: "Harga, Garansi & Pajak",
          icon: "/icons/wallet.svg",
          rows: [
            {
              label: "Harga OTR Mulai",
              getValue: c => c.price,
              getScore: c => c.priceVal > 0 ? -c.priceVal : -9999999 // lower price is best
            },
            {
              label: "Estimasi Pajak Tahunan (PKB)",
              getValue: c => c.annualTax
            },
            {
              label: "Garansi Baterai",
              getValue: c => c.warrantyBattery
            },
            {
              label: "Garansi Kendaraan",
              getValue: c => c.warrantyVehicle
            },
            {
              label: "Status Perakitan",
              getValue: c => c.assembly
            },
            {
              label: "Brosur PDF Resmi (Neon)",
              getValue: c => c.brochureUrl ? `<a href="${c.brochureUrl}" target="_blank" class="inline-flex items-center gap-1.5 text-cyan-600 dark:text-cyan-400 font-bold hover:underline"><img src="/icons/file-text.svg" alt="" class="w-3.5 h-3.5 dark:invert opacity-80" /> Unduh Brosur</a>` : `<span class="text-slate-400">-</span>`
            }
          ]
        },
        {
          title: "Performa Motor & Kecepatan",
          icon: "/icons/speedometer.svg",
          rows: [
            {
              label: "Tenaga Maksimum",
              getValue: c => c.hpStr,
              getScore: c => c.hp || 0 // highest is best
            },
            {
              label: "Torsi Maksimum",
              getValue: c => c.torqueStr,
              getScore: c => c.torque || 0 // highest is best
            },
            {
              label: "Akselerasi (0-100 km/j)",
              getValue: c => c.accStr,
              getScore: c => (c.acc && c.acc > 0) ? -c.acc : -999 // lowest is best
            },
            {
              label: "Kecepatan Maksimum",
              getValue: c => c.topSpeed ? `${c.topSpeed} km/jam` : "-",
              getScore: c => c.topSpeed || 0
            },
            {
              label: "Sistem Penggerak (Drive)",
              getValue: c => c.drivetrain
            },
            {
              label: "Transmisi",
              getValue: c => c.transmission
            }
          ]
        },
        {
          title: "Baterai, Jarak Tempuh & Charging",
          icon: "/icons/battery-bolt.svg",
          rows: [
            {
              label: "Jarak Tempuh Listrik",
              getValue: c => c.rangeStr,
              getScore: c => c.rangeKm || 0 // highest is best
            },
            {
              label: "Kapasitas Baterai",
              getValue: c => c.batteryCapacity ? `${c.batteryCapacity} kWh` : "-",
              getScore: c => c.batteryCapacity || 0
            },
            {
              label: "Teknologi Tipe Baterai",
              getValue: c => c.batteryType
            },
            {
              label: "Kecepatan Pengisian Daya (DC)",
              getValue: c => c.chargingTime
            },
            {
              label: "Fitur V2L (Vehicle-to-Load)",
              getValue: c => c.v2l
            }
          ]
        },
        {
          title: "Dimensi & Kapasitas Kabin",
          icon: "/icons/dimensions.svg",
          rows: [
            {
              label: "Dimensi (P × L × T)",
              getValue: c => c.dimensions
            },
            {
              label: "Jarak Sumbu Roda (Wheelbase)",
              getValue: c => c.wheelbase ? `${c.wheelbase} mm` : "-",
              getScore: c => c.wheelbase || 0
            },
            {
              label: "Ground Clearance",
              getValue: c => c.groundClearance ? `${c.groundClearance} mm` : "-",
              getScore: c => c.groundClearance || 0
            },
            {
              label: "Kapasitas Penumpang",
              getValue: c => `${c.seating} Penumpang`
            },
            {
              label: "Volume Bagasi Belakang",
              getValue: c => c.trunkVolume ? `${c.trunkVolume} Liter` : "-",
              getScore: c => c.trunkVolume || 0
            }
          ]
        },
        {
          title: "Keselamatan & Teknologi ADAS",
          icon: "/icons/shield-check.svg",
          rows: [
            {
              label: "Jumlah Kantung Udara (Airbags)",
              getValue: c => `${c.airbags} Airbags`,
              getScore: c => c.airbags || 0
            },
            {
              label: "Sistem ADAS Cerdas",
              getValue: c => c.adas
            }
          ]
        }
      ];

      let html = "";

      sections.forEach(sec => {
        html += `
          <div class="matrix-section">
            <div class="px-6 py-3.5 bg-slate-100/70 dark:bg-slate-800/40 text-xs font-black tracking-wider uppercase text-cyan-700 dark:text-cyan-400 border-y border-slate-200/60 dark:border-white/5 flex items-center gap-2">
              <img src="${sec.icon}" alt="" class="w-3.5 h-3.5 opacity-80 dark:invert shrink-0" />
              <span>${sec.title}</span>
            </div>
            <div class="divide-y divide-slate-100 dark:divide-white/5">
        `;

        sec.rows.forEach(r => {
          // Hitung nilai terbaik jika row memiliki getScore
          let bestIdx = -1;
          if (r.getScore) {
            const scores = cars.map(c => r.getScore(c));
            const maxScore = Math.max(...scores);
            // Hanya highlight jika ada pembeda dan bukan skor default negatif
            const distinct = new Set(scores);
            if (distinct.size > 1 && maxScore > -900) {
              bestIdx = scores.indexOf(maxScore);
            }
          }

          html += `
            <div class="grid grid-cols-1 ${numCols === 2 ? 'sm:grid-cols-3' : 'sm:grid-cols-4'} py-3 px-6 hover:bg-slate-50/50 dark:hover:bg-white/5 transition text-xs sm:text-sm">
              <div class="font-bold text-slate-500 dark:text-slate-400 py-1 sm:py-0 flex items-center">
                ${r.label}
              </div>
          `;

          cars.forEach((c, idx) => {
            const val = r.getValue(c);
            const isBest = idx === bestIdx;
            html += `
              <div class="py-1 sm:py-0 px-2 flex items-center ${isBest ? 'best-cell rounded-lg text-emerald-600 dark:text-emerald-400 font-extrabold' : 'text-slate-800 dark:text-slate-200 font-semibold'}">
                <div class="truncate flex items-center gap-1.5">
                  <span>${val}</span>
                  ${isBest ? '<span class="inline-flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"><img src="/icons/star.svg" alt="" class="w-2.5 h-2.5 text-emerald-500 shrink-0" /> Unggul</span>' : ''}
                </div>
              </div>
            `;
          });

          html += `</div>`;
        });

        html += `</div></div>`;
      });

      container.innerHTML = html;
    }

    // Initial setup
    select1.value = selectedSlugs[0];
    select2.value = selectedSlugs[1];
    if (selectedSlugs[2]) select3.value = selectedSlugs[2];
    setMode(activeMode);

  })();
</script>
