---
import type { Article } from "@/types";
import { articleUrl } from "@/types";
import Picture from "./Picture.astro";
import CategoryPill from "./CategoryPill.astro";
import Badge from "./Badge.astro";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  article: Article;
  variant?: "default" | "hero" | "horizontal" | "compact";
  showDek?: boolean;
  showImage?: boolean;
  eager?: boolean;
  index?: number;
  class?: string;
}
const {
  article,
  variant = "default",
  showDek = false,
  showImage = true,
  eager = false,
  index,
  class: cls = "",
} = Astro.props;

const url = articleUrl(article);
const isSponsored = article.type === "kerjasama";
const isPremium = article.type === "premium";

const catName = article.category?.name?.toLowerCase() ?? "";
const titleLower = article.title?.toLowerCase() ?? "";
const isEV = catName.includes("ev") || catName.includes("listrik") || titleLower.includes("ev") || titleLower.includes("baterai") || titleLower.includes("ioniq") || titleLower.includes("byd");
const isTestDrive = catName.includes("ulasan") || catName.includes("test") || catName.includes("uji") || titleLower.includes("test drive") || titleLower.includes("review");

const titleSize =
  variant === "hero"
    ? "text-2xl sm:text-3xl lg:text-4xl"
    : variant === "compact"
      ? "text-sm sm:text-base font-bold"
      : "text-lg font-bold";
---

{
  variant === "horizontal" ? (
    <article class:list={["group flex gap-4 items-center rounded-2xl article-gradient-card p-4 hover:shadow-xl transition-all duration-300", cls]}>
      {showImage && (
        <a href={url} tabindex="-1" aria-hidden="true" class="shrink-0 w-32 sm:w-44 aspect-video overflow-hidden rounded-xl relative bg-slate-900">
          <Picture
            src={article.cover}
            thumbSrc={article.coverThumb}
            mobileSrc={article.coverMobile}
            alt={article.coverAlt}
            class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
            sizes="(max-width: 639px) 128px, 176px"
            loading={eager ? "eager" : "lazy"}
          />
          {isEV && <span class="absolute top-1.5 left-1.5 badge-ev px-2 py-0.5 rounded text-[10px] font-bold flex items-center gap-1"><img src="/icons/battery-bolt.svg" class="w-3 h-3 inline-block" alt="" /> EV</span>}
        </a>
      )}
      <div class="min-w-0 flex-1 space-y-1.5">
        <div class="flex items-center gap-2">
          <CategoryPill category={article.category} />
          {isEV && <span class="text-[10px] font-bold text-cyan-600 dark:text-cyan-400 flex items-center gap-1"><img src="/icons/battery-bolt.svg" class="w-3 h-3 inline-block" alt="" /> Electric</span>}
          {isSponsored && <Badge tone="sponsored">Mitra APM</Badge>}
        </div>
        <h3 class:list={["font-headline leading-snug line-clamp-2 text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors", titleSize]}>
          <a href={url}>{article.title}</a>
        </h3>
        {showDek && <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">{article.dek}</p>}
        <ArticleMeta class="mt-2 text-xs text-slate-400" date={article.publishedAt} readingTime={article.readingTime} />
      </div>
    </article>
  ) : variant === "compact" ? (
    <article class:list={["group flex gap-3.5 items-start p-3 rounded-xl hover:bg-cyan-50/40 dark:hover:bg-slate-800/40 transition", cls]}>
      {index != null && (
        <span class="font-headline text-2xl font-black text-cyan-600 dark:text-cyan-400 w-7 shrink-0 text-center tabular-nums">
          {String(index).padStart(2, "0")}
        </span>
      )}
      <div class="min-w-0 flex-1">
        <div class="mb-1 flex items-center gap-2">
          <CategoryPill category={article.category} />
          {isEV && <span class="text-[10px] font-bold text-cyan-600 dark:text-cyan-400 flex items-center gap-1"><img src="/icons/battery-bolt.svg" class="w-3 h-3 inline-block" alt="" /> EV</span>}
        </div>
        <h3 class:list={["font-headline line-clamp-2 leading-snug text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors", titleSize]}>
          <a href={url}>{article.title}</a>
        </h3>
      </div>
    </article>
  ) : (
    <article class:list={["group flex min-w-0 flex-col rounded-3xl article-gradient-card p-5 transition-all duration-300", cls]}>
      {showImage && (
        <a href={url} tabindex="-1" aria-hidden="true" class="mb-3 block overflow-hidden rounded-2xl aspect-video relative bg-slate-900">
          <Picture
            src={article.cover}
            thumbSrc={article.coverThumb}
            mobileSrc={article.coverMobile}
            alt={article.coverAlt}
            class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : "auto"}
            sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 1023px) calc((100vw - 3.5rem) / 2), 368px"
          />
          {isEV && <span class="absolute top-2.5 left-2.5 badge-ev px-2.5 py-1 rounded-full text-[10px] font-bold shadow-md flex items-center gap-1"><img src="/icons/battery-bolt.svg" class="w-3 h-3 inline-block" alt="" /> Electric EV</span>}
          {isTestDrive && <span class="absolute top-2.5 right-2.5 bg-amber-400/90 text-black font-extrabold px-2.5 py-0.5 rounded-full text-[10px] shadow">★ 8.8 Skor Tes</span>}
        </a>
      )}
      <div class="mb-2 flex items-center gap-2">
        <CategoryPill category={article.category} />
        {isPremium && <Badge tone="premium">Supercar</Badge>}
        {isSponsored && <Badge tone="sponsored">Mitra APM</Badge>}
      </div>
      <h3 class:list={["font-headline font-bold text-slate-900 dark:text-white leading-snug line-clamp-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors", titleSize]}>
        <a href={url}>{article.title}</a>
      </h3>
      {showDek && <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">{article.dek}</p>}
      <ArticleMeta class="mt-3 text-xs text-slate-400" date={article.publishedAt} readingTime={article.readingTime} />
    </article>
  )
}
