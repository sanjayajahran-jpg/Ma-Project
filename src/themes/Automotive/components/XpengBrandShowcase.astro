            </span>
            <span id="spec-wheelbase" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstSpecs.wheelbase_mm ? `${firstSpecs.wheelbase_mm} mm` : "-"}
            </span>
          </div>

          <!-- 5. Sistem Penggerak -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              Penggerak
            </span>
            <span id="spec-drivetrain" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate">
              {firstSpecs.drivetrain || "FWD"}
            </span>
          </div>

          <!-- 6. Jumlah Kursi -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              Kapasitas
            </span>
            <span id="spec-seating" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstSpecs.seating_capacity ? `${firstSpecs.seating_capacity} Kursi` : "5 Kursi"}
            </span>
          </div>

          <!-- 7. Kapasitas Bagasi -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              Bagasi (L)
            </span>
            <span id="spec-trunk" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstSpecs.trunk_volume_liters ? `${firstSpecs.trunk_volume_liters} L` : "N/A"}
            </span>
          </div>

          <!-- 8. Layar Infotainmen -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              Layar
            </span>
            <span id="spec-infotainment" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate">
              {firstSpecs.cluster_display || firstSpecs.head_unit_infotainment || "Touchscreen"}
            </span>
          </div>
        </div>

        <!-- Mini Specs Strip (Daya Pengisian, Trim & Garansi Baterai) -->
        <div class="mt-2 pt-1.5 border-t border-slate-200/70 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-x-3 gap-y-0.5 text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-1.5 truncate">
            <img src="/icons/zap.svg" alt="" class="w-3 h-3 opacity-70 dark:invert shrink-0" />
            <span>Fast Charge:</span>
            <strong id="spec-charging-speed" class="text-slate-800 dark:text-slate-200 font-semibold">{firstSpecs.charging_time_dc_quick || "AC / DC Fast Charge"}</strong>
          </div>
          <div class="flex items-center gap-1.5 truncate">
            <img src="/icons/shield-check.svg" alt="" class="w-3 h-3 opacity-70 dark:invert shrink-0" />
            <span>Garansi:</span>
            <strong id="spec-warranty-battery" class="text-slate-800 dark:text-slate-200 font-semibold">{firstSpecs.warranty_battery || "8 Thn / 160.000 km"}</strong>
