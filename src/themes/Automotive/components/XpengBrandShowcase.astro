        </div>
        <p class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
          Pilihan alternatif mobil listrik & hybrid sebanding untuk <span id="similar-reference-car" class="font-bold text-cyan-600 dark:text-cyan-400">{firstCar.name}</span>
        </p>
      </div>
      <a href="/katalog-mobil" class="text-[11px] sm:text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline flex items-center gap-0.5 shrink-0">
        <span>Semua Mobil</span>
        <span>→</span>
      </a>
    </div>

    <!-- Horizontal Swipeable Snap Carousel on Mobile / 4-Col Grid on Desktop -->
    <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3 overflow-x-auto sm:overflow-visible snap-x snap-mandatory no-scrollbar pb-2" id="similar-cars-grid">
      {initialSimilarCars.map((sc) => {
        const scLogo = BRAND_LOGOS[sc.brand.toLowerCase()] || BRAND_LOGOS[normBrand(sc.brand)] || null;
        return (
          <div class="similar-car-card group flex flex-col justify-between w-52.5 sm:w-auto shrink-0 snap-start p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 hover:border-cyan-400 hover:shadow-lg transition-all">
            <div class="space-y-1.5">
              <!-- Header Brand, Body Type & Engine Tag -->
              <div class="flex items-center justify-between text-[9px] font-bold">
                <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                  {scLogo && <img src={scLogo} alt={sc.brand} class="h-3 w-auto object-contain" />}
                  <span class="uppercase tracking-wider">{sc.brand}</span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="px-1 py-0.2 rounded text-[8px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 uppercase">
                    {(sc.bodyType || 'SUV').toUpperCase()}
                  </span>
                  <span class="px-1 py-0.2 rounded text-[8px] font-bold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800 uppercase">
                    {(sc.engineType || 'BEV').toUpperCase()}
                  </span>
                </div>
              </div>

              <!-- Car Thumbnail: Tanpa background kotak, posisikan di tengah card -->
              <a href={`/mobil/${sc.slug}`} class="w-full h-20 sm:h-28 flex items-center justify-center p-1 relative group-hover:scale-105 transition-transform">
                <img src={sc.img} alt={sc.name} class="max-h-full max-w-full object-contain drop-shadow-sm mx-auto" loading="lazy" />
              </a>

              <!-- Name & Price -->
              <div>
                <a href={`/mobil/${sc.slug}`} class="font-headline font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition line-clamp-1">
                  {sc.name}
                </a>
                <div class="text-[11px] sm:text-xs font-black text-cyan-600 dark:text-cyan-400 mt-0.5">
                  {sc.price || "Rp -"}
                </div>
              </div>

              <!-- Micro metrics -->
              <div class="grid grid-cols-2 gap-1 text-[9px] text-slate-500 dark:text-slate-400 py-0.5 border-t border-slate-100 dark:border-slate-800">
                <div class="truncate flex items-center gap-1"><img src="/icons/zap.svg" class="w-3 h-3 opacity-60 inline-block" alt="" /> {sc.hp || "-"}</div>
                <div class="text-right truncate flex items-center justify-end gap-1"><img src="/icons/battery.svg" class="w-3 h-3 opacity-60 inline-block" alt="" /> {sc.consumption || "-"}</div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="grid grid-cols-2 gap-1 pt-1.5 mt-1.5 border-t border-slate-100 dark:border-slate-800">
              <a href={`/mobil/${sc.slug}`} class="px-2 py-1 rounded-lg text-center text-[10px] font-bold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition">
                Detail
              </a>
              <a href={`/komparasi?car1=${firstCar.slug}&car2=${sc.slug}`} class="similar-compare-btn px-2 py-1 rounded-lg text-center text-[10px] font-bold bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-500/25 border border-cyan-400/30 transition flex items-center justify-center gap-1">
                <span>Bandingkan</span>
                <img src="/icons/scale.svg" class="w-3 h-3 opacity-80 inline-block" alt="" />
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Quick Brand Switcher Chips -->
    <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/80 flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <span class="text-[9px] font-bold text-slate-400 shrink-0 uppercase tracking-wider">Merek Lain:</span>
      <div class="flex items-center gap-1 flex-nowrap overflow-x-auto no-scrollbar">
        {otherBrands.slice(0, 10).map((b) => (
          <a
            href={`/katalog-mobil?brand=${encodeURIComponent(b)}`}
            class="shrink-0 px-2 py-0.5 rounded-lg border border-slate-200/80 dark:border-slate-800 text-[10px] text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 hover:border-cyan-400 transition"
          >
            {b}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- 7. MOBILE STICKY FLOATING QUICK ACTION DOCK (Solid High-Contrast Background) -->
  <div id="mobile-sticky-dock" class="sm:hidden fixed bottom-3 inset-x-3 z-50 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-white/15 p-2 px-2.5 flex items-center justify-between shadow-2xl" role="toolbar" aria-label="Aksi Cepat Mobile">
    <div class="flex items-center gap-2 overflow-hidden pr-2">
      <div class="w-9 h-7 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0 flex items-center justify-center p-0.5 border border-slate-200 dark:border-white/10">
        <img id="dock-car-img" src={firstCar.img || "/images/cars/byd-seal.png"} alt={firstCar.name || "Mobil"} class="w-full h-full object-contain filter drop-shadow-2xs" />
      </div>
      <div class="truncate">
        <span id="dock-car-name" class="font-headline font-bold text-[11px] text-slate-900 dark:text-white block truncate leading-tight">
          {firstCar.name}
        </span>
        <span id="dock-car-price" class="text-[10px] font-extrabold text-cyan-600 dark:text-cyan-400 block leading-tight">
          {firstCar.price}
        </span>
      </div>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <a 
        id="dock-compare-btn" 
        href={`/komparasi?car1=${firstCar.slug}`}
        aria-label={`Bandingkan ${firstCar.name} dengan mobil lain`}
        class="px-2.5 py-1.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden text-white font-bold text-[10px] uppercase tracking-wider transition shadow-xs"
      >
        Bandingkan
      </a>
      <a 
        id="dock-specs-btn" 
        href={`/mobil/${firstCar.slug}`}
        aria-label="Buka detail spesifikasi lengkap mobil"
        class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-[10px] font-bold focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden hover:bg-slate-200 dark:hover:bg-slate-700 transition flex items-center gap-1"
        title="Detail Spesifikasi"
      >
        <img src="/icons/file-text.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
        <span>Spek</span>
      </a>
    </div>
  </div>
</div>

<style>
  .showroom-brand-popover:not(.hidden) {
    display: flex;
  }
</style>

<script>
  function initXpengShowroom() {
    const root = document.querySelector('.xpeng-showroom-root') as HTMLElement | null;
    if (!root) return;

    let cars: any[] = [];
    try {
      cars = JSON.parse(root.dataset.cars || '[]');
    } catch (e) {}

    if (!cars || cars.length === 0) return;

    let currentIndex = parseInt(root.dataset.initialIndex || '0', 10);
    if (isNaN(currentIndex) || currentIndex < 0 || currentIndex >= cars.length) {
      currentIndex = 0;
    }

    const navTabs = document.querySelectorAll<HTMLButtonElement>('.model-nav-tab');
    const prevBtn = document.getElementById('prev-car-btn');
    const nextBtn = document.getElementById('next-car-btn');
    const carImage = document.getElementById('stage-car-image') as HTMLImageElement | null;
    const carImageWrapper = document.getElementById('car-image-wrapper');
    const carTitle = document.getElementById('stage-car-title');
    const carTagline = document.getElementById('stage-car-tagline');
    const stageCarPrice = document.getElementById('stage-car-price');

    const brand = (document.getElementById('brand-showcase-root')?.dataset?.brand || '').trim();
    function cleanModelName(fullName: string): string {
      return (fullName || '')
        .replace(new RegExp(`^${brand.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*`, 'i'), '')
        .replace(/\s*(CKD|CBU|All\s*Electric)\b/gi, '')
        .trim() || fullName;
    }

    const trimHeading = document.getElementById('trim-table-heading');
    const verticalThead = document.getElementById('vertical-trim-thead');
    const verticalTbody = document.getElementById('vertical-trim-tbody');

    const techSpecsHeading = document.getElementById('tech-specs-heading');
    const specSplitCarImg = document.getElementById('spec-split-car-img') as HTMLImageElement | null;
    const specWheelbase = document.getElementById('spec-wheelbase');
    const specDimLwh = document.getElementById('spec-dim-lwh');
    const specSeating = document.getElementById('spec-seating');
    const specAcc = document.getElementById('spec-acc');
    const specElectricRange = document.getElementById('spec-electric-range');
    const specDrivetrain = document.getElementById('spec-drivetrain');
    const specTrunk = document.getElementById('spec-trunk');
    const specInfotainment = document.getElementById('spec-infotainment');
    const specDcPower = document.getElementById('spec-dc-power');
    const specChargingSpeed = document.getElementById('spec-charging-speed');
    const specInteriorTrim = document.getElementById('spec-interior-trim');
    const specWarrantyBattery = document.getElementById('spec-warranty-battery');

    function updateShowroom(index: number, direction: 'left' | 'right' | 'none' = 'none') {
      if (index < 0) index = cars.length - 1;
      if (index >= cars.length) index = 0;
      currentIndex = index;

      const currentCar = cars[currentIndex];
      if (!currentCar) return;
      const specs = currentCar.specs || {};
      const variants = currentCar.variants || [];

      // Update Nav Tabs Active State & Accessibility attributes
      navTabs.forEach((tab, idx) => {
        if (idx === currentIndex) {
          tab.className = "model-nav-tab shrink-0 transition-all duration-200 whitespace-nowrap cursor-pointer text-xs sm:text-sm font-bold tracking-tight rounded-xl px-3 py-1.5 border focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border-cyan-400/40 shadow-xs";
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');
        } else {
          tab.className = "model-nav-tab shrink-0 transition-all duration-200 whitespace-nowrap cursor-pointer text-xs sm:text-sm font-bold tracking-tight rounded-xl px-3 py-1.5 border focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden text-slate-500 dark:text-slate-400 border-transparent hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60";
          tab.setAttribute('aria-selected', 'false');
          tab.setAttribute('tabindex', '-1');
        }
      });

      // Animate Car Image Transition
      if (carImageWrapper && carImage) {
        const carFallback = document.getElementById('stage-car-fallback');
        carImageWrapper.style.opacity = '0';
        carImageWrapper.style.transform = direction === 'right' ? 'translateX(30px) scale(0.97)' : direction === 'left' ? 'translateX(-30px) scale(0.97)' : 'scale(0.97)';

        setTimeout(() => {
          if (currentCar.img) {
            carImage.src = currentCar.img;
            carImage.alt = currentCar.name;
            carImage.classList.remove('hidden');
            if (carFallback) carFallback.classList.add('hidden');
          } else {
            carImage.classList.add('hidden');
            if (carFallback) carFallback.classList.remove('hidden');
          }
          carImageWrapper.style.opacity = '1';
          carImageWrapper.style.transform = 'translateX(0) scale(1)';
        }, 160);
      }

      // Update Stage Text, Badges & Pricing
      if (carTitle) carTitle.textContent = cleanModelName(currentCar.name);
      const stageCarBodyBadge = document.getElementById('stage-car-body-badge');
      const stageCarEngineBadge = document.getElementById('stage-car-engine-badge');
      if (stageCarBodyBadge) {
        stageCarBodyBadge.textContent = (currentCar.bodyType || currentCar.body_type?.name || currentCar.body_type || 'SUV').toUpperCase();
      }
      if (stageCarEngineBadge) {
        stageCarEngineBadge.textContent = (currentCar.engineType || currentCar.engine_type?.name || currentCar.engine_type || 'BEV').toUpperCase();
      }
      if (stageCarPrice) stageCarPrice.textContent = (currentCar.price && currentCar.price !== "0" && currentCar.price !== "Rp 0") ? currentCar.price : "Belum Tersedia";

      // Update Vertical Trim Matrix Table (No duplicate price in TH)
      if (trimHeading) trimHeading.textContent = `Perbandingan Varian & Trim ${cleanModelName(currentCar.name)}`;

      if (verticalThead && verticalTbody) {
        if (variants.length > 0) {
          verticalThead.innerHTML = `
            <tr class="border-b border-slate-200 dark:border-slate-800">
              <th class="py-3.5 px-4 font-bold text-slate-500 uppercase tracking-wider text-[11px] w-52 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10">
                Parameter Spesifikasi
              </th>
              ${variants.map((v: any, idx: number) => `
                <th class="py-3.5 px-4 font-headline font-bold text-slate-900 dark:text-white text-xs sm:text-sm min-w-[170px] border-l border-slate-100 dark:border-slate-800/60">
                  <div class="flex items-center justify-between gap-1">
                    <span>${v.name.replace(/\s*CKD\b/gi, '').trim()}</span>
                    ${idx === 0 && variants.length > 1 ? '<span class="text-[9px] bg-slate-100 dark:bg-slate-800 text-slate-500 px-2 py-0.5 rounded-full font-semibold border border-slate-200 dark:border-slate-700">Entry</span>' : ''}
                    ${idx === variants.length - 1 && variants.length > 1 ? '<span class="text-[9px] bg-cyan-500/10 dark:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 px-2 py-0.5 rounded-full font-bold border border-cyan-500/30">Top</span>' : ''}
                  </div>
                  <div class="text-xs font-extrabold text-cyan-600 dark:text-cyan-400 mt-1">${v.priceLabel || currentCar.price || '-'}</div>
                </th>
              `).join('')}
            </tr>
          `;

          verticalTbody.innerHTML = `
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
              <td class="py-3 px-4 font-semibold text-slate-500 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10 flex items-center gap-2">
                <img src="/icons/wallet.svg" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
                <span>Harga OTR Jakarta</span>
              </td>
              ${variants.map((v: any) => `<td class="py-3 px-4 font-headline font-black text-slate-900 dark:text-white text-xs sm:text-sm">${v.priceLabel || currentCar.price || '-'}</td>`).join('')}
            </tr>
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
              <td class="py-3 px-4 font-semibold text-slate-500 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10 flex items-center gap-2">
                <img src="/icons/gauge.svg" alt="" class="w-3.5 h-3.5 opacity-70 dark:invert shrink-0" />
                <span>Daya & Torsi Motor</span>
              </td>
              ${variants.map((v: any) => `<td class="py-3 px-4 font-bold text-slate-800 dark:text-slate-200">${v.power_output || currentCar.hp || '-'}</td>`).join('')}
            </tr>
            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
              <td class="py-3 px-4 font-semibold text-slate-500 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10 flex items-center gap-2">
