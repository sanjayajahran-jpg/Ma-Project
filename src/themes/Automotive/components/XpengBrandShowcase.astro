      if (specWheelbase) specWheelbase.textContent = specs.wheelbase_mm ? `${specs.wheelbase_mm} mm` : "-";
      if (specDimLwh) {
        if (specs.length_mm && specs.width_mm && specs.height_mm) {
          specDimLwh.textContent = `${specs.length_mm} × ${specs.width_mm} × ${specs.height_mm} mm`;
        } else {
          specDimLwh.textContent = "-";
        }
      }
      if (specSeating) specSeating.textContent = specs.seating_capacity ? `${specs.seating_capacity} Kursi` : "-";
      if (specAcc) specAcc.textContent = (currentCar.acc && currentCar.acc !== '-' && currentCar.acc !== '0s') ? currentCar.acc : "N/A";
      if (specElectricRange) {
        const validRange = (currentCar.consumption && currentCar.consumption !== '-' && currentCar.consumption !== '0 km' && currentCar.consumption !== 'Sesuai Standar Uji' && currentCar.consumption !== 'Belum Tersedia') ? currentCar.consumption : (specs.electric_range_km ? `${specs.electric_range_km} km` : "N/A");
        specElectricRange.textContent = validRange;
      }
      const rangeStdBadge = document.getElementById('spec-range-standard-badge');
      if (rangeStdBadge) {
        let std = specs.range_standard || '';
        const consumptionText = (currentCar.consumption || '') + ' ' + (currentCar.variants?.[0]?.battery_range || '');
        if (!std && consumptionText) {
          if (/wltp/i.test(consumptionText)) std = 'WLTP';
          else if (/cltc/i.test(consumptionText)) std = 'CLTC';
          else if (/epa/i.test(consumptionText)) std = 'EPA';
          else if (/nedc/i.test(consumptionText)) std = 'NEDC';
        }
        rangeStdBadge.textContent = std || 'WLTP';
      }
      if (specDrivetrain) specDrivetrain.textContent = specs.drivetrain || "N/A";
      if (specTrunk) {
        specTrunk.textContent = specs.trunk_volume_liters ? `${specs.trunk_volume_liters} L` : "N/A";
      }
      if (specInfotainment) {
        specInfotainment.textContent = specs.head_unit_infotainment || specs.cockpit_instrument_cluster || "Touchscreen Multimedia";
      }
      if (specDcPower) {
        specDcPower.textContent = specs.max_dc_charging_kw ? `${specs.max_dc_charging_kw} kW` : (specs.charging_time_dc_quick || "AC / DC Fast Charge");
      }
      if (specChargingSpeed) {
        specChargingSpeed.textContent = specs.charging_time_dc_quick || (specs.battery_capacity_kwh ? `Kapasitas ${specs.battery_capacity_kwh} kWh` : "Fast Charging");
