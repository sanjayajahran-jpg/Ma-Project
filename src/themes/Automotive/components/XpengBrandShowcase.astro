      if (specInteriorTrim) {
        specInteriorTrim.textContent = specs.interior_material || "Premium Interior";
      }
      if (specWarrantyBattery) {
        specWarrantyBattery.textContent = specs.warranty_battery || "8 Tahun / 160.000 km";
      }

      // Update Specs Button Link to Navigate Directly to Car Detail Page
      const specsBtn = document.getElementById('stage-view-specs-btn') as HTMLAnchorElement | null;
