---
// XPENG-Inspired Ultra-Minimalist Studio Showroom Component
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";

interface Props {
  brandName: string;
  cars: any[];
  allBrands?: string[];
  initialModelSlug?: string;
}

const { brandName, cars, allBrands = [], initialModelSlug = "" } = Astro.props;

const otherBrands = allBrands.filter(b => b && b.toLowerCase() !== brandName.toLowerCase());

function getCleanModelName(fullName: string, bName: string) {
  return (fullName || '')
    .replace(new RegExp(`^${bName}\\s*`, 'i'), '')
    .replace(/\s*CKD\b/gi, '')
    .replace(/\s*CBU\b/gi, '')
    .replace(/\s*All\s*Electric\b/gi, '')
    .trim() || fullName;
}

// Find initial car index based on initialModelSlug
const initialIndex = initialModelSlug
  ? Math.max(0, cars.findIndex((c: any) => c.slug === initialModelSlug || c.slug.toLowerCase().includes(initialModelSlug.toLowerCase())))
  : 0;

const firstCar = cars[initialIndex] || cars[0] || {};
const firstSpecs = firstCar.specs || {};
const firstVariants = firstCar.variants || [];
const firstRange: string = firstCar.consumption || (firstVariants.length ? firstVariants[firstVariants.length - 1].battery_range : '') || (firstSpecs.electric_range_km ? `${firstSpecs.electric_range_km} km` : '');
const initialRangeStandard: string = firstSpecs.range_standard || (
  /wltp/i.test(firstRange) ? 'WLTP' :
  /cltc/i.test(firstRange) ? 'CLTC' :
  /epa/i.test(firstRange) ? 'EPA' :
  /nedc/i.test(firstRange) ? 'NEDC' : 'NEDC'
);

const BRAND_LOGOS: Record<string, string> = {
  "byd": "/images/brands/byd-logo.svg",
  "bmw": "/images/brands/bmw-logo.svg",
  "chery": "/images/brands/chery-logo.svg",
  "changan": "/images/brands/changan-logo.svg",
  "baic": "/images/brands/baic-logo.svg",
  "citroen": "/images/brands/citroen-logo.svg",
  "citroën": "/images/brands/citroen-logo.svg",
  "daihatsu": "/images/brands/daihatsu-logo.svg",
  "denza": "/images/brands/denza-logo.svg",
  "dfsk": "/images/brands/dfsk-logo.svg",
  "foton": "/images/brands/foton-logo.svg",
  "gac": "/images/brands/gac-logo.svg",
  "gac aion": "/images/brands/gac-logo.svg",
  "geely": "/images/brands/geely-logo.svg",
  "gwm": "/images/brands/gwm-logo.svg",
  "honda": "/images/brands/honda-logo.svg",
  "hyundai": "/images/brands/hyundai-logo.svg",
  "icar": "/images/brands/icar-seeklogo.svg",
  "jaecoo": "/images/brands/jaecoo-logo.svg",
  "jetour": "/images/brands/jetour-logo.svg",
  "kia": "/images/brands/kia-logo.svg",
  "leapmotor": "/images/brands/leapmotor-logo.svg",
  "lepas": "/images/brands/lepas-logo.svg",
  "lexus": "/images/brands/lexus-logo.svg",
  "maxus": "/images/brands/maxus-logo.svg",
  "mazda": "/images/brands/mazda-logo.svg",
  "mercedes-benz": "/images/brands/mercedes-benz-logo.svg",
  "mg": "/images/brands/mg-logo.svg",
  "mini": "/images/brands/mini-logo.svg",
  "mitsubishi": "/images/brands/mitsubishi-logo.svg",
  "nissan": "/images/brands/nissan-logo.svg",
  "polytron": "/images/brands/polytron-logo.svg",
  "porsche": "/images/brands/porsche-logo.svg",
  "seres": "/images/brands/seres-logo.svg",
  "tesla": "/images/brands/tesla-logo.svg",
  "toyota": "/images/brands/toyota-logo.svg",
  "vinfast": "/images/brands/vinfast-logo.svg",
  "volkswagen": "/images/brands/volkswagen-logo.svg",
  "volvo": "/images/brands/volvo-logo.svg",
  "wuling": "/images/brands/wuling-logo.svg",
  "xpeng": "/images/brands/xpeng-logo.svg",
  "zeekr": "/images/brands/zeekr-logo.svg",
};

// Helper normalize brand
const normBrand = (s: string) => (s || "").toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, "");

const brandLogoUrl = BRAND_LOGOS[brandName.toLowerCase()] || BRAND_LOGOS[normBrand(brandName)] || null;

// Compute all unique brands for the interactive dropdown popover
const allBrandList = Array.from(new Set(ELECTRIFIED_CARS_DATA.map((c: any) => c.brand))).filter(Boolean).sort().map(b => {
  const bCars = ELECTRIFIED_CARS_DATA.filter((c: any) => normBrand(c.brand) === normBrand(b));
  return {
    name: b,
    count: bCars.length,
    logoUrl: BRAND_LOGOS[b.toLowerCase()] || BRAND_LOGOS[normBrand(b)] || null,
  };
});

// Rekomendasi mobil dengan harga dan kelas (body/tipe) yang mirip dari merek lain
function getSimilarCars(targetCar: any, count: number = 4) {
  if (!targetCar) return [];
  const targetBrand = normBrand(targetCar.brand);
  const targetPrice = targetCar.priceVal || 0;
  const targetBody = (targetCar.bodyType || '').toLowerCase();
  const targetEngine = (targetCar.engineType || '').toLowerCase();

  const candidates = ELECTRIFIED_CARS_DATA.filter((c: any) => {
    return normBrand(c.brand) !== targetBrand && c.priceVal > 0;
  });

  const scored = candidates.map((c: any) => {
    const pDiff = Math.abs((c.priceVal || 0) - targetPrice);
    const bodyMatch = (c.bodyType || '').toLowerCase() === targetBody;
    const engineMatch = (c.engineType || '').toLowerCase() === targetEngine;
    
    // Semakin kecil score, semakin mirip
    let score = pDiff;
    if (bodyMatch) score -= 35; // Bobot kelas bodi setara
    if (engineMatch) score -= 15; // Bobot tipe mesin setara
    
    return { car: c, score, pDiff, bodyMatch, engineMatch };
  });

  scored.sort((a, b) => a.score - b.score);
  return scored.slice(0, count).map(s => s.car);
}

const initialSimilarCars = getSimilarCars(firstCar, 4);
---

<div id="brand-showcase-root" class="xpeng-showroom-root space-y-3 sm:space-y-4 pt-0 pb-2" data-brand={brandName} data-cars={JSON.stringify(cars)} data-all-cars={JSON.stringify(ELECTRIFIED_CARS_DATA)} data-initial-index={initialIndex}>
  <!-- 1. TOP BRAND LOGO & MODEL NAV TABS (COMPACT SINGLE ROW) -->
  <div class="flex items-center justify-center gap-2 sm:gap-3 py-1 flex-wrap">
    <!-- INTERACTIVE BRAND DROPDOWN PILL & POPOVER -->
    <div class="relative inline-block shrink-0" id="showroom-brand-dropdown-wrapper">
      <button
        type="button"
        id="showroom-brand-badge-btn"
        class="flex items-center gap-2 group/brand-badge cursor-pointer px-3 py-1.5 rounded-xl border border-slate-200/80 dark:border-white/10 bg-white/80 dark:bg-slate-900/80 hover:border-cyan-500/50 hover:bg-cyan-50/50 dark:hover:bg-cyan-950/40 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden transition-all transform active:scale-95 shadow-2xs"
        title="Klik untuk melihat dan beralih ke merek mobil lainnya"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="showroom-brand-dropdown-popover"
        aria-label={`Buka menu pemilihan merek, merek saat ini ${brandName}`}
      >
        {brandLogoUrl && (
          <div class="w-5 h-5 rounded-md p-0.5 bg-white dark:bg-white border border-slate-200/60 dark:border-white/20 flex items-center justify-center shadow-2xs group-hover/brand-badge:scale-105 transition-transform">
            <img src={brandLogoUrl} alt={brandName} class="w-full h-full object-contain filter drop-shadow-2xs" />
          </div>
        )}
        <span class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
          <span>{brandName}</span>
          <span id="showroom-brand-arrow" class="text-[9px] text-cyan-500 transition-transform duration-200" aria-hidden="true">▼</span>
        </span>
      </button>

      <!-- POP-UP DROPDOWN MEREK (Liquid Glass Brand Hub Modal) -->
      <div 
        id="showroom-brand-dropdown-popover" 
        role="dialog"
        aria-modal="true"
        aria-label="Pilih Merek Mobil"
        class="showroom-brand-popover hidden absolute top-full mt-2.5 left-1/2 -translate-x-1/2 w-85 sm:w-120 md:w-140 rounded-3xl figma-liquid-glass border border-slate-200/90 dark:border-white/20 shadow-2xl p-4 sm:p-5 backdrop-blur-2xl z-50 flex-col gap-3 text-left animate-in fade-in zoom-in-95 duration-150"
      >
        <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-slate-800/80 pb-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-headline">Pilih Merek Mobil</span>
            <span class="text-[10px] font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 px-2 py-0.5 rounded-full">
              {allBrandList.length} Merek Resmi
            </span>
          </div>
          <button 
            type="button" 
            id="showroom-brand-dropdown-close" 
            class="text-slate-400 hover:text-slate-700 dark:hover:text-white text-base leading-none p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden cursor-pointer"
            title="Tutup menu merek (Esc)"
            aria-label="Tutup jendela pemilihan merek"
          >
            ✕
          </button>
        </div>

        <!-- Quick Search Input -->
        <div class="relative">
          <input 
            type="text" 
            id="showroom-brand-search-input" 
            placeholder="Cari merek (e.g. BYD, Chery, Hyundai, Wuling)..." 
            aria-label="Cari merek mobil di showroom"
            class="w-full text-xs py-2 px-3 pl-8 rounded-xl bg-slate-100/90 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-cyan-500/40"
          />
          <img src="/icons/search.svg" class="w-3.5 h-3.5 opacity-40 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" alt="" />
        </div>

        <!-- Scrollable Grid of Brands -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 max-h-70 overflow-y-auto pr-1 no-scrollbar" id="showroom-brand-grid" role="list">
          {allBrandList.map((b) => {
            const isCurrent = b.name.toLowerCase() === brandName.toLowerCase();
            return (
              <a
                href={`/katalog-mobil?brand=${encodeURIComponent(b.name)}`}
                data-brand-name={b.name.toLowerCase()}
                role="listitem"
                aria-label={`Lihat katalog mobil ${b.name}, ${b.count} model tersedia`}
                class:list={[
                  "showroom-brand-card flex items-center gap-2.5 p-2 rounded-xl border transition-all text-xs group/bcard focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden",
                  isCurrent
                    ? "bg-cyan-500/15 border-cyan-500 text-cyan-700 dark:text-cyan-300 font-bold shadow-2xs"
                    : "bg-white/60 dark:bg-slate-900/60 border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-200 hover:border-cyan-500/50 hover:bg-cyan-50/40 dark:hover:bg-cyan-950/20 font-medium"
                ]}
              >
                <div class="w-6 h-6 rounded-lg bg-white dark:bg-white border border-slate-200/60 dark:border-white/20 p-0.5 flex items-center justify-center shrink-0 group-hover/bcard:scale-110 transition-transform">
                  {b.logoUrl ? (
                    <img src={b.logoUrl} alt={b.name} class="w-full h-full object-contain filter drop-shadow-2xs" />
                  ) : (
                    <span class="text-[9px] font-bold text-slate-800">{b.name.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div class="truncate">
                  <span class="block truncate leading-tight">{b.name}</span>
                  <span class="block text-[10px] text-slate-400 leading-tight">{b.count} Model</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Vertical separator on wider screens -->
    <div class="hidden sm:block h-5 w-px bg-slate-200 dark:bg-slate-700/80" aria-hidden="true"></div>

    <!-- Horizontal Model Selector Tabs (Hidden on mobile as requested, clean navigation on desktop) -->
    <div 
      class="hidden sm:flex items-center gap-1.5 sm:gap-2 overflow-x-auto py-1 px-1 no-scrollbar scroll-smooth"
      role="tablist"
      aria-label={`Daftar model mobil ${brandName}`}
      id="model-nav-tablist"
    >
      {cars.map((car, idx) => (
        <button
          type="button"
          data-car-index={idx}
          role="tab"
          id={`model-tab-${idx}`}
          aria-selected={idx === initialIndex ? "true" : "false"}
          tabindex={idx === initialIndex ? 0 : -1}
          aria-controls="stage-car-presentation"
          aria-label={`Pilih model ${getCleanModelName(car.name, brandName)}`}
          class:list={[
            "model-nav-tab shrink-0 transition-all duration-200 whitespace-nowrap cursor-pointer text-xs sm:text-sm font-bold tracking-tight rounded-xl px-3 py-1.5 border focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden",
            idx === initialIndex
              ? "bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border-cyan-400/40 shadow-xs"
              : "text-slate-500 dark:text-slate-400 border-transparent hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60"
          ]}
        >
          {getCleanModelName(car.name, brandName)}
        </button>
      ))}
    </div>
  </div>

  <!-- 2. SEAMLESS COMPACT STUDIO SHOWCASE (Foto Mobil di Kiri + 8 Spesifikasi Vital di Kanan) -->
  <div id="stage-car-presentation" class="relative w-full max-w-6xl mx-auto my-1 sm:my-2 p-2.5 sm:p-4.5 lg:p-5 rounded-2xl sm:rounded-3xl bg-linear-to-b from-white/95 via-sky-50/30 to-cyan-50/20 dark:from-slate-900/95 dark:via-slate-900/60 dark:to-slate-950/80 border border-slate-200/90 dark:border-white/10 shadow-md sm:shadow-lg shadow-cyan-950/5 dark:shadow-black/40 backdrop-blur-md" role="region" aria-label="Tampilan Utama Model Mobil dan Spesifikasi">
    
    <!-- Model Header & OTR Pricing (Clean: Nama, Body Type, Engine Type) -->
    <div class="flex items-center justify-between gap-2 border-b border-slate-200/80 dark:border-slate-800/80 pb-1.5 mb-1.5 sm:mb-3">
      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap min-w-0">
        <h2 id="stage-car-title" class="font-headline text-sm sm:text-xl font-black text-slate-900 dark:text-white tracking-tight truncate">
          {getCleanModelName(firstCar.name, brandName)}
        </h2>
        <span id="stage-car-body-badge" class="px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 uppercase tracking-wider">
          {(firstCar.bodyType || firstCar.body_type?.name || firstCar.body_type || 'SUV').toUpperCase()}
        </span>
        <span id="stage-car-engine-badge" class="px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-bold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800 uppercase tracking-wider">
          {(firstCar.engineType || firstCar.engine_type?.name || firstCar.engine_type || 'BEV').toUpperCase()}
        </span>
      </div>
      <div class="text-right bg-white/70 dark:bg-slate-800/50 py-1 px-2 sm:px-3 rounded-lg sm:rounded-xl border border-slate-200/60 dark:border-white/5 shadow-2xs shrink-0">
        <span class="text-[8px] sm:text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Estimasi OTR</span>
        <span id="stage-car-price" class="font-headline font-black text-xs sm:text-base text-cyan-600 dark:text-cyan-400 block tracking-tight tabular-nums">
          {firstCar.price && firstCar.price !== "0" && firstCar.price !== "Rp 0" ? firstCar.price : "Belum Tersedia"}
        </span>
      </div>
    </div>

    <!-- Seamless Compact Split Grid: Left Car Photo + Right 8-Micro Specs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 sm:gap-4 lg:gap-6 items-center">
      
      <!-- Left Column: Vehicle Studio Image with Previous/Next Arrows -->
      <div class="lg:col-span-5 relative flex flex-col items-center justify-center">
        <!-- Radial Ambient Halo behind car -->
        <div class="absolute inset-0 max-w-xs mx-auto h-28 sm:h-36 bg-linear-to-r from-cyan-400/20 via-sky-300/10 to-transparent blur-2xl rounded-full pointer-events-none -z-10"></div>

        <!-- Slender Nav Arrows -->
        <button
          type="button"
          id="prev-car-btn"
          class="absolute left-0 top-1/2 -translate-y-1/2 z-20 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 dark:bg-slate-800/90 shadow-md border border-slate-200/80 dark:border-white/10 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-cyan-50 dark:hover:bg-slate-700 hover:text-cyan-600 hover:scale-105 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden transition cursor-pointer"
          aria-label="Model mobil sebelumnya"
          title="Model Sebelumnya (←)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="next-car-btn"
          class="absolute right-0 top-1/2 -translate-y-1/2 z-20 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/90 dark:bg-slate-800/90 shadow-md border border-slate-200/80 dark:border-white/10 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-cyan-50 dark:hover:bg-slate-700 hover:text-cyan-600 hover:scale-105 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-hidden transition cursor-pointer"
          aria-label="Model mobil berikutnya"
          title="Model Berikutnya (→)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Car Image Container -->
        <div id="car-image-wrapper" class="w-full aspect-16/10 max-h-28 sm:max-h-44 lg:max-h-48 flex items-center justify-center transition-all duration-300 transform relative px-6">
          <img
            id="stage-car-image"
            src={firstCar.img}
            alt={firstCar.name}
            class={`max-h-full max-w-full object-contain select-none transition-all duration-300 drop-shadow-md ${firstCar.img ? '' : 'hidden'}`}
            onerror="this.classList.add('hidden'); const fb = document.getElementById('stage-car-fallback'); if(fb) fb.classList.remove('hidden');"
          />
          <div id="stage-car-fallback" class={`flex flex-col items-center justify-center gap-1.5 text-center p-3 rounded-xl bg-slate-100/60 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/40 w-full aspect-16/10 select-none ${firstCar.img ? 'hidden' : ''}`}>
            <span class="text-[10px] text-slate-400 font-medium">Foto Belum Tersedia</span>
          </div>
        </div>

        <!-- Studio Floor Shadow Reflection -->
        <div class="w-3/4 h-1 rounded-[100%] bg-linear-to-r from-transparent via-slate-900/20 dark:via-black/60 to-transparent blur-xs -mt-0.5"></div>

        <!-- Tombol Aksi Beralih ke Halaman Detail Spesifikasi Lengkap Mobil -->
        <div class="mt-2 w-full flex items-center justify-center px-1">
          <a
            id="stage-view-specs-btn"
            href={`/mobil/${firstCar.slug}`}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-linear-to-r from-cyan-600 via-cyan-500 to-sky-500 hover:from-cyan-500 hover:to-sky-400 text-white font-headline font-bold text-[11px] sm:text-xs tracking-wide shadow-sm hover:shadow-md transition-all cursor-pointer group border border-white/20"
            aria-label="Lihat Detail Spesifikasi Lengkap"
          >
            <svg class="w-3.5 h-3.5 text-cyan-100 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span id="btn-specs-text">Lihat Detail Spesifikasi Lengkap</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: 8 Micro-Spec Cards (Super Compact & Clean) -->
      <div class="lg:col-span-7">
        <div class="grid grid-cols-2 gap-1.5 sm:gap-2.5 text-left">
          
          <!-- 1. Jarak Tempuh -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <div class="flex items-center justify-between gap-1 mb-0.5 sm:mb-1">
              <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-1 truncate">
                <img src="/icons/route.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
                <span>Jarak Tempuh</span>
              </span>
              <span id="spec-range-standard-badge" class="px-1 py-0.2 rounded text-[7px] sm:text-[8px] font-black uppercase bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                {initialRangeStandard}
              </span>
            </div>
            <span id="spec-electric-range" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstRange && firstRange !== 'Sesuai Standar Uji' && firstRange !== 'Belum Tersedia' && firstRange !== '-' ? firstRange : (firstSpecs.electric_range_km ? `${firstSpecs.electric_range_km} km` : "N/A")}
            </span>
          </div>

          <!-- 2. Akselerasi 0-100 -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              ⏱️ Akselerasi 0–100
            </span>
            <span id="spec-acc" class="font-headline font-bold text-[11px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstCar.acc && firstCar.acc !== '-' ? firstCar.acc : "N/A"}
            </span>
          </div>

          <!-- 3. Dimensi P x L x T -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
              Dimensi (P×L×T)
            </span>
            <span id="spec-dim-lwh" class="font-headline font-bold text-[10px] sm:text-sm text-slate-900 dark:text-white block truncate tabular-nums">
              {firstSpecs.length_mm && firstSpecs.width_mm && firstSpecs.height_mm ? `${firstSpecs.length_mm}×${firstSpecs.width_mm}×${firstSpecs.height_mm}` : "-"}
            </span>
          </div>

          <!-- 4. Jarak Sumbu Roda -->
          <div class="p-1.5 sm:p-2.5 rounded-lg sm:rounded-xl bg-white/85 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-2xs">
            <span class="text-[8px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block truncate mb-0.5 sm:mb-1">
