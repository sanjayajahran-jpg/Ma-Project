  <!-- 6. REKOMENDASI MOBIL KELAS & HARGA SERUPA (HORIZONTAL SWIPEABLE CAROUSEL ON MOBILE) -->
  <div id="similar-cars-section" class="max-w-6xl mx-auto space-y-3 mt-4 sm:mt-8 pt-4 sm:pt-6 border-t border-slate-200/80 dark:border-slate-800" role="region" aria-label="Rekomendasi Mobil di Kelas & Harga Serupa">
