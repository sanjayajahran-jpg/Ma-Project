      const dockCarName = document.getElementById('dock-car-name');
      const dockCarPrice = document.getElementById('dock-car-price');
      const dockCompareBtn = document.getElementById('dock-compare-btn') as HTMLAnchorElement | null;
      const dockSpecsBtn = document.getElementById('dock-specs-btn') as HTMLAnchorElement | null;

      if (dockCarImg && currentCar.img) dockCarImg.src = currentCar.img;
      if (dockCarName) dockCarName.textContent = cleanModelName(currentCar.name);
      if (dockCarPrice) dockCarPrice.textContent = (currentCar.price && currentCar.price !== "0" && currentCar.price !== "Rp 0") ? currentCar.price : "Belum Tersedia";
      if (dockCompareBtn) dockCompareBtn.href = `/komparasi?car1=${currentCar.slug || ''}`;
      if (dockSpecsBtn) dockSpecsBtn.href = `/mobil/${currentCar.slug || ''}`;

      // Update Rekomendasi Mobil Serupa Secara Dinamis
      updateSimilarCars(currentCar);
    }

    function updateSimilarCars(currentCar: any) {
      const headingRef = document.getElementById('similar-reference-car');
      if (headingRef) headingRef.textContent = currentCar.name;

      const grid = document.getElementById('similar-cars-grid');
      if (!grid) return;

      let allCars: any[] = [];
      try {
        allCars = JSON.parse(root?.dataset?.allCars || '[]');
      } catch (e) {}
      if (!allCars || allCars.length === 0) return;

      const targetBrand = (currentCar.brand || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
      const targetPrice = currentCar.priceVal || 0;
      const targetBody = (currentCar.bodyType || '').toLowerCase();
      const targetEngine = (currentCar.engineType || '').toLowerCase();

      const candidates = allCars.filter((c: any) => {
        const cb = (c.brand || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
        return cb !== targetBrand && c.priceVal > 0;
      });

      const scored = candidates.map((c: any) => {
        const pDiff = Math.abs((c.priceVal || 0) - targetPrice);
        const bodyMatch = (c.bodyType || '').toLowerCase() === targetBody;
        const engineMatch = (c.engineType || '').toLowerCase() === targetEngine;
        let score = pDiff;
        if (bodyMatch) score -= 35;
        if (engineMatch) score -= 15;
        return { car: c, score };
      });

      scored.sort((a: any, b: any) => a.score - b.score);
      const topCars = scored.slice(0, 4).map((s: any) => s.car);

      grid.innerHTML = topCars.map((sc: any) => `
        <div class="similar-car-card group flex flex-col justify-between w-[210px] sm:w-auto shrink-0 snap-start p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 hover:border-cyan-400 hover:shadow-lg transition-all">
          <div class="space-y-1.5">
            <!-- Header Brand, Body Type & Engine Tag -->
            <div class="flex items-center justify-between text-[9px] font-bold">
              <span class="text-slate-700 dark:text-slate-300 uppercase tracking-wider">${sc.brand}</span>
              <div class="flex items-center gap-1">
                <span class="px-1 py-0.2 rounded text-[8px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 uppercase">
                  ${(sc.bodyType || 'SUV').toUpperCase()}
                </span>
                <span class="px-1 py-0.2 rounded text-[8px] font-bold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800 uppercase">
                  ${(sc.engineType || 'BEV').toUpperCase()}
                </span>
              </div>
            </div>

            <!-- Car Thumbnail: Tanpa background kotak, posisikan di tengah card -->
            <a href="/mobil/${sc.slug}" class="w-full h-20 sm:h-28 flex items-center justify-center p-1 relative group-hover:scale-105 transition-transform">
              <img src="${sc.img || '/images/cars/default-car.webp'}" alt="${sc.name}" class="max-h-full max-w-full object-contain drop-shadow-sm mx-auto" loading="lazy" />
            </a>

            <!-- Name & Price -->
            <div>
              <a href="/mobil/${sc.slug}" class="font-headline font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition line-clamp-1">
                ${sc.name}
              </a>
              <div class="text-[11px] sm:text-xs font-black text-cyan-600 dark:text-cyan-400 mt-0.5">
                ${sc.price || "Rp -"}
              </div>
            </div>

            <!-- Micro metrics -->
            <div class="grid grid-cols-2 gap-1 text-[9px] text-slate-500 dark:text-slate-400 py-0.5 border-t border-slate-100 dark:border-slate-800">
              <div class="truncate flex items-center gap-1"><img src="/icons/zap.svg" class="w-3 h-3 opacity-60 inline-block" alt="" /> ${sc.hp || "-"}</div>
              <div class="text-right truncate flex items-center justify-end gap-1"><img src="/icons/battery.svg" class="w-3 h-3 opacity-60 inline-block" alt="" /> ${sc.consumption || "-"}</div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="grid grid-cols-2 gap-1 pt-1.5 mt-1.5 border-t border-slate-100 dark:border-slate-800">
            <a href="/mobil/${sc.slug}" class="px-2 py-1 rounded-lg text-center text-[10px] font-bold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition">
              Detail
            </a>
            <a href="/komparasi?car1=${currentCar.slug}&car2=${sc.slug}" class="similar-compare-btn px-2 py-1 rounded-lg text-center text-[10px] font-bold bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-500/25 border border-cyan-400/30 transition flex items-center justify-center gap-1">
              <span>Bandingkan</span>
              <img src="/icons/scale.svg" class="w-3 h-3 opacity-80 inline-block" alt="" />
            </a>
          </div>
        </div>
      `).join('');
    }

    // 2. Dynamic ADAS Feature Breakdown Matrix Handler
    const ADAS_POINTERS = [
      { id: 'acc', name: 'Adaptive Cruise Control (ACC)', icon: '/icons/speedometer.svg', keywords: ['adaptive cruise control', 'acc', 'stop & go', 'stop and go', 'pilot assist', 'icc', 'smart cruise control'] },
      { id: 'aeb', name: 'Automatic Emergency Braking (AEB)', icon: '/icons/shield-check.svg', keywords: ['autonomous emergency braking', 'automatic emergency braking', 'aeb', 'forward collision avoidance', 'fca', 'collision mitigation'] },
      { id: 'fcw', name: 'Forward Collision Warning (FCW)', icon: '/icons/shield.svg', keywords: ['forward collision warning', 'fcw', 'front collision warning'] },
      { id: 'lka', name: 'Lane Keeping Assist (LKA)', icon: '/icons/route.svg', keywords: ['lane keeping assist', 'lka', 'lane keep assist', 'lane following assist', 'lfa', 'elk'] },
      { id: 'ldw', name: 'Lane Departure Warning (LDW)', icon: '/icons/route.svg', keywords: ['lane departure warning', 'ldw'] },
      { id: 'bsd', name: 'Blind Spot Detection (BSD / BVM)', icon: '/icons/search.svg', keywords: ['blind spot detection', 'bsd', 'blind spot monitoring', 'bsm', 'bvm', 'blind spot view monitor'] },
      { id: 'rcta', name: 'Rear Cross Traffic Alert (RCTA)', icon: '/icons/swap.svg', keywords: ['rear cross traffic alert', 'rcta', 'rcta-b', 'rccw', 'rcca', 'rear cross traffic braking'] },
      { id: 'cam360', name: '360° Panoramic Surround View Camera', icon: '/icons/sparkles.svg', keywords: ['360', 'panoramic', 'surround view', 'around view monitor', 'avm', '540'] },
      { id: 'apa', name: 'Auto Parking Assist (APA)', icon: '/icons/settings.svg', keywords: ['auto parking', 'apa', 'park assist', 'remote smart parking', 'rspa', 'valet parking'] },
      { id: 'tsr', name: 'Traffic Sign Recognition (TSR / ISLA)', icon: '/icons/gauge.svg', keywords: ['traffic sign recognition', 'tsr', 'intelligent speed limit assist', 'isla', 'tsa'] },
      { id: 'hma', name: 'High Beam Assist (HMA / Auto High Beam)', icon: '/icons/zap.svg', keywords: ['high beam assist', 'hma', 'auto high beam', 'ahb', 'matrix led'] },
      { id: 'dow', name: 'Door Opening Warning (DOW / SEA)', icon: '/icons/shield.svg', keywords: ['door opening warning', 'dow', 'safe exit assist', 'sea', 'safe exit warning'] },
      { id: 'tpms', name: 'Tire Pressure Monitoring System (TPMS)', icon: '/icons/gauge.svg', keywords: ['tire pressure monitoring', 'tpms', 'tekanan ban'] },
    ];

    function updateAdasMatrix(currentCar: any) {
      const table = document.getElementById('adas-matrix-table');
      const thead = document.getElementById('adas-matrix-thead');
      const tbody = document.getElementById('adas-matrix-tbody');
      if (!table || !thead || !tbody) return;

      const variants = currentCar.variants || [];

      // If single variant or empty
      if (variants.length === 0) {
        thead.innerHTML = `
          <tr class="border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-800/20">
            <th class="py-3 px-5 font-bold text-slate-400 uppercase tracking-wider text-[11px] w-56 sticky left-0 bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm z-10">Fitur ADAS</th>
            <th class="py-3 px-4 font-bold text-slate-900 dark:text-white">Standar Fitur Resmi</th>
          </tr>
        `;
        const fullSafety = (currentCar.specs?.safety_adas_full || '').toLowerCase();
        tbody.innerHTML = ADAS_POINTERS.map(p => {
          const has = p.keywords.some(k => fullSafety.includes(k));
          return `
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition">
              <td class="py-2.5 px-5 font-medium text-slate-700 dark:text-slate-300 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10 flex items-center gap-2.5 border-r border-slate-100 dark:border-slate-800/60">
                <img src="${p.icon}" class="w-4 h-4 opacity-70 shrink-0 inline-block" alt="" /> <span class="truncate">${p.name}</span>
              </td>
              <td class="py-2.5 px-4 border-l border-slate-100 dark:border-slate-800/60">
                ${has 
                  ? '<span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/60 px-2 py-0.5 rounded-md"><svg class="w-3 h-3 text-emerald-500 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Standar</span>' 
                  : '<span class="inline-flex items-center gap-1.5 text-[11px] text-slate-400 bg-slate-100 dark:bg-slate-800/50 px-2 py-0.5 rounded-md"><span class="w-1.5 h-1.5 rounded-full bg-slate-400/50 inline-block"></span> Belum Ada</span>'}
              </td>
            </tr>
          `;
        }).join('');
        return;
      }

      // Multi-variant Thead
      thead.innerHTML = `
        <tr class="border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-800/20">
          <th class="py-3 px-5 font-bold text-slate-400 uppercase tracking-wider text-[11px] w-56 sticky left-0 bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm z-10">
            Fitur Keselamatan Aktif
          </th>
          ${variants.map((v: any, idx: number) => `
            <th class="py-3 px-4 font-bold text-slate-900 dark:text-white min-w-36 border-l border-slate-100 dark:border-slate-800/60">
              <div class="flex items-center justify-between gap-1">
                <span>${v.name.replace(/\s*CKD\b/gi, '').trim()}</span>
                ${idx === 0 && variants.length > 1 ? '<span class="text-[9px] bg-slate-100 dark:bg-slate-800 text-slate-500 px-1.5 py-0.5 rounded-full font-normal">Entry</span>' : ''}
                ${idx === variants.length - 1 && variants.length > 1 ? '<span class="text-[9px] bg-cyan-100 dark:bg-cyan-900/60 text-cyan-600 dark:text-cyan-400 px-1.5 py-0.5 rounded-full font-bold">Top</span>' : ''}
              </div>
            </th>
          `).join('')}
        </tr>
      `;

      // Multi-variant Tbody
      tbody.innerHTML = ADAS_POINTERS.map(p => {
        return `
          <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition">
            <td class="py-2.5 px-5 font-medium text-slate-700 dark:text-slate-300 sticky left-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm z-10 flex items-center gap-2.5 border-r border-slate-100 dark:border-slate-800/60">
              <img src="${p.icon}" class="w-4 h-4 opacity-70 shrink-0 inline-block" alt="" /> <span class="truncate">${p.name}</span>
            </td>
            ${variants.map((v: any) => {
              const vAdasStr = ((v.safety_adas || '') + ' ' + (currentCar.specs?.safety_adas_full || '')).toLowerCase();
              const hasFeature = p.keywords.some(k => vAdasStr.includes(k));
              return `
                <td class="py-2.5 px-4 border-l border-slate-100 dark:border-slate-800/60">
                  ${hasFeature 
                    ? '<span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/60 px-2 py-0.5 rounded-md"><svg class="w-3 h-3 text-emerald-500 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Standar</span>' 
                    : '<span class="inline-flex items-center gap-1.5 text-[11px] text-slate-400 bg-slate-100 dark:bg-slate-800/50 px-2 py-0.5 rounded-md"><span class="w-1.5 h-1.5 rounded-full bg-slate-400/50 inline-block"></span> Belum Ada</span>'}
                </td>
              `;
            }).join('')}
          </tr>
        `;
      }).join('');
    }

    // 3. Segmented Specs Category Filter Tabs
    const catBtns = document.querySelectorAll<HTMLButtonElement>('.spec-cat-btn');
    const catBlocks = document.querySelectorAll<HTMLElement>('.spec-cat-block');

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
          b.classList.add('text-slate-600', 'dark:text-slate-300');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');
        btn.setAttribute('aria-selected', 'true');

        const target = btn.dataset.catTarget;
        catBlocks.forEach(block => {
          if (target === 'all' || block.dataset.specCat === target) {
            block.style.display = 'block';
            block.style.opacity = '1';
          } else {
            block.style.display = 'none';
            block.style.opacity = '0';
          }
        });
      });
    });

    // Button click listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        updateShowroom(currentIndex - 1, 'left');
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        updateShowroom(currentIndex + 1, 'right');
      });
    }

    navTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetIdx = parseInt(tab.dataset.carIndex || '0', 10);
        const dir = targetIdx > currentIndex ? 'right' : 'left';
        updateShowroom(targetIdx, dir);
      });

      // Keyboard navigation within the tablist (Arrow keys, Home, End)
      tab.addEventListener('keydown', (e) => {
        let newIndex = currentIndex;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          newIndex = (currentIndex + 1) % cars.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          newIndex = (currentIndex - 1 + cars.length) % cars.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          newIndex = cars.length - 1;
        }

        if (newIndex !== currentIndex) {
          updateShowroom(newIndex, newIndex > currentIndex ? 'right' : 'left');
          navTabs[newIndex]?.focus();
        }
      });
    });

    // Mobile Swipe Gesture Support
    let touchStartX = 0;
    let touchEndX = 0;
    const stageEl = document.getElementById('car-image-wrapper');

    if (stageEl) {
      stageEl.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      stageEl.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 50) {
          updateShowroom(currentIndex + 1, 'right');
        } else if (touchEndX - touchStartX > 50) {
          updateShowroom(currentIndex - 1, 'left');
        }
      }, { passive: true });
    }

    // Dedicated Interactive Brand Dropdown Pop-up Handlers
    const brandBadgeBtn = document.getElementById('showroom-brand-badge-btn');
    const brandDropdownPopover = document.getElementById('showroom-brand-dropdown-popover');
    const brandDropdownClose = document.getElementById('showroom-brand-dropdown-close');
    const brandArrow = document.getElementById('showroom-brand-arrow');
    const brandSearchInput = document.getElementById('showroom-brand-search-input') as HTMLInputElement | null;
    const brandCards = document.querySelectorAll<HTMLAnchorElement>('.showroom-brand-card');

    function toggleBrandDropdown(show?: boolean) {
      if (!brandDropdownPopover) return;
      const isHidden = brandDropdownPopover.classList.contains('hidden');
      const shouldOpen = typeof show === 'boolean' ? show : isHidden;

      if (shouldOpen) {
        brandDropdownPopover.classList.remove('hidden');
        brandBadgeBtn?.setAttribute('aria-expanded', 'true');
        brandArrow?.classList.add('rotate-180');
        setTimeout(() => brandSearchInput?.focus(), 50);
      } else {
        brandDropdownPopover.classList.add('hidden');
        brandBadgeBtn?.setAttribute('aria-expanded', 'false');
        brandArrow?.classList.remove('rotate-180');
      }
    }

    if (brandBadgeBtn) {
      brandBadgeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleBrandDropdown();
      });
    }

    if (brandDropdownClose) {
      brandDropdownClose.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleBrandDropdown(false);
        brandBadgeBtn?.focus();
      });
    }

    if (brandSearchInput) {
      brandSearchInput.addEventListener('input', () => {
        const q = (brandSearchInput.value || '').trim().toLowerCase();
        brandCards.forEach(card => {
          const bname = card.dataset.brandName || '';
          if (!q || bname.includes(q)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });

      brandSearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleBrandDropdown(false);
          brandBadgeBtn?.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          const firstVisibleCard = Array.from(brandCards).find(c => c.style.display !== 'none');
          firstVisibleCard?.focus();
        }
      });
    }

    // Dismiss dropdown on outside click or Escape key
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('#showroom-brand-dropdown-wrapper')) {
        toggleBrandDropdown(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && brandDropdownPopover && !brandDropdownPopover.classList.contains('hidden')) {
        toggleBrandDropdown(false);
        brandBadgeBtn?.focus();
      }
    });

    // If initial index is non-zero, trigger initial sync
    if (currentIndex > 0) {
      updateShowroom(currentIndex, 'none');
    }
  }

  document.addEventListener('astro:page-load', initXpengShowroom);
  initXpengShowroom();
</script>
