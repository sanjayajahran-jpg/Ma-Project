---
// XPENG Minimalist Interactive EV vs ICE Fuel Savings Calculator Widget
// Integrates 6 Psychology Principles: Smart Defaults, Contrast Effect, Loss Aversion, and IKEA Effect Presets
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";
const totalModelsCount = ELECTRIFIED_CARS_DATA.length;
---

<div class="rounded-3xl apple-liquid-glass p-6 sm:p-10 space-y-8 shadow-xl">
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 dark:border-white/10 pb-6">
    <div class="space-y-1.5 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold tracking-wider uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        Simulasi Efisiensi Energi Riil
      </div>
      <h3 class="font-headline text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Kalkulator Hemat Mobil Listrik vs Bensin
      </h3>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
        Bandingkan pengeluaran riil harian, bulanan, dan tahunan antara mobil bensin konvensional vs kendaraan listrik.
      </p>
    </div>

    <!-- Loss Aversion Micro Pill -->
    <div class="flex items-center gap-2 bg-amber-50 dark:bg-amber-950/60 px-3.5 py-2 rounded-2xl border border-amber-300 dark:border-amber-700/60 shrink-0 shadow-xs">
      <img src="/icons/zap.svg" class="w-4 h-4 text-amber-600 dark:text-amber-400" alt="" />
      <div class="text-left">
        <span class="text-[10px] font-bold text-amber-700 dark:text-amber-300 uppercase tracking-wider block">Efisiensi Energi:</span>
        <span class="text-xs font-black text-amber-800 dark:text-amber-200">Hemat hingga 75-80% Biaya</span>
      </div>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1.1fr_1.1fr] items-start">
    <!-- Left Column: Controls & Presets -->
    <div class="space-y-6 bg-white dark:bg-slate-900/50 p-6 sm:p-7 rounded-3xl border border-slate-200/80 dark:border-white/10 shadow-xs">
      <!-- 1. Jarak Tempuh Harian Slider -->
      <div class="space-y-3">
        <div class="flex justify-between items-center text-xs font-semibold">
          <label for="calc-km-slider" class="text-slate-700 dark:text-slate-200">Jarak Tempuh Harian:</label>
          <div class="flex items-center gap-1.5">
            <input
              id="calc-km-input"
              type="number"
              min="5"
              max="500"
              value="45"
              class="w-16 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 px-2.5 py-1 text-right text-xs font-bold text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-cyan-500 shadow-inner"
            />
            <span class="text-slate-500 dark:text-slate-400 font-bold">km / hari</span>
          </div>
        </div>
        <input
          id="calc-km-slider"
          type="range"
          min="5"
          max="200"
          step="5"
          value="45"
          class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer"
          aria-label="Jarak tempuh harian"
        />
        <div class="flex justify-between text-[11px] text-slate-400 dark:text-slate-500 font-medium px-1">
          <span>5 km (Dalam Kota)</span>
          <span>45 km (Komuter)</span>
          <span>200 km (Antar Kota)</span>
        </div>
      </div>

      <!-- 2. Interactive IKEA Effect Quick Presets -->
      <div class="space-y-2 pt-1">
        <span class="text-[11px] font-bold uppercase text-slate-400 dark:text-slate-500 tracking-wider block">Preset Komparasi Mobil Cepat:</span>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="calc-preset-btn px-3 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-cyan-50 hover:text-cyan-700 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition" data-ice-price="15950" data-ice-eff="11" data-ev-price="1444" data-ev-eff="7.0" data-km="40">
            Avanza vs Binguo EV
          </button>
          <button type="button" class="calc-preset-btn px-3 py-1.5 rounded-xl text-[11px] font-semibold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/60 transition" data-ice-price="15950" data-ice-eff="10" data-ev-price="1444" data-ev-eff="6.5" data-km="50">
            Innova vs BYD M6 EV
          </button>
          <button type="button" class="calc-preset-btn px-3 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-cyan-50 hover:text-cyan-700 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition" data-ice-price="16250" data-ice-eff="8.5" data-ev-price="1444" data-ev-eff="5.8" data-km="60">
            Pajero/Fortuner vs Ioniq 5
          </button>
          <button type="button" class="calc-preset-btn px-3 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-cyan-50 hover:text-cyan-700 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition" data-ice-price="16250" data-ice-eff="9" data-ev-price="1444" data-ev-eff="6.2" data-km="50">
            Camry vs BYD Seal
          </button>
        </div>
      </div>

      <!-- 3. Smart Default Parameters: ICE vs EV -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2 border-t border-slate-100 dark:border-white/10">
        <!-- Mobil Bensin (ICE) -->
        <div class="rounded-2xl border border-rose-200/60 dark:border-rose-900/40 bg-rose-50/30 dark:bg-rose-950/20 p-4 space-y-3">
          <span class="text-xs font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider block border-b border-rose-200/60 dark:border-rose-900/40 pb-1.5 flex items-center gap-1.5">
            <img src="/icons/droplet.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
            <span>Mobil Bensin (ICE)</span>
          </span>

          <div>
            <label for="calc-ice-price" class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1">
              Harga BBM (Rp / Liter):
            </label>
            <input
              id="calc-ice-price"
              type="number"
              value="15950"
              step="100"
              class="w-full rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-bold text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-rose-500 shadow-inner"
            />
          </div>

          <div>
            <label for="calc-ice-eff" class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1">
              Konsumsi BBM (km / Liter):
            </label>
            <input
              id="calc-ice-eff"
              type="number"
              value="10.5"
              step="0.5"
              class="w-full rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-bold text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-rose-500 shadow-inner"
            />
          </div>
        </div>

        <!-- Mobil Listrik (EV) -->
        <div class="rounded-2xl border border-cyan-200/60 dark:border-cyan-900/40 bg-cyan-50/30 dark:bg-cyan-950/20 p-4 space-y-3">
          <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block border-b border-cyan-200/60 dark:border-cyan-900/40 pb-1.5 flex items-center gap-1.5">
            <img src="/icons/battery-bolt.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
            <span>Mobil Listrik (EV)</span>
          </span>

          <div>
            <label for="calc-ev-price" class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1">
              Tarif Listrik (Rp / kWh):
            </label>
            <input
              id="calc-ev-price"
              type="number"
              value="1444"
              step="50"
              class="w-full rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-bold text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-cyan-500 shadow-inner"
            />
          </div>

          <div>
            <label for="calc-ev-eff" class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-1">
              Efisiensi EV (km / kWh):
            </label>
            <input
              id="calc-ev-eff"
              type="number"
              value="6.5"
              step="0.1"
              class="w-full rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-bold text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-cyan-500 shadow-inner"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Contrast Effect & Loss Aversion Results -->
    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-3.5">
        <!-- Monthly ICE Cost -->
        <div class="rounded-3xl p-5 bg-white dark:bg-slate-900/50 border border-rose-200/60 dark:border-rose-900/30 shadow-xs">
          <span class="text-[11px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider block flex items-center gap-1.5">
            <img src="/icons/droplet.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
            <span>Biaya BBM / Bulan</span>
          </span>
          <span id="res-ice-monthly" class="font-headline text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1 block">
            Rp 2.050.000
          </span>
          <span id="res-ice-detail" class="text-[11px] text-slate-400 mt-1 block">
            128 Liter / bln
          </span>
        </div>

        <!-- Monthly EV Cost -->
        <div class="rounded-3xl p-5 bg-white dark:bg-slate-900/50 border border-cyan-200/60 dark:border-cyan-900/30 shadow-xs">
          <span class="text-[11px] font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block flex items-center gap-1.5">
            <img src="/icons/battery-bolt.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
            <span>Biaya Listrik / Bulan</span>
          </span>
          <span id="res-ev-monthly" class="font-headline text-2xl sm:text-3xl font-extrabold text-cyan-600 dark:text-cyan-400 mt-1 block">
            Rp 299.000
          </span>
          <span id="res-ev-detail" class="text-[11px] text-slate-400 mt-1 block">
            207 kWh / bln
          </span>
        </div>
      </div>

      <!-- Loss Aversion Main Banner (Contrast Effect in Action) -->
      <div class="rounded-3xl bg-linear-to-br from-cyan-500/10 via-emerald-500/10 to-transparent p-6 sm:p-7 border border-cyan-500/30 text-center space-y-2 shadow-sm">
        <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider block">
          Potensi Penghematan Bersih Anda
        </span>
        <div id="res-annual-savings" class="font-headline text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Rp 21.000.000 / Tahun
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 text-xs font-extrabold border border-emerald-500/30 mt-1">
          <img src="/icons/sparkles.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
          <span>Menghemat</span>
          <span id="res-percent">85%</span>
          <span>Pengeluaran BBM & Kurangi <span id="res-co2">2.8</span> Ton CO2</span>
        </div>
      </div>

      <!-- Action Button -->
      <div class="text-center pt-2">
        <a href="/katalog-mobil" class="inline-flex items-center gap-2 rounded-2xl bg-cyan-600 hover:bg-cyan-500 px-6 py-3 text-xs font-bold text-white transition shadow-md shadow-cyan-600/20">
          <span>Lihat {totalModelsCount} Model Mobil Listrik & Hybrid Siap Beli</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initFuelCalculator() {
    const slider = document.getElementById('calc-km-slider') as HTMLInputElement | null;
    const inputKm = document.getElementById('calc-km-input') as HTMLInputElement | null;
    const icePriceInput = document.getElementById('calc-ice-price') as HTMLInputElement | null;
    const iceEffInput = document.getElementById('calc-ice-eff') as HTMLInputElement | null;
    const evPriceInput = document.getElementById('calc-ev-price') as HTMLInputElement | null;
    const evEffInput = document.getElementById('calc-ev-eff') as HTMLInputElement | null;

    const resIce = document.getElementById('res-ice-monthly');
    const resIceDetail = document.getElementById('res-ice-detail');
    const resEv = document.getElementById('res-ev-monthly');
    const resEvDetail = document.getElementById('res-ev-detail');
    const resSavings = document.getElementById('res-annual-savings');
    const resPercent = document.getElementById('res-percent');
    const resCo2 = document.getElementById('res-co2');

    if (!slider || !inputKm || !icePriceInput || !iceEffInput || !evPriceInput || !evEffInput || !resIce || !resEv || !resSavings || !resPercent || !resCo2) {
      return;
    }

    const sliderEl = slider;
    const inputKmEl = inputKm;
    const icePriceInputEl = icePriceInput;
    const iceEffInputEl = iceEffInput;
    const evPriceInputEl = evPriceInput;
    const evEffInputEl = evEffInput;
    const resIceEl = resIce;
    const resEvEl = resEv;
    const resSavingsEl = resSavings;
    const resPercentEl = resPercent;
    const resCo2El = resCo2;

    function calculate() {
      const kmDay = parseFloat(inputKmEl.value) || 45;
      const icePrice = parseFloat(icePriceInputEl.value) || 15950;
      const iceEff = Math.max(0.5, parseFloat(iceEffInputEl.value) || 10.5);
      const evPrice = parseFloat(evPriceInputEl.value) || 1444;
      const evEff = Math.max(0.5, parseFloat(evEffInputEl.value) || 6.5);

      // Monthly distance (30 days)
      const monthlyKm = kmDay * 30;

      // ICE Cost
      const litersNeeded = monthlyKm / iceEff;
      const iceMonthly = litersNeeded * icePrice;

      // EV Cost
      const kwhNeeded = monthlyKm / evEff;
      const evMonthly = kwhNeeded * evPrice;

      // Savings
      const monthlySavings = iceMonthly - evMonthly;
      const annualSavings = monthlySavings * 12;
      const percentSaved = Math.round((monthlySavings / Math.max(1, iceMonthly)) * 100);

      // CO2 reduction (2.31 kg CO2 per liter gas)
      const annualLiters = litersNeeded * 12;
      const co2Tons = ((annualLiters * 2.31) / 1000).toFixed(1);

      const fmt = (num: number) => 'Rp ' + Math.round(num).toLocaleString('id-ID');

      resIceEl.textContent = fmt(iceMonthly);
      if (resIceDetail) resIceDetail.textContent = `${Math.round(litersNeeded)} Liter / bln`;

      resEvEl.textContent = fmt(evMonthly);
      if (resEvDetail) resEvDetail.textContent = `${Math.round(kwhNeeded)} kWh / bln`;

      resSavingsEl.textContent = `${fmt(annualSavings)} / Tahun`;
      resPercentEl.textContent = `${Math.max(0, percentSaved)}%`;
      resCo2El.textContent = co2Tons;
    }

    if (!sliderEl.dataset.calcAttached) {
      sliderEl.dataset.calcAttached = "true";
      sliderEl.addEventListener('input', () => {
        inputKmEl.value = sliderEl.value;
        calculate();
      });

      inputKmEl.addEventListener('input', () => {
        sliderEl.value = inputKmEl.value;
        calculate();
      });

      [icePriceInputEl, iceEffInputEl, evPriceInputEl, evEffInputEl].forEach((el) => {
        el.addEventListener('input', calculate);
      });

      // Preset button clicks
      document.querySelectorAll<HTMLButtonElement>('.calc-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.dataset.icePrice) icePriceInputEl.value = btn.dataset.icePrice;
          if (btn.dataset.iceEff) iceEffInputEl.value = btn.dataset.iceEff;
          if (btn.dataset.evPrice) evPriceInputEl.value = btn.dataset.evPrice;
          if (btn.dataset.evEff) evEffInputEl.value = btn.dataset.evEff;
          if (btn.dataset.km) {
            inputKmEl.value = btn.dataset.km;
            sliderEl.value = btn.dataset.km;
          }
          calculate();
        });
      });
    }

    calculate();
  }

  document.addEventListener('astro:page-load', initFuelCalculator);
</script>
