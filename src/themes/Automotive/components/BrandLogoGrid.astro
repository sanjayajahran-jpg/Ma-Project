---

<div class="space-y-3">
  <!-- Header Title & Slide Controls -->
  <div class="flex items-center justify-between gap-3 border-b border-slate-200/60 dark:border-white/10 pb-2.5">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[10px] font-extrabold uppercase tracking-wider mb-0.5">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        Direktori Pabrikan Resmi (A-Z)
      </div>
      <h2 class="font-headline text-base sm:text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {title}
      </h2>
    </div>

    <!-- Right Controls: View Catalog Link + Slider Arrows -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/katalog-mobil"
        class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-cyan-600 hover:text-cyan-700 dark:text-cyan-400 dark:hover:text-cyan-300 mr-2"
      >
        <span>Lihat Semua ({ELECTRIFIED_CARS_DATA.length} Unit)</span>
        <span class="text-sm">→</span>
      </a>

      <!-- Prev Button -->
      <button
        type="button"
        id="brand-slide-prev"
        aria-label="Geser ke kiri"
        class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 hover:bg-cyan-50 dark:hover:bg-cyan-950/60 text-slate-700 dark:text-white flex items-center justify-center transition shadow-xs cursor-pointer text-sm font-black"
      >
        ‹
      </button>

      <!-- Next Button -->
      <button
        type="button"
        id="brand-slide-next"
        aria-label="Geser ke kanan"
        class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white/90 dark:bg-slate-800/90 hover:bg-cyan-50 dark:hover:bg-cyan-950/60 text-slate-700 dark:text-white flex items-center justify-center transition shadow-xs cursor-pointer text-sm font-black"
      >
        ›
      </button>
    </div>
  </div>

  <!-- 2-Row Horizontal Slideable Container (Space-saving, Sleek & Smooth on Mobile) -->
  <div
    id="brand-slider-container"
    class="grid grid-rows-2 grid-flow-col auto-cols-29 sm:auto-cols-41.25 gap-2 sm:gap-2.5 overflow-x-auto scrollbar-none scroll-smooth snap-x snap-mandatory py-1 px-0.5"
    tabindex="0"
    role="region"
    aria-label="Daftar Merek Mobil Geser Horizontal (A-Z)"
  >
    {sortedBrands.map((brand) => (
      <a
        href={`/katalog-mobil?brand=${brand.name}`}
        data-brand-slug={brand.name}
        data-astro-prefetch="hover"
        class:list={[
          "brand-card snap-start group relative overflow-hidden rounded-xl p-2 sm:p-2.5 border transition-all duration-300 flex items-center gap-2 sm:gap-2.5 backdrop-blur-md hover:-translate-y-0.5 shadow-2xs shrink-0 select-none",
          activeBrand === brand.name
            ? "bg-cyan-50 dark:bg-cyan-950/60 border-cyan-400 ring-2 ring-cyan-400/50"
            : "bg-white dark:bg-slate-900/60 border-slate-200/80 dark:border-white/10 hover:border-cyan-400/60 hover:bg-slate-50 dark:hover:bg-slate-800/60"
        ]}
      >
        <!-- Brand Logo Icon (Clean Balanced Tile for Light & Dark Mode) -->
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-slate-100/90 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 flex items-center justify-center p-1 sm:p-1.5 shadow-2xs shrink-0 group-hover:scale-105 transition-transform">
          {brand.logoUrl ? (
            <img src={brand.logoUrl} alt={brand.name} class="w-5 h-5 sm:w-6 sm:h-6 object-contain filter drop-shadow-2xs dark:brightness-105" loading="lazy" />
          ) : (
            <div class="w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center text-slate-800 dark:text-slate-200">
              <Fragment set:html={brand.logoSvg} />
            </div>
          )}
        </div>

        <!-- Brand Name & Model Count -->
        <div class="overflow-hidden space-y-0.5 min-w-0">
          <h3 class="font-headline text-[11px] sm:text-sm font-extrabold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors tracking-tight truncate leading-tight">
            {brand.name}
          </h3>
          <span class="text-[9px] sm:text-[10px] font-bold text-slate-500 dark:text-slate-400 block truncate leading-tight">
            {brand.modelsCount} Model
          </span>
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  function initBrandSlider() {
    const container = document.getElementById('brand-slider-container');
    const prevBtn = document.getElementById('brand-slide-prev');
    const nextBtn = document.getElementById('brand-slide-next');

    if (container && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -320, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    const brandCards = document.querySelectorAll<HTMLAnchorElement>('.brand-card');
    brandCards.forEach(card => {
      card.addEventListener('click', (e) => {
        const brandName = card.dataset.brandSlug;
        const filterFn = (window as any).filterCarFinderByBrand;

        if (typeof filterFn === 'function' && brandName) {
          e.preventDefault();
          filterFn(brandName);

          brandCards.forEach(c => c.classList.remove('ring-2', 'ring-cyan-400/50', 'border-cyan-400', 'bg-cyan-50', 'dark:bg-cyan-950/60'));
          card.classList.add('ring-2', 'ring-cyan-400/50', 'border-cyan-400', 'bg-cyan-50', 'dark:bg-cyan-950/60');

          const catalogSection = document.getElementById('car-finder-section') || document.querySelector('.car-finder-root');
          if (catalogSection) {
            catalogSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  initBrandSlider();
  document.addEventListener('astro:page-load', initBrandSlider);
</script>
