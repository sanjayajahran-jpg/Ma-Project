// Interactive Automotive Brand Logo Grid Component for EVnesia
// Features official automotive brand logos with active model counts and direct filter links
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";

interface Props {
  title?: string;
  subtitle?: string;
  activeBrand?: string;
}

const {
  title = "Pabrikan Kendaraan Elektrifikasi",
  subtitle = "Pilih merek untuk menjelajahi seluruh lini model mobil listrik (BEV) dan hybrid (HEV/PHEV) resmi di Indonesia",
  activeBrand = ""
} = Astro.props;

// Helper normalize brand
const normBrand = (s: string) => (s || "").toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, "");

// Calculate real model counts dynamically from dataset
const getModelCount = (name: string, fallback: number = 0) => {
  const target = normBrand(name);
  const matched = ELECTRIFIED_CARS_DATA.filter((c: any) => {
    const b = normBrand(c.brand);
    return b === target || b.startsWith(target) || target.startsWith(b);
  });
  return matched.length > 0 ? matched.length : fallback;
};

