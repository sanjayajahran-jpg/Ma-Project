---
// EVnesia Simplified High-Tech SPKLU & Home Charging Simulator Component
---

<div class="rounded-3xl apple-liquid-glass p-5 sm:p-8 space-y-6 shadow-xl">
  <!-- Section Title -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200/60 dark:border-white/10 pb-4">
    <div>
      <span class="text-[11px] font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider block">
        SIMULASI PENGISIAN DAYA INDONESIA 2026
      </span>
      <h2 class="font-headline text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight mt-1">
        Kalkulator Waktu & Biaya Pengisian EV
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-normal leading-relaxed mt-1">
        Simulasi praktis durasi pengisian dan perbandingan biaya antara SPKLU cepat dengan Home Charging PLN.
      </p>
    </div>

    <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800/80 px-3.5 py-1.5 rounded-full border border-slate-200 dark:border-slate-700/80 shrink-0 text-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-slate-500 dark:text-slate-400 font-medium">Tarif SPKLU:</span>
      <span class="font-bold text-cyan-600 dark:text-cyan-400">Rp 2.466 / kWh</span>
    </div>
  </div>

  <!-- Main Grid: Left Controls (Simple) & Right Comparison Cards -->
  <div class="grid lg:grid-cols-12 gap-6 items-start">
    
    <!-- Left Column (5 Cols): Clean Controls -->
    <div class="lg:col-span-5 space-y-5 bg-white dark:bg-slate-900/60 p-5 sm:p-6 rounded-3xl border border-slate-200/80 dark:border-white/10 shadow-xs">
      
      <!-- 1. Battery Capacity Slider -->
      <div class="space-y-2.5">
        <div class="flex justify-between items-center text-xs font-semibold">
          <label for="spklu-battery-slider" class="text-slate-700 dark:text-slate-300">Kapasitas Baterai Mobil:</label>
          <span id="spklu-battery-label" class="font-headline font-bold text-sm text-cyan-600 dark:text-cyan-400 px-2.5 py-0.5 rounded-lg bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800/50 tabular-nums">
            60 kWh
          </span>
        </div>
        <input
          type="range"
          id="spklu-battery-slider"
          min="18"
          max="120"
          step="1"
          value="60"
          class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer"
        />
        <div class="flex justify-between text-[10px] text-slate-400 dark:text-slate-500 font-medium">
          <span>18 kWh (City EV)</span>
          <span>60 kWh (SUV/Sedan)</span>
          <span>120 kWh (Flagship)</span>
        </div>
      </div>

      <!-- 2. Quick Car Preset Pills -->
      <div class="space-y-1.5 pt-1">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block">Pilih Model Cepat:</span>
        <div class="grid grid-cols-2 gap-1.5">
          <button type="button" class="spklu-preset-btn px-2.5 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-cyan-400 border border-slate-200 dark:border-slate-700/80 transition text-left cursor-pointer truncate flex items-center gap-1.5" data-kwh="37.9">
            <img src="/icons/car.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
            <span>Binguo (38 kWh)</span>
          </button>
          <button type="button" class="spklu-preset-btn active-preset px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800 transition text-left cursor-pointer truncate flex items-center gap-1.5" data-kwh="61">
            <img src="/icons/suv.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
            <span>Omoda E5 (61 kWh)</span>
          </button>
          <button type="button" class="spklu-preset-btn px-2.5 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-cyan-400 border border-slate-200 dark:border-slate-700/80 transition text-left cursor-pointer truncate flex items-center gap-1.5" data-kwh="77.4">
            <img src="/icons/suv.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
            <span>Ioniq 5 (77 kWh)</span>
          </button>
          <button type="button" class="spklu-preset-btn px-2.5 py-1.5 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-cyan-400 border border-slate-200 dark:border-slate-700/80 transition text-left cursor-pointer truncate flex items-center gap-1.5" data-kwh="82.5">
            <img src="/icons/sedan.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
            <span>BYD Seal (82 kWh)</span>
          </button>
        </div>
      </div>

      <!-- 3. Simple Scenario Selector (Toggle between Daily 20->80% vs Road Trip 10->100%) -->
      <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-white/10">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block">Skenario Pengisian:</span>
        <div class="grid grid-cols-2 gap-2" id="charging-scenario-group">
          <button
            type="button"
            id="scenario-daily-btn"
            data-active="true"
            data-start="20"
            data-target="80"
            class="scenario-btn p-2.5 rounded-2xl border text-left transition cursor-pointer bg-cyan-50 dark:bg-cyan-950/60 border-cyan-400 dark:border-cyan-600 text-cyan-800 dark:text-cyan-200 shadow-xs"
          >
            <span class="text-xs font-bold block flex items-center gap-1">
              <img src="/icons/battery-bolt.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
              <span>Harian (20% → 80%)</span>
            </span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block mt-0.5">Rekomendasi awet baterai</span>
          </button>

          <button
            type="button"
            id="scenario-trip-btn"
            data-active="false"
            data-start="10"
            data-target="100"
            class="scenario-btn p-2.5 rounded-2xl border text-left transition cursor-pointer bg-slate-50 dark:bg-slate-800/50 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300"
          >
            <span class="text-xs font-bold block flex items-center gap-1">
              <img src="/icons/route.svg" class="w-3.5 h-3.5 opacity-70 inline-block" alt="" />
              <span>Trip Jauh (10% → 100%)</span>
            </span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block mt-0.5">Jarak tempuh maksimal</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Right Column (7 Cols): Sleek, Simple 2-Card Comparative Dashboard -->
    <div class="lg:col-span-7 space-y-4">
      
      <!-- Energy & Range Summary Pill -->
      <div class="flex items-center justify-between px-5 py-3 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-slate-900 dark:text-white">
        <div class="flex items-center gap-2 text-xs font-semibold">
          <span class="text-cyan-600 dark:text-cyan-400 font-bold">Daya Ditambahkan:</span>
          <span id="spklu-kwh-added" class="font-headline font-bold text-sm text-cyan-700 dark:text-cyan-300 tabular-nums">36.0 kWh</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-semibold">
          <span class="text-slate-500 dark:text-slate-400">Tambahan Jarak:</span>
          <span id="spklu-range-gain" class="font-headline font-extrabold text-sm sm:text-base text-cyan-600 dark:text-cyan-400 tabular-nums">+223 KM</span>
        </div>
      </div>

      <!-- 2 Clean Side-by-Side Comparison Cards -->
      <div class="grid sm:grid-cols-2 gap-4">
        
        <!-- CARD 1: SPKLU Fast Charging Publik -->
        <div class="rounded-3xl p-5 bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-white/10 pb-2.5">
            <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 flex items-center gap-1.5">
              <img src="/icons/battery-bolt.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
              <span>SPKLU Cepat (Publik)</span>
            </span>
            <span class="text-[10px] font-semibold text-slate-400 uppercase">Tol & Mall</span>
          </div>

          <!-- Durations List -->
          <div class="space-y-2">
            <div class="flex justify-between items-baseline">
              <span class="text-xs text-slate-500 dark:text-slate-400">Ultra-Fast Tol (150 kW):</span>
              <span id="spklu-dur-ultrafast" class="font-headline font-bold text-base text-slate-900 dark:text-white tabular-nums">14 Menit</span>
            </div>
            <div class="flex justify-between items-baseline">
              <span class="text-xs text-slate-500 dark:text-slate-400">Fast DC Mall (50 kW):</span>
              <span id="spklu-dur-fast" class="font-headline font-bold text-sm text-slate-700 dark:text-slate-300 tabular-nums">43 Menit</span>
            </div>
          </div>

          <!-- Cost Bar -->
          <div class="border-t border-slate-100 dark:border-white/10 pt-3 flex justify-between items-baseline">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Est. Total Biaya:</span>
            <span id="spklu-cost-display" class="font-headline font-extrabold text-lg text-cyan-600 dark:text-cyan-400 tabular-nums">
              Rp 89.000
            </span>
          </div>
        </div>

        <!-- CARD 2: Home Charging PLN Malam -->
        <div class="rounded-3xl p-5 bg-white dark:bg-slate-900/60 border border-emerald-300/60 dark:border-emerald-700/60 shadow-xs space-y-4 relative overflow-hidden">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-white/10 pb-2.5">
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
              <img src="/icons/plug.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
              <span>Cas Rumah (PLN Malam)</span>
            </span>
            <span class="text-[10px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950/80 px-2 py-0.5 rounded-full">
              Diskon 30%
            </span>
          </div>

          <!-- Duration -->
          <div class="space-y-2">
            <div class="flex justify-between items-baseline">
              <span class="text-xs text-slate-500 dark:text-slate-400">Wallbox AC Rumah (7.4 kW):</span>
              <span id="spklu-dur-home" class="font-headline font-bold text-base text-slate-900 dark:text-white tabular-nums">4.9 Jam</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-snug">
              Otomatis selesai ditinggal tidur semalaman (Jam 22.00 - 05.00).
            </p>
          </div>

          <!-- Cost Bar & Savings -->
          <div class="border-t border-slate-100 dark:border-white/10 pt-3 flex justify-between items-baseline">
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Est. Biaya Rumah:</span>
            <span id="home-cost-display" class="font-headline font-extrabold text-lg text-emerald-600 dark:text-emerald-400 tabular-nums">
              Rp 43.000
            </span>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  function initSpkluCalculator() {
    const slider = document.getElementById('spklu-battery-slider') as HTMLInputElement | null;
    const label = document.getElementById('spklu-battery-label');
    const kwhAdded = document.getElementById('spklu-kwh-added');
    const rangeGain = document.getElementById('spklu-range-gain');
    const durUltra = document.getElementById('spklu-dur-ultrafast');
    const durFast = document.getElementById('spklu-dur-fast');
    const durHome = document.getElementById('spklu-dur-home');
    const spkluCostDisplay = document.getElementById('spklu-cost-display');
    const homeCostDisplay = document.getElementById('home-cost-display');

    const scenarioDailyBtn = document.getElementById('scenario-daily-btn') as HTMLButtonElement | null;
    const scenarioTripBtn = document.getElementById('scenario-trip-btn') as HTMLButtonElement | null;

    if (!slider) return;

    let currentStart = 20;
    let currentTarget = 80;

    function formatRupiah(num: number) {
      const rounded = Math.round(num / 1000) * 1000;
      return `Rp ${rounded.toLocaleString('id-ID')}`;
    }

    function calculate() {
      if (!slider) return;
      const batteryKwh = parseFloat(slider.value);
      const deltaPercent = Math.max(5, currentTarget - currentStart);
      const neededKwh = (batteryKwh * deltaPercent) / 100;

      // Durations
      const minUltra = Math.max(10, Math.round((neededKwh / 150) * 60));
      const minFast = Math.max(20, Math.round((neededKwh / 50) * 60));
      const hoursHome = (neededKwh / 7.4).toFixed(1);

      // Costs (rounded cleanly to nearest thousand)
      const spkluCost = neededKwh * 2466;
      const homeCost = neededKwh * 1187; // 30% discount night rate

      // Range gain (assume 6.2 km/kWh avg)
      const range = Math.round(neededKwh * 6.2);

      if (label) label.textContent = `${batteryKwh} kWh`;
      if (kwhAdded) kwhAdded.textContent = `${neededKwh.toFixed(1)} kWh`;
      if (rangeGain) rangeGain.textContent = `+${range} KM`;
      if (durUltra) durUltra.textContent = `${minUltra} Menit`;
      if (durFast) durFast.textContent = `${minFast} Menit`;
      if (durHome) durHome.textContent = `${hoursHome} Jam`;
      if (spkluCostDisplay) spkluCostDisplay.textContent = formatRupiah(spkluCost);
      if (homeCostDisplay) homeCostDisplay.textContent = formatRupiah(homeCost);
    }

    // Toggle Scenario handler
    function setScenario(isDaily: boolean) {
      if (isDaily) {
        currentStart = 20;
        currentTarget = 80;
        scenarioDailyBtn?.classList.add('bg-cyan-50', 'dark:bg-cyan-950/60', 'border-cyan-400', 'dark:border-cyan-600', 'text-cyan-800', 'dark:text-cyan-200');
        scenarioDailyBtn?.classList.remove('bg-slate-50', 'dark:bg-slate-800/50', 'border-slate-200', 'dark:border-slate-700', 'text-slate-700', 'dark:text-slate-300');
        
        scenarioTripBtn?.classList.add('bg-slate-50', 'dark:bg-slate-800/50', 'border-slate-200', 'dark:border-slate-700', 'text-slate-700', 'dark:text-slate-300');
        scenarioTripBtn?.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/60', 'border-cyan-400', 'dark:border-cyan-600', 'text-cyan-800', 'dark:text-cyan-200');
      } else {
        currentStart = 10;
        currentTarget = 100;
        scenarioTripBtn?.classList.add('bg-cyan-50', 'dark:bg-cyan-950/60', 'border-cyan-400', 'dark:border-cyan-600', 'text-cyan-800', 'dark:text-cyan-200');
        scenarioTripBtn?.classList.remove('bg-slate-50', 'dark:bg-slate-800/50', 'border-slate-200', 'dark:border-slate-700', 'text-slate-700', 'dark:text-slate-300');
        
        scenarioDailyBtn?.classList.add('bg-slate-50', 'dark:bg-slate-800/50', 'border-slate-200', 'dark:border-slate-700', 'text-slate-700', 'dark:text-slate-300');
        scenarioDailyBtn?.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/60', 'border-cyan-400', 'dark:border-cyan-600', 'text-cyan-800', 'dark:text-cyan-200');
      }
      calculate();
    }

    if (!slider.dataset.calcAttached) {
      slider.dataset.calcAttached = "true";
      slider.addEventListener('input', calculate);

      scenarioDailyBtn?.addEventListener('click', () => setScenario(true));
      scenarioTripBtn?.addEventListener('click', () => setScenario(false));

      // Preset buttons
      document.querySelectorAll<HTMLButtonElement>('.spklu-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const kwh = btn.dataset.kwh;
          if (kwh && slider) {
            slider.value = kwh;
            document.querySelectorAll('.spklu-preset-btn').forEach(b => {
              b.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/60', 'text-cyan-700', 'dark:text-cyan-300', 'border-cyan-300', 'dark:border-cyan-800', 'font-bold');
              b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
            });
            btn.classList.add('bg-cyan-50', 'dark:bg-cyan-950/60', 'text-cyan-700', 'dark:text-cyan-300', 'border-cyan-300', 'dark:border-cyan-800', 'font-bold');
            btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
            calculate();
          }
        });
      });
    }

    calculate();
  }

  document.addEventListener('astro:page-load', initSpkluCalculator);
  initSpkluCalculator();
</script>
