    modelsCount: modelCounts[normBrand("Lepas")] || 2,
  },
  {
    name: "Lexus",
    slug: "lexus",
    modelsCount: modelCounts[normBrand("Lexus")] || 12,
  },
  {
    name: "Maxus",
    slug: "maxus",
    modelsCount: modelCounts[normBrand("Maxus")] || 2,
  },
  {
