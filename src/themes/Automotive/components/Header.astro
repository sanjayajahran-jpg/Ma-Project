    slug: "dfsk",
    modelsCount: modelCounts[normBrand("DFSK")] || 1,
  },
  {
    name: "Foton",
    slug: "foton",
    modelsCount: modelCounts[normBrand("Foton")] || 2,
  },
  {
    name: "GAC Aion",
