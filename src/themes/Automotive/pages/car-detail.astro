        ))}
      </div>
    </section>

    <!-- Buyers Guide Section -->
    <section class="reveal-on-scroll pt-3">
      <CatalogGuideSection />
    </section>

    <!-- Ad slot banner -->
    <section class="reveal-on-scroll">
      <AdSlot
        format="leaderboard"
        title="Slot Iklan Peluncuran EV & Ekosistem SPKLU"
