---
const { request, params } = Astro.props as any;
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogGuideSection from "../components/CatalogGuideSection.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE } from "@/site";
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";
import {
  fetchCategoriesFromApi,
  fetchSiteConfigFromApi,
  fetchArticlesFromApi,
  siteUrlFromScope
} from "@/lib/api";

const carSlug = params?.slug || Astro.params.slug || "";

// Find car data with robust exact, longest-slug, and token matching
const cleanSlug = (carSlug || "").toLowerCase().trim();
const car = ELECTRIFIED_CARS_DATA.find((c: any) => {
  const s = (c.slug || "").toLowerCase();
  return s === cleanSlug;
}) || (() => {
  const matches = ELECTRIFIED_CARS_DATA.filter((c: any) => {
    const s = (c.slug || "").toLowerCase();
    return s.includes(cleanSlug) || (cleanSlug.length > 3 && cleanSlug.includes(s));
  });
  if (matches.length > 0) {
    return matches.sort((a: any, b: any) => (b.slug?.length || 0) - (a.slug?.length || 0))[0];
  }
  return null;
})() || ELECTRIFIED_CARS_DATA.find((c: any) => {
  const tokens = cleanSlug.split(/[-_ ]+/).filter((t: string) => t.length > 2 && t !== "ev" && t !== "mobil");
  const haystack = `${c.brand || ""} ${c.name || ""} ${c.slug || ""}`.toLowerCase();
  return tokens.length > 0 && tokens.every((tok: string) => haystack.includes(tok));
}) || ELECTRIFIED_CARS_DATA[0];
const brandName = car?.brand || "EVnesia";

const [apiCategories, siteConfig, recentArticles] = await Promise.all([
  fetchCategoriesFromApi(request),
  fetchSiteConfigFromApi(request),
  fetchArticlesFromApi({ limit: 4 }, request)
]);

const variants = car.variants || [];
const specs: any = car.specs || {};

