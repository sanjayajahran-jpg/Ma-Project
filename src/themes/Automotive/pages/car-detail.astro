function checkAdasFeature(feat: typeof ADAS_FEATURE_LIST[0], variant: any, carData: any): { has: boolean; label: string } {
  const combined = [
    variant?.safety_adas || "",
    variant?.highlights || "",
    ...(carData?.adas_features || []),
    carData?.description || "",
  ].join(" ").toLowerCase();

  const matched = feat.keywords.some(kw => combined.includes(kw.toLowerCase()));
  if (matched) return { has: true, label: "✓ Standar" };

  if ((carData?.adas_features?.length || 0) > 0 && (combined.includes("adas") || combined.includes("safety"))) {
    return { has: true, label: "✓ Standar" };
  }

  if (["esc", "tpms", "hsa"].includes(feat.id)) {
    return { has: true, label: "✓ Standar" };
  }

  return { has: false, label: "—" };
}

function getCleanWheelSpec(rawSpec: string, carData: any): string {
  if (!rawSpec || rawSpec.trim() === "" || rawSpec.toLowerCase().includes("resmi apm") || rawSpec.toLowerCase() === "alloy wheels") {
    const name = (carData.name || "").toLowerCase();
    if (name.includes("bj30")) return "235/55 R19 Alloy Wheels";
    if (name.includes("t1")) return "205/55 R16 Alloy Wheels";
    if (name.includes("c5") || name.includes("omoda")) return "215/55 R18 Two-Tone Alloy";
    if (name.includes("m6")) return "205/55 R17 Alloy Wheels";
    if (name.includes("seal")) return "235/45 R19 Sport Alloy";
    if (name.includes("atto 3")) return "215/55 R18 Two-Tone Alloy";
    if (name.includes("dolphin")) return "195/60 R16 Alloy Wheels";
    if (name.includes("air ev")) return "145/70 R12 Wheels";
    if (name.includes("binguo")) return "185/60 R15 Alloy Wheels";
    if (name.includes("cloud")) return "215/60 R18 Alloy Wheels";
    if (name.includes("ioniq 5")) return "235/55 R19 Parametric Alloy";
    if (name.includes("ioniq 6")) return "245/40 R20 Sport Alloy";
    if (name.includes("ev6")) return "255/45 R20 GT Alloy";
    if (name.includes("ev9")) return "285/45 R21 Dark Chrome Alloy";
    if (carData.bodyType === "suv") return "235/55 R19 Alloy Wheels";
    if (carData.bodyType === "sedan") return "225/50 R18 Alloy Wheels";
    if (carData.bodyType === "mpv") return "215/60 R17 Alloy Wheels";
    return "215/55 R18 Alloy Wheels";
  }
  return rawSpec;
}

function getCleanInterior(raw: string): string {
  if (!raw || raw.trim() === "") return "Premium Leatherette";
  return raw
    .replace(/^Interior\s+/i, "")
    .replace(/\s*\/\s*Comfort Seats/i, "")
    .replace(/\s*Jok\s*/i, "")
    .trim() || "Premium Leatherette";
}

function getCleanInfotainment(raw: string, carData: any): string {
  if (!raw || raw.toLowerCase().includes("smartphone mirroring") || raw.toLowerCase().includes("touchscreen central")) {
    const name = (carData.name || "").toLowerCase();
    if (name.includes("bj30")) return "14.6 Inci Full HD Touchscreen";
    if (name.includes("c5") || name.includes("omoda")) return "24.6 Inci Dual Curved Screen";
    if (name.includes("seal") || name.includes("atto") || name.includes("dolphin")) return "15.6 Inci Rotating Touchscreen";
    if (name.includes("m6")) return "12.8 Inci Rotating Touchscreen";
    if (name.includes("ioniq 5")) return "12.3 Inci Dual Screen";
    if (name.includes("binguo") || name.includes("air")) return "10.25 Inci Dual Screen";
    return "12.8 - 14.6 Inci Touchscreen";
  }
  return raw;
}

function getCarHighlightTagline(c: any): string {
  const name = (c.name || "").toLowerCase();
  if (name.includes("bj30")) {
    return "SUV Hybrid Offroad bertenaga 409 PS dengan penggerak 4WD cerdas, jangkauan jelajah hingga 1.000 km, dan kabin lapang bernuansa tangguh modern.";
  }
  if (name.includes("c5") || name.includes("omoda")) {
    return "Crossover Hybrid modern dengan akselerasi responsif, efisiensi bahan bakar superior, dan teknologi keselamatan aktif lengkap.";
  }
  if (c.tagline && !c.tagline.toLowerCase().includes("kendaraan elektrifikasi terdepan") && !c.tagline.toLowerCase().includes("spesifikasi teknis")) {
    return c.tagline;
  }
  const type = (c.bodyType || 'SUV').toUpperCase();
  const power = c.hp ? `bertenaga ${c.hp.split('/')[0].trim()}` : '';
  const range = c.consumption ? `jangkauan jelajah ${c.consumption}` : '';
  const parts = [type, power, range].filter(Boolean);
  return `${parts.join(' dengan ')}, menghadirkan efisiensi berkendara modern dan kenyamanan optimal.`;
}

// Backend API Integration: fetch gallery photos & brochure URL
const BACKEND_URL = "http://localhost:8000";
const BACKEND_API = `${BACKEND_URL}/api/v1`;

let galleryImages: string[] = [];
const brochureUrl = `${BACKEND_URL}/static/brosur/${encodeURIComponent(car.name)}.pdf`;

try {
  const backendCar: any = await fetch(`${BACKEND_API}/cars/${carSlug}`, {
    signal: AbortSignal.timeout(3000)
  }).then((r: Response) => r.ok ? r.json() : null).catch(() => null);

  if (backendCar && Array.isArray(backendCar.variants)) {
    for (const v of backendCar.variants) {
      if (v.gallery_json) {
        try {
          const urls: string[] = JSON.parse(v.gallery_json);
          galleryImages.push(...urls.map((u: string) =>
            u.startsWith('/') ? `${BACKEND_URL}${u}` : u
          ));
        } catch {}
      }
    }
  }
} catch {}

// Fallback: show main car image if no backend gallery photos
if (galleryImages.length === 0) {
  galleryImages = [carImg];
}

const carVideos: any[] = (car.videos && car.videos.length > 0)
  ? car.videos
  : (car.video ? [car.video] : []);
