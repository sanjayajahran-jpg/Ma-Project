                />
              </div>
              <div class="p-3 space-y-1">
                <div class="flex items-center gap-1.5 text-[9px] text-slate-400 font-medium">
                  <span class="text-cyan-600 dark:text-cyan-400 font-bold">{art.category}</span>
                  <span>•</span>
                  <span>{art.date}</span>
                </div>
                <h3 class="font-headline font-bold text-xs sm:text-sm text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-2">
                  <a href={`/kategori/ulasan?q=${encodeURIComponent(brandName)}`}>{art.title}</a>
                </h3>
                <p class="text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
