---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Pagination from "../components/Pagination.astro";
import { allArticles, getByTag, tags } from "@/data";
import { articleUrl } from "@/types";
import { fetchArticlesPaginated, fetchTagsFromApi, isFallbackDataEnabled, siteUrlFromScope } from "@/lib/api";

interface Props {
  request: Request;
  params: Record<string, string | undefined>;
  url: URL;
}
const { request, params, url } = Astro.props;

const slug = params.slug ?? "";
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1"));
const PER_PAGE = 12;

const sourceTags = await fetchTagsFromApi(request);
const allowFallback = isFallbackDataEnabled();
let notFound = false;
const _tag = (
  sourceTags.length
    ? sourceTags
    : allowFallback
      ? [...new Set(allArticles.flatMap((article) => article.tags.map((item) => item.slug)))].map(
        (item) => tags[item],
      )
      : []
).find((item) => item?.slug === slug);
if (!_tag) {
  notFound = true;
}
const tag = _tag!;

let siteUrl = "";
let items: Awaited<ReturnType<typeof fetchArticlesPaginated>>["items"] = [];
let totalItems = 0;
let totalPages = 1;
let itemListLd: Record<string, any> = {};

if (!notFound) {
  siteUrl = siteUrlFromScope(request);
  const result = await fetchArticlesPaginated({ tag: slug, page, limit: PER_PAGE }, request);
  items = result.items;
  totalItems = result.total;
  totalPages = Math.max(1, Math.ceil(result.total / PER_PAGE));
  itemListLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `Topik ${tag.name}`,
    itemListElement: items.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteUrl}${articleUrl(article)}`,
      name: article.title,
    })),
  };
}
---

{notFound ? (
  <BaseLayout title="Halaman tidak ditemukan - EVnesia" noindex>
    <div class="mx-auto max-w-5xl px-4 py-20 text-center">
      <div class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-12 backdrop-blur-2xl">
        <h1 class="font-headline font-black text-6xl text-cyan-600 dark:text-cyan-400">404</h1>
        <p class="mt-2 text-slate-500 dark:text-slate-400">Topik tag tidak ditemukan.</p>
        <a href="/" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition">
          Kembali ke Beranda →
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`#${tag.name} - Berita & Analisis Otomotif EVnesia`}
    description={`Kumpulan ulasan, spesifikasi, dan berita otomotif bertopik #${tag.name} di EVnesia.`}
    jsonLd={itemListLd}
  >
  <div class="mx-auto max-w-7xl px-4 pt-4 pb-16 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-cyan-500 transition">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-slate-400">Topik</span></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-900 dark:text-white font-bold">#{tag.name}</li>
      </ol>
    </nav>

    <!-- Tag Header Banner -->
    <header class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-6 sm:p-10 backdrop-blur-2xl shadow-xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-3 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Topik Pembahasan
        </div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="font-headline font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white tracking-tight">
              #{tag.name}
            </h1>
            <p class="mt-2 text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-2xl font-normal leading-relaxed">
              Kumpulan ulasan teruji, berita terkini, dan analisis data seputar topik #{tag.name}.
            </p>
          </div>
          <span class="text-xs font-extrabold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-3 py-1.5 rounded-xl shrink-0 self-start sm:self-auto">
            {totalItems || items.length} Artikel Terkait
          </span>
        </div>
      </div>
    </header>

    <!-- Articles Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((a) => <ArticleCard article={a} showDek />)}
    </div>

    <Pagination current={page} total={totalPages} base={`/tag/${tag.slug}`} />
  </div>
</BaseLayout>
)}
