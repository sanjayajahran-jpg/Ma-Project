---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getLatest } from "@/data";
import { fetchAllArticlesFromApi, isFallbackDataEnabled } from "@/lib/api";

interface Props {
  request: Request;
  params: Record<string, string | undefined>;
  url: URL;
}
const { request, params, url } = Astro.props;

const apiArticles = await fetchAllArticlesFromApi(3, request);
const latest = apiArticles.length
  ? apiArticles
  : isFallbackDataEnabled()
    ? getLatest(3)
    : [];
---

<BaseLayout title="404: Halaman Tidak Ditemukan - EVnesia" noindex>
  <div class="mx-auto max-w-5xl px-4 pt-6 pb-16 space-y-12">
    <!-- Liquid Glass 404 Center Card -->
    <div class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-8 sm:p-14 backdrop-blur-2xl shadow-xl text-center relative overflow-hidden space-y-6">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-3 relative z-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Error 404 • Rute Hilang
        </span>
        <h1 class="font-headline font-black text-7xl sm:text-8xl bg-linear-to-r from-cyan-500 via-sky-400 to-emerald-400 bg-clip-text text-transparent tracking-tighter">
          404
        </h1>
        <h2 class="font-headline font-black text-2xl sm:text-3xl text-slate-900 dark:text-white">
          Halaman Tidak Ditemukan
        </h2>
        <p class="mx-auto max-w-md text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
          Tautan yang Anda tuju mungkin telah diperbarui, dipindahkan ke alamat baru, atau tidak tersedia di pangkalan data kami.
        </p>
      </div>

      <!-- Quick Search Bar -->
      <form action="/cari" method="get" role="search" class="mx-auto max-w-lg relative z-10">
        <label for="not-found-search" class="sr-only">Cari artikel atau model mobil</label>
        <div class="flex items-center rounded-2xl bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700 shadow-sm focus-within:ring-2 focus-within:ring-cyan-500 transition p-1.5 text-slate-900 dark:text-white">
          <img src="/icons/search.svg" class="w-4 h-4 ml-3 opacity-40 shrink-0" alt="" />
          <input
            id="not-found-search"
            type="search"
            name="q"
            placeholder="Cari berita atau model mobil…"
            class="w-full bg-transparent px-3 py-2 text-xs sm:text-sm outline-none font-medium placeholder-slate-400"
          />
          <button
            type="submit"
            class="rounded-xl bg-cyan-600 hover:bg-cyan-500 px-5 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition cursor-pointer shrink-0"
          >
            Cari
          </button>
        </div>
      </form>

      <!-- Quick Action Navigation Pills -->
      <div class="flex flex-wrap justify-center gap-3 pt-2 relative z-10">
        <a
          href="/"
          class="rounded-xl bg-cyan-600 hover:bg-cyan-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition"
        >
          Ke Beranda
        </a>
        <a
          href="/katalog-mobil"
          class="rounded-xl border border-slate-200 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 hover:border-cyan-500/50 hover:bg-cyan-50/40 dark:hover:bg-cyan-950/20 transition flex items-center gap-1.5"
        >
          <img src="/icons/car.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
          <span>Katalog Mobil</span>
        </a>
        <a
          href="/indeks-berita"
          class="rounded-xl border border-slate-200 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 hover:border-cyan-500/50 hover:bg-cyan-50/40 dark:hover:bg-cyan-950/20 transition"
        >
          Indeks Berita
        </a>
      </div>
    </div>

    <!-- Suggested Recent Articles -->
    {
      latest.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-3">
            <h3 class="font-headline font-black text-xl text-slate-900 dark:text-white">
              Artikel Rekomendasi Terkini
            </h3>
            <a href="/indeks-berita" class="text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline uppercase tracking-wider">
              Lihat Semua →
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {latest.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
