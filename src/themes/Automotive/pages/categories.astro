---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  fetchCategoriesFromApi,
  fetchSiteConfigFromApi,
  siteUrlFromScope,
} from "@/lib/api";

interface Props {
  request: Request;
  siteConfig?: Awaited<ReturnType<typeof fetchSiteConfigFromApi>>;
}

const { request, siteConfig } = Astro.props;
const categories = await fetchCategoriesFromApi(request);
const siteUrl = siteUrlFromScope(request);
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Kanal Berita",
  itemListElement: categories.map((category, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: category.name,
    url: `${siteUrl}/kategori/${category.slug}`,
  })),
};
---

<BaseLayout
  title="Kanal Berita Otomotif - EVnesia"
  description="Daftar kanal berita, ulasan mobil listrik, teknologi baterai, dan panduan otomotif EVnesia."
  siteConfig={siteConfig}
  navCategories={categories}
  jsonLd={itemListLd}
>
  <div class="mx-auto max-w-7xl px-4 pt-4 pb-16 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-cyan-500 transition">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-900 dark:text-white font-bold">Kanal Berita</li>
      </ol>
    </nav>

    <!-- Header Banner -->
    <header class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-6 sm:p-10 backdrop-blur-2xl shadow-xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-3 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Kanal Resmi EVnesia
        </div>
        <h1 class="font-headline font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white tracking-tight">
          Kanal Liputan & Riset Otomotif
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed font-normal">
          Jelajahi rubrik otomotif komprehensif kami, mulai dari uji jalan mobil listrik, perbandingan trim, ekosistem charging, hingga panduan regulasi insentif.
        </p>
      </div>
    </header>

    {
      categories.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <a
              href={`/kategori/${category.slug}`}
              class="group figma-liquid-glass rounded-3xl border border-slate-200/80 dark:border-white/10 p-6 backdrop-blur-2xl hover:border-cyan-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between space-y-4"
            >
              <div>
                <span class="inline-flex items-center gap-1 text-[10px] font-extrabold uppercase tracking-widest text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-1 rounded-full">
                  Kanal
                </span>
                <h2 class="font-headline mt-3 text-2xl font-black text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                  {category.name}
                </h2>
                <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-500 dark:text-slate-400 line-clamp-3">
                  {category.description || `Berita terbaru, analisis data, dan ulasan mendalam dalam kanal ${category.name}.`}
                </p>
              </div>
              <div class="pt-4 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between text-xs font-bold text-cyan-600 dark:text-cyan-400">
                <span>Eksplorasi Kanal</span>
                <span class="group-hover:translate-x-1.5 transition-transform duration-200">→</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-12 text-center backdrop-blur-2xl">
          <p class="font-headline font-black text-2xl text-slate-900 dark:text-white">Belum ada kategori tersedia.</p>
          <a href="/" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition">
            Kembali ke Beranda →
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
