---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Pagination from "../components/Pagination.astro";
import { fetchAllArticlesFromApi, isFallbackDataEnabled, type ApiSiteConfigResponse } from "@/lib/api";
import { getLatest } from "@/data";

interface Props { request: Request; params: Record<string, string | undefined>; url: URL; siteConfig?: ApiSiteConfigResponse | null; }
const { request, url } = Astro.props;
const all = await fetchAllArticlesFromApi(100, request);
const articles = all.length ? all : isFallbackDataEnabled() ? getLatest(100) : [];
const sort = url.searchParams.get("urut") === "populer" ? "populer" : "terbaru";
const current = Math.max(1, Number(url.searchParams.get("page")) || 1);
const perPage = 12;
const items = [...articles].sort((a, b) => sort === "populer" ? b.viewCount - a.viewCount || +new Date(b.publishedAt) - +new Date(a.publishedAt) : +new Date(b.publishedAt) - +new Date(a.publishedAt));
const total = Math.max(1, Math.ceil(items.length / perPage));
const pageItems = items.slice((Math.min(current, total) - 1) * perPage, Math.min(current, total) * perPage);
const basePath = url.pathname === "/indeks-berita" ? "/indeks-berita" : "/indeks";
const paginationBase = sort === "populer" ? `${basePath}?urut=populer` : basePath;
---

<BaseLayout title="Indeks Berita & Ulasan Otomotif - EVnesia" description="Daftar arsip berita terbaru, uji jalan mobil listrik, dan analisis industri otomotif EVnesia.">
  <div class="mx-auto max-w-7xl px-4 pt-4 pb-16 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-cyan-500 transition">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-900 dark:text-white font-bold">Indeks Berita</li>
      </ol>
    </nav>

    <!-- Header Banner -->
    <header class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-6 sm:p-10 backdrop-blur-2xl shadow-xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Arsip Kronologis
        </div>

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="font-headline font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white tracking-tight">
              Indeks Berita & Ulasan
            </h1>
            <p class="mt-2 text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-2xl font-normal leading-relaxed">
              Jelajahi seluruh kumpulan publikasi media kami yang diurutkan berdasarkan waktu terbit atau artikel paling banyak dibaca.
            </p>
          </div>

          <!-- Sort Filter Switcher -->
          <nav class="flex items-center gap-2 shrink-0 bg-slate-100 dark:bg-slate-800/80 p-1.5 rounded-2xl border border-slate-200/80 dark:border-white/5" aria-label="Urutan Berita">
            <a
              class:list={[
                "rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider transition",
                sort === "terbaru"
                  ? "bg-cyan-600 text-white shadow-md shadow-cyan-600/30"
                  : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white",
              ]}
              href={basePath}
            >
              ⏱️ Terbaru
            </a>
            <a
              class:list={[
                "rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider transition flex items-center gap-1.5",
                sort === "populer"
                  ? "bg-cyan-600 text-white shadow-md shadow-cyan-600/30"
                  : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white",
              ]}
              href={`${basePath}?urut=populer`}
            >
              <img src="/icons/award.svg" class="w-3.5 h-3.5 opacity-80 inline-block" alt="" />
              <span>Terpopuler</span>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Articles Grid -->
    <div class="grid gap-6 md:grid-cols-2">
      {pageItems.map((article) => (
        <ArticleCard article={article} variant="horizontal" />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination current={Math.min(current, total)} total={total} base={paginationBase} />
  </div>
</BaseLayout>
