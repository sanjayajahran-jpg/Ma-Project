---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchSiteConfigFromApi, portalDomainFromScope } from "@/lib/api";
import { portalIdentityForDomain } from "@/site";

interface Props {
  request: Request;
  params: Record<string, string | undefined>;
  url: URL;
}
const { request, params, url } = Astro.props;

const siteConfig = await fetchSiteConfigFromApi(request);
const identity = portalIdentityForDomain(portalDomainFromScope(request), siteConfig?.portal?.name);
---

<BaseLayout
  title={`Gabung Jaringan Media ${identity.name} - EVnesia`}
  description="Daftarkan portal media otomotif Anda ke jaringan publikasi profesional EVnesia."
  noindex
>
  <div class="mx-auto max-w-6xl px-4 pt-4 pb-16 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-cyan-500 transition">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-900 dark:text-white font-bold">Kemitraan Media</li>
      </ol>
    </nav>

    <!-- Liquid Glass Split Container -->
    <div class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-8 sm:p-12 md:p-14 backdrop-blur-2xl shadow-xl grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <!-- Left Column -->
      <div class="space-y-6 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Kemitraan Jaringan Media
        </div>
        <h1 class="font-headline font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white tracking-tight leading-tight">
          Kelola media otomotif Anda dalam satu sistem profesional terpadu.
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 font-normal leading-relaxed">
          EVnesia CMS mendukung multi portal berita, pangkalan data spesifikasi kendaraan, manajemen redaksi, penyimpanan aset terdistribusi, serta integrasi analitik modern.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            class="rounded-xl bg-cyan-600 hover:bg-cyan-500 px-6 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition cursor-pointer"
            href={`mailto:${identity.email}?subject=Registrasi%20Portal%20Media%20EVnesia`}
          >
            Hubungi Tim Redaksi →
          </a>
          <a
            class="rounded-xl border border-slate-200 dark:border-white/10 bg-white/60 dark:bg-slate-900/60 px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 hover:border-cyan-500/50 hover:bg-cyan-50/40 dark:hover:bg-cyan-950/20 transition"
            href="/"
          >
            Kembali ke Beranda
          </a>
        </div>
      </div>

      <!-- Right Column -->
      <div class="border-t lg:border-t-0 lg:border-l border-slate-200/60 dark:border-white/10 pt-8 lg:pt-0 lg:pl-10 space-y-5 relative z-10 flex flex-col justify-center">
        <h2 class="font-headline font-black text-xl text-slate-900 dark:text-white">
          Persyaratan & Kesiapan
        </h2>
        <ul class="space-y-3.5 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-500 font-bold">✓</span>
            <span>Profil entitas media, badan usaha pers, atau jejaring jurnalis otomotif.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-500 font-bold">✓</span>
            <span>Nama domain portal, aset logo vektor, dan identitas warna merek resmi.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-500 font-bold">✓</span>
            <span>Akses perizinan peran redaktur, reporter, penulis, dan staf teknis.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-500 font-bold">✓</span>
            <span>Koneksi penyimpanan CDN media dan pangkalan data spesifikasi mobil.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
