---
const { request, params, url } = Astro.props as any;
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Pagination from "../components/Pagination.astro";
import AdSlot from "../components/AdSlot.astro";
import { categories, getByCategory } from "@/data";
import { articleUrl } from "@/types";
import {
  fetchArticlesPaginated,
  fetchCategoriesFromApi,
  isFallbackDataEnabled,
  siteUrlFromScope,
} from "@/lib/api";

const slug = params.slug ?? "";
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1"));
const PER_PAGE = 12;

const sourceCategories = await fetchCategoriesFromApi(request);
const allowFallback = isFallbackDataEnabled();
const category = (sourceCategories.length ? sourceCategories : allowFallback ? categories : []).find(
  (item) => item.slug === slug,
);

if (!category) {
  return Astro.redirect("/404", 302);
}

const siteUrl = siteUrlFromScope(request);
let items: Awaited<ReturnType<typeof fetchArticlesPaginated>>["items"] = [];
let totalPages = 1;
const result = await fetchArticlesPaginated({ category: slug, page, limit: PER_PAGE }, request);
items = result.items;
totalPages = Math.max(1, Math.ceil(result.total / PER_PAGE));
const lead = items[0];
const rest = items.slice(1);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: category.name,
      item: `${siteUrl}/kategori/${category.slug}`,
    },
  ],
};
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Kategori ${category.name}`,
  itemListElement: items.map((article, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `${siteUrl}${articleUrl(article)}`,
    name: article.title,
  })),
};
---

<BaseLayout
  title={`${category.name} - Liputan & Ulasan Otomotif EVnesia`}
  description={category.description}
  jsonLd={[breadcrumbLd, itemListLd]}
>
  <div class="mx-auto max-w-7xl px-4 pt-4 pb-16 space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-cyan-500 transition">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/kategori" class="hover:text-cyan-500 transition">Kategori</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-900 dark:text-white font-bold">{category.name}</li>
      </ol>
    </nav>

    <!-- Category Header Banner (Figma Liquid Glass Hero) -->
    <header class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-6 sm:p-10 backdrop-blur-2xl shadow-xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-3 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          Kanal Berita & Riset
        </div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="font-headline font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 dark:text-white tracking-tight">
              {category.name}
            </h1>
            <p class="mt-2 text-sm sm:text-base text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed">
              {category.description || `Ulasan mendalam, berita terverifikasi, dan analisis otomotif dalam rubrik ${category.name}.`}
            </p>
          </div>
          <span class="text-xs font-extrabold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-3 py-1.5 rounded-xl shrink-0 self-start sm:self-auto">
            {result.total || items.length} Artikel Terbit
          </span>
        </div>
      </div>
    </header>

    {
      lead && (
        <div class:list={["grid gap-6", rest.length ? "lg:grid-cols-2" : ""]}>
          <ArticleCard article={lead} variant="hero" showDek eager />
          {rest.length > 0 && (
            <div class="flex flex-col gap-4 justify-between">
              {rest.slice(0, 3).map((a) => (
                <ArticleCard article={a} variant="horizontal" />
              ))}
            </div>
          )}
        </div>
      )
    }

    {
      !lead && (
        <div class="figma-liquid-glass rounded-3xl border border-slate-200/90 dark:border-white/20 p-12 text-center backdrop-blur-2xl">
          <p class="text-xs font-bold uppercase tracking-widest text-cyan-600 dark:text-cyan-400">Belum ada artikel</p>
          <p class="font-headline font-black text-2xl text-slate-900 dark:text-white mt-2">Kategori ini belum memiliki konten terbit.</p>
          <a href="/" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-cyan-600/20 transition">
            Kembali ke Beranda →
          </a>
        </div>
      )
    }

    <div class="my-6">
      <AdSlot format="leaderboard" />
    </div>

    {
      rest.length > 3 && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.slice(3).map((a) => (
            <ArticleCard article={a} showDek />
          ))}
        </div>
      )
    }

    <Pagination current={page} total={totalPages} base={`/kategori/${category.slug}`} />
  </div>
</BaseLayout>
