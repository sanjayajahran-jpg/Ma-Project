---
// katalog-mobil.astro — EVHub.id Mobile-First Fast Catalog & Brand Showcase
const { request } = Astro.props as any;

import BaseLayout from "../layouts/BaseLayout.astro";
import BrandStripRow from "../components/BrandStripRow.astro";
import BrandShowcaseHero from "../components/BrandShowcaseHero.astro";
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";
import { fetchAllArticlesFromApi, fetchCategoriesFromApi, fetchSiteConfigFromApi } from "@/lib/api";
import { getBrandLogo, getOptimizedCarImg } from "../lib/brand-utils";

const [apiArticles, apiCategories, siteConfig] = await Promise.all([
  fetchAllArticlesFromApi(20, request),
  fetchCategoriesFromApi(request),
  fetchSiteConfigFromApi(request),
]);

const norm = (s: string) => (s || "").toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, "");

const selectedBrandParam = Astro.url.searchParams.get("brand") || "";
const selectedModelParam = Astro.url.searchParams.get("model") || "";
const themePreview = Astro.url.searchParams.get("theme_preview") || "";

// Filter by brand if selected
const brandCars = selectedBrandParam
  ? ELECTRIFIED_CARS_DATA.filter((c: any) => {
      const cb = norm(c.brand);
      const sb = norm(selectedBrandParam);
      return cb === sb || cb.includes(sb) || sb.includes(cb);
    })
  : [];

const isBrandMode = selectedBrandParam !== "" && brandCars.length > 0;

// Find initial car in brand mode
const initialCarIndex = isBrandMode && selectedModelParam
  ? Math.max(0, brandCars.findIndex((c: any) => c.slug === selectedModelParam || norm(c.slug).includes(norm(selectedModelParam))))
  : 0;

const activeCars = isBrandMode ? brandCars : ELECTRIFIED_CARS_DATA;
const currentCar = isBrandMode ? brandCars[initialCarIndex] : null;
---

<BaseLayout
  title={isBrandMode && currentCar ? `${currentCar.name} — Spesifikasi & Lineup ${currentCar.brand} Indonesia | EVHub.id` : (selectedBrandParam ? `Lineup Mobil ${selectedBrandParam} Indonesia 2026 — Spesifikasi & Harga | EVHub.id` : "Katalog & Lineup Mobil Listrik Indonesia 2026 — EVHub.id")}
  description={isBrandMode && currentCar ? `Spesifikasi resmi ${currentCar.name} dan seluruh lineup ${currentCar.brand}. Baterai, jarak tempuh, tenaga motor, dan harga OTR terbaru.` : "Katalog lengkap 140+ mobil listrik (BEV, PHEV, HEV) resmi di Indonesia. Bandingkan harga, jarak tempuh, dan spesifikasi teknis."}
  siteConfig={siteConfig}
  navCategories={apiCategories}
>
  <div class="mx-auto max-w-5xl px-3 sm:px-6 pt-14 sm:pt-18 pb-28 sm:pb-20">
    {isBrandMode ? (
      <BrandShowcaseHero
        brand={selectedBrandParam}
        cars={brandCars}
        allCars={ELECTRIFIED_CARS_DATA}
        articles={apiArticles}
        initialIndex={initialCarIndex}
        themePreview={themePreview}
      />
    ) : (
      <div>
        <!-- Top Header Strip: Catalog Title -->
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-4 rounded-full bg-sky-500 shrink-0"></span>
              <h1 class="text-sm sm:text-xl font-black text-slate-900 dark:text-white tracking-tight truncate">
                Katalog Mobil Listrik Indonesia
              </h1>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 flex items-center gap-2">
              <span><strong id="header-car-count" class="text-sky-600 dark:text-sky-400 font-metric">{activeCars.length} model</strong> resmi di Indonesia</span>
            </p>
          </div>
        </div>

        <!-- Circular Brand Strip -->
        <BrandStripRow />

        <!-- Filter Bar: Tipe Mesin & Rentang Bujet -->
        <div class="glass p-3 sm:p-4 rounded-2xl border border-slate-200/90 dark:border-white/10 my-3 space-y-3 bg-white/90 dark:bg-slate-950/70 backdrop-blur-md shadow-xs dark:shadow-none">
          <!-- Baris 1: Filter Tipe Mesin & Reset -->
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5 no-scrollbar flex-1">
              <span class="text-[10px] font-bold uppercase text-slate-500 dark:text-slate-400 shrink-0 mr-1">Tipe:</span>
              <button type="button" class="pow-filter active-pow px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white border border-blue-400/30 transition-all cursor-pointer shrink-0 shadow-sm" data-pow="all">Semua Tipe</button>
              <button type="button" class="pow-filter px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-pow="bev">BEV (Listrik Murni)</button>
              <button type="button" class="pow-filter px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-pow="phev">PHEV (Plug-in Hybrid)</button>
              <button type="button" class="pow-filter px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-pow="hev">HEV (Hybrid)</button>
            </div>

            <button
              type="button"
              id="btn-reset-filters"
              class="hidden px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white text-[11px] font-bold border border-slate-200 dark:border-white/10 transition-all cursor-pointer shrink-0"
            >
              Reset Filter
            </button>
          </div>

          <!-- Baris 2: Slider Bujet & Chip Cepat -->
          <div class="pt-2 border-t border-slate-200/80 dark:border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div class="flex items-center gap-2.5 flex-1 max-w-md">
              <span class="text-[10px] font-bold uppercase text-slate-500 dark:text-slate-400 shrink-0">Bujet Maks:</span>
              <input
                type="range"
                id="price-range-slider"
                min="200"
                max="2000"
                step="50"
                value="2000"
                class="w-full accent-blue-500 cursor-pointer h-1.5 bg-slate-200 dark:bg-slate-800 rounded-lg appearance-none"
                aria-label="Rentang Harga Maksimal"
              />
              <span id="price-slider-label" class="text-xs font-bold text-sky-600 dark:text-sky-400 font-metric shrink-0 min-w-21 text-right">
                Semua Bujet
              </span>
            </div>

            <!-- Preset Bujet Populer -->
            <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-0.5 no-scrollbar">
              <button type="button" class="budget-chip active-chip px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-sky-500/20 text-sky-800 dark:text-sky-200 border border-sky-400 transition-all cursor-pointer shrink-0" data-budget="all">
                Semua
              </button>
              <button type="button" class="budget-chip px-2.5 py-1.5 rounded-xl text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-budget="under-300">
                &lt; Rp 300 Jt
              </button>
              <button type="button" class="budget-chip px-2.5 py-1.5 rounded-xl text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-budget="300-600">
                Rp 300 - 600 Jt
              </button>
              <button type="button" class="budget-chip px-2.5 py-1.5 rounded-xl text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-budget="600-1000">
                Rp 600 Jt - 1 M
              </button>
              <button type="button" class="budget-chip px-2.5 py-1.5 rounded-xl text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-white/5 border border-slate-200/80 dark:border-white/10 transition-all cursor-pointer shrink-0" data-budget="above-1000">
                &gt; Rp 1 M
              </button>
            </div>
          </div>
        </div>

        <!-- Info Status Filter -->
        <div class="flex items-center justify-between text-xs px-1 mb-3 text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px]">Menampilkan <strong id="filter-count-label" class="text-slate-900 dark:text-white font-metric">{activeCars.length}</strong> mobil</span>
          </div>
        </div>

        <!-- KATALOG GRID MOBIL -->
        <div id="catalog-cars-grid" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-4">
          {activeCars.map((car: any, idx: number) => {
            const logo = getBrandLogo(car.brand);
            const engineTypeLower = (car.engineType || "bev").toLowerCase();
            const rangeText = car.consumption || `${car.specs?.electric_range_km || 400} km`;
            const isPriority = idx < 4;

            return (
              <a
                href={`/mobil/${car.slug}${themePreview ? `?theme_preview=${encodeURIComponent(themePreview)}` : ''}`}
                class={`catalog-card group card-hover-lift block rounded-2xl glass-card p-2.5 sm:p-3.5 border border-slate-200/90 dark:border-white/10 hover:border-sky-400/60 bg-white dark:bg-linear-to-b dark:from-slate-900/90 dark:to-slate-950 shadow-xs dark:shadow-none transition-all duration-300 relative overflow-hidden flex flex-col justify-between ${
                  idx >= 24 ? 'hidden-overflow-batch hidden' : ''
                }`}
                data-slug={car.slug}
                data-brand={car.brand}
                data-name={car.name}
                data-price-val={car.priceVal || 0}
                data-pow={engineTypeLower}
                data-index={idx}
              >
                <!-- Card Top: Brand Badge & Engine Pill -->
                <div class="flex items-center justify-between gap-1 relative z-10">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-4 h-4 rounded-full bg-white p-0.5 shrink-0 flex items-center justify-center shadow-xs border border-slate-200/60">
                      <img src={logo} alt="" class="w-full h-full object-contain" width="16" height="16" loading="lazy" />
                    </div>
                    <span class="text-[9px] font-black text-sky-700 dark:text-sky-300 uppercase tracking-wider truncate max-w-20">
                      {car.brand}
                    </span>
                  </div>
                  <span class="text-[8px] font-bold px-1.5 py-0.5 rounded-full bg-slate-100 dark:bg-white/10 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-white/5 uppercase">
                    {car.engineType || "BEV"}
                  </span>
                </div>

                <!-- Car Thumbnail Center -->
                <div class="w-full h-24 sm:h-28 flex items-center justify-center my-2 relative">
                  <div class="absolute bottom-0 w-3/4 h-3 bg-sky-500/10 dark:bg-sky-500/20 blur-md rounded-full"></div>
                  <img
                    src={getOptimizedCarImg(car.img)}
                    alt={car.name}
                    width="200"
                    height="120"
                    class="h-full w-auto max-h-20 sm:max-h-24 object-contain group-hover:scale-105 transition-transform duration-300 relative z-10"
                    loading={isPriority ? "eager" : "lazy"}
                    decoding="async"
                    onerror={`this.onerror=null; this.src='${car.img || "/images/cars/default-car.png"}';`}
                  />
                </div>

                <!-- Card Bottom: Name, Specs & Price -->
                <div class="pt-2 border-t border-slate-100 dark:border-white/5 relative z-10">
                  <h3 class="text-xs sm:text-[13px] font-bold text-slate-900 dark:text-white truncate group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                    {car.name}
                  </h3>
                  
                  <div class="flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 mb-1.5">
                    <span class="font-mono text-sky-600 dark:text-sky-300 font-semibold">{rangeText}</span>
                    <span>•</span>
                    <span class="truncate">{car.hp ? car.hp.split('/')[0] : 'EV'}</span>
                  </div>

                  <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-white/5">
                    <span class="text-xs sm:text-sm font-black text-slate-900 dark:text-white font-metric">
                      {car.price}
                    </span>
                    <span class="text-[9px] font-bold text-sky-600 dark:text-sky-400 group-hover:translate-x-0.5 transition-transform">
                      Lihat →
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        <!-- Load More Button -->
        {activeCars.length > 24 && (
          <div id="load-more-container" class="text-center pt-6">
            <button
              type="button"
              id="btn-load-more"
              class="px-5 py-2.5 rounded-2xl bg-white dark:bg-white/10 hover:bg-slate-50 dark:hover:bg-white/15 border border-slate-200/90 dark:border-white/10 text-xs font-bold text-slate-800 dark:text-white transition-all shadow-xs cursor-pointer active:scale-95"
            >
              Muat Lebih Banyak Mobil ({activeCars.length - 24} lainnya)
            </button>
          </div>
        )}

        <!-- Empty State -->
        <div id="catalog-empty-state" class="hidden text-center py-12 px-4 rounded-3xl bg-white dark:bg-slate-950/70 border border-slate-200/90 dark:border-white/10 space-y-3 mt-4 shadow-sm">
          <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-white/10 flex items-center justify-center mx-auto text-slate-500 dark:text-slate-400 shadow-sm">
            <svg class="w-6 h-6 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Tidak Ada Mobil yang Cocok</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
            Tidak ditemukan model mobil listrik dengan kombinasi tipe mesin dan rentang bujet yang dipilih. Coba atur ulang bujet atau tipe mesin.
          </p>
          <button type="button" id="btn-reset-empty" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md cursor-pointer transition-all active:scale-95">
            Atur Ulang Filter
          </button>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline>
  function initCatalogFilter() {
    const cards = Array.from(document.querySelectorAll('.catalog-card'));
    if (!cards.length) return;

    const powButtons = document.querySelectorAll('.pow-filter');
    const budgetChips = document.querySelectorAll('.budget-chip');
    const priceSlider = document.getElementById('price-range-slider');
    const priceSliderLabel = document.getElementById('price-slider-label');
    const filterCountLabel = document.getElementById('filter-count-label');
    const headerCarCount = document.getElementById('header-car-count');
    const btnReset = document.getElementById('btn-reset-filters');
    const btnResetEmpty = document.getElementById('btn-reset-empty');
    const emptyState = document.getElementById('catalog-empty-state');
    const btnLoadMore = document.getElementById('btn-load-more');
    const loadMoreContainer = document.getElementById('load-more-container');

    let currentPowFilter = 'all';
    let currentBudgetPreset = 'all';
    let currentMinPrice = 0;
    let currentMaxPrice = Infinity;
    let isAllRevealed = cards.length <= 24;

    function applyFilters() {
      let matchedCount = 0;
      const isCustomFiltering = currentPowFilter !== 'all' || currentBudgetPreset !== 'all' || currentMaxPrice < 2000;

      cards.forEach(function(card) {
        const pow = (card.getAttribute('data-pow') || '').toLowerCase();
        const priceVal = parseFloat(card.getAttribute('data-price-val') || '0');
        const cardIndex = parseInt(card.getAttribute('data-index') || '0', 10);

        const matchesPow = currentPowFilter === 'all' || pow === currentPowFilter;
        const matchesBudget = priceVal >= currentMinPrice && priceVal <= currentMaxPrice;

        if (matchesPow && matchesBudget) {
          if (isCustomFiltering || isAllRevealed || cardIndex < 24) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
          matchedCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (filterCountLabel) filterCountLabel.textContent = '' + matchedCount;
      if (headerCarCount) headerCarCount.textContent = matchedCount + ' model';

      if (matchedCount === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      } else {
        if (emptyState) emptyState.classList.add('hidden');
        if (loadMoreContainer) {
          loadMoreContainer.style.display = (!isAllRevealed && !isCustomFiltering && matchedCount > 24) ? 'block' : 'none';
        }
      }

      if (btnReset) {
        if (isCustomFiltering) {
          btnReset.classList.remove('hidden');
        } else {
          btnReset.classList.add('hidden');
        }
      }
    }

    if (btnLoadMore) {
      btnLoadMore.addEventListener('click', function() {
        isAllRevealed = true;
        cards.forEach(function(card) { card.classList.remove('hidden-overflow-batch'); });
        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
        applyFilters();
      });
    }

    powButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        powButtons.forEach(function(b) {
          b.classList.remove('bg-blue-600', 'text-white', 'border-blue-400/30', 'font-bold', 'shadow-sm');
          b.classList.add('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        });
        btn.classList.add('bg-blue-600', 'text-white', 'border-blue-400/30', 'font-bold', 'shadow-sm');
        btn.classList.remove('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');

        currentPowFilter = btn.getAttribute('data-pow') || 'all';
        applyFilters();
      });
    });

    budgetChips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        const preset = chip.getAttribute('data-budget') || 'all';
        currentBudgetPreset = preset;

        budgetChips.forEach(function(c) {
          c.classList.remove('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
          c.classList.add('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        });
        chip.classList.add('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
        chip.classList.remove('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');

        switch (preset) {
          case 'under-300':
            currentMinPrice = 0;
            currentMaxPrice = 300;
            if (priceSlider) priceSlider.value = '300';
            if (priceSliderLabel) priceSliderLabel.textContent = '< Rp 300 Jt';
            break;
          case '300-600':
            currentMinPrice = 300;
            currentMaxPrice = 600;
            if (priceSlider) priceSlider.value = '600';
            if (priceSliderLabel) priceSliderLabel.textContent = 'Rp 300 - 600 Jt';
            break;
          case '600-1000':
            currentMinPrice = 600;
            currentMaxPrice = 1000;
            if (priceSlider) priceSlider.value = '1000';
            if (priceSliderLabel) priceSliderLabel.textContent = 'Rp 600 Jt - 1 M';
            break;
          case 'above-1000':
            currentMinPrice = 1000;
            currentMaxPrice = Infinity;
            if (priceSlider) priceSlider.value = '2000';
            if (priceSliderLabel) priceSliderLabel.textContent = '> Rp 1 M';
            break;
          case 'all':
          default:
            currentMinPrice = 0;
            currentMaxPrice = Infinity;
            if (priceSlider) priceSlider.value = '2000';
            if (priceSliderLabel) priceSliderLabel.textContent = 'Semua Bujet';
            break;
        }

        applyFilters();
      });
    });

    if (priceSlider) {
      priceSlider.addEventListener('input', function() {
        const val = parseInt(priceSlider.value, 10);
        currentMinPrice = 0;

        budgetChips.forEach(function(c) {
          c.classList.remove('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
          c.classList.add('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        });

        if (val >= 2000) {
          currentMaxPrice = Infinity;
          currentBudgetPreset = 'all';
          const allChip = document.querySelector('[data-budget="all"]');
          if (allChip) allChip.classList.add('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
          if (priceSliderLabel) priceSliderLabel.textContent = 'Semua Bujet (> Rp 2 M)';
        } else if (val >= 1000) {
          currentMaxPrice = val;
          currentBudgetPreset = 'custom';
          const inM = (val / 1000).toLocaleString('id-ID', { maximumFractionDigits: 2 });
          if (priceSliderLabel) priceSliderLabel.textContent = 'Maks. Rp ' + inM + ' M';
        } else {
          currentMaxPrice = val;
          currentBudgetPreset = 'custom';
          if (priceSliderLabel) priceSliderLabel.textContent = 'Maks. Rp ' + val + ' Jt';
        }

        applyFilters();
      });
    }

    function resetAll() {
      powButtons.forEach(function(b) {
        const isAll = b.getAttribute('data-pow') === 'all';
        if (isAll) {
          b.classList.add('bg-blue-600', 'text-white', 'border-blue-400/30', 'font-bold', 'shadow-sm');
          b.classList.remove('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        } else {
          b.classList.remove('bg-blue-600', 'text-white', 'border-blue-400/30', 'font-bold', 'shadow-sm');
          b.classList.add('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        }
      });
      currentPowFilter = 'all';

      budgetChips.forEach(function(c) {
        const isAll = c.getAttribute('data-budget') === 'all';
        if (isAll) {
          c.classList.add('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
          c.classList.remove('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        } else {
          c.classList.remove('bg-sky-500/20', 'border-sky-400', 'text-sky-800', 'dark:text-sky-200', 'font-bold');
          c.classList.add('bg-slate-100', 'dark:bg-white/5', 'border-slate-200/80', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
        }
      });
      currentBudgetPreset = 'all';
      currentMinPrice = 0;
      currentMaxPrice = Infinity;

      if (priceSlider) priceSlider.value = '2000';
      if (priceSliderLabel) priceSliderLabel.textContent = 'Semua Bujet';

      applyFilters();
    }

    if (btnReset) btnReset.addEventListener('click', resetAll);
    if (btnResetEmpty) btnResetEmpty.addEventListener('click', resetAll);

    applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogFilter);
  } else {
    initCatalogFilter();
  }
  document.addEventListener('astro:page-load', initCatalogFilter);
</script>
