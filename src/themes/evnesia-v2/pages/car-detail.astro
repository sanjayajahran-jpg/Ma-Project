                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- 2. PILIH VARIAN & SPESIFIKASI LENGKAP TIAP TRIM (POSISI DI BAWAH) -->
      {sortedVariants.length > 0 && (
        <div class="p-3.5 sm:p-5 rounded-2xl glass border border-white/10 space-y-3.5">
