              <h3 class="text-xs sm:text-sm font-extrabold text-white">Daftar Varian & Harga OTR Resmi</h3>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] text-slate-400 font-mono">{sortedVariants.length} Varian Tersedia</span>
              <button
                type="button"
                class="section-collapse-toggle sm:hidden px-2 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-300 border border-white/10 flex items-center gap-1 cursor-pointer"
                data-collapse-id="collapsible-variant-table"
                aria-expanded="true"
              >
                <span>Tutup</span>
                <svg class="w-3 h-3 text-slate-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
          </div>

          <div id="collapsible-variant-table" class="collapsible-content overflow-x-auto scrollbar-none transition-all duration-300">
            <table class="w-full text-left text-xs text-slate-300">
              <thead class="bg-white/5 text-[10px] uppercase font-bold text-slate-400 border-b border-white/10">
                <tr>
                  <th class="py-2.5 px-3">Nama Varian</th>
                  <th class="py-2.5 px-3">Harga OTR</th>
                  <th class="py-2.5 px-3">Baterai & Jarak</th>
                  <th class="py-2.5 px-3">Tenaga & Torsi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {sortedVariants.map((v: any) => {
                  const batInfo = parseCleanBatteryAndRange(v, specs, car.consumption);
                  const pwrInfo = parseCleanPowerAndDrivetrain(v, specs, car.hp);
                  return (
                    <tr class="hover:bg-white/5 transition-colors">
                      <td class="py-2.5 px-3 font-bold text-white whitespace-nowrap">
                        <span>{v.name}</span>
                      </td>
                      <td class="py-2.5 px-3 font-mono font-bold text-emerald-400 whitespace-nowrap">
                        {v.price ? formatPriceFull(v.price) : (v.priceLabel || car.price)}
                      </td>
                      <td class="py-2.5 px-3 whitespace-nowrap">
                        <div class="font-bold text-white text-xs">{batInfo.batteryTop}</div>
                        <div class="text-[11px] font-mono text-emerald-400 mt-0.5">{batInfo.rangeBottom}</div>
                      </td>
                      <td class="py-2.5 px-3 whitespace-nowrap">
                        <div class="font-bold text-sky-300 text-xs">{pwrInfo.powerTop}</div>
