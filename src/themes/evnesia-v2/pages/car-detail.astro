            </span>
          </div>

          <!-- Tombol Pilih Varian (Urutan Trim Tertinggi di Kiri) -->
          <div class="flex items-center justify-start relative py-1.5 gap-2 overflow-x-auto scrollbar-none">
            {sortedVariants.map((v: any, vIdx: number) => {
              const diffText = vIdx === 0 
                ? "" 
                : formatPriceDiff(v.price - sortedVariants[0].price);
              const vRange = parseRangeInfo(v.battery_range || car.consumption);
              const vWheel = parseCleanWheelSpec(v.wheel_spec || specs.wheel_spec);
              const vPowerOnly = cleanPower(v.power_output, specs.horsepower || car.hp);
              const vTorqueOnly = cleanTorque(v.power_output, specs.torque_nm || car.torque);
              const vRangeClean = cleanRangeOnly(v.battery_range || car.consumption, specs, car.engineType);
              const vDcClean = cleanDcCharging(v.charging_time || specs.charging_time, car.engineType);
              const vAcClean = cleanAcCharging(v.charging_time || specs.charging_time, v.wall_charger_info || specs.wall_charger_info, car.engineType);
              const vPackageClean = cleanChargerPackage(v.wall_charger_info || specs.wall_charger_info, car.engineType);
              const vBatKwh = cleanBatteryKwh(v.battery_range, specs.battery_capacity_kwh);
              const vBatType = cleanBatteryType(v.battery_type, specs.battery_type);
              const vDrivetrain = v.name.includes("AWD") ? "AWD" : v.name.includes("RWD") ? "RWD" : (specs.drivetrain || "FWD");
              const isActive = vIdx === 0;

              return (
                <button
                  type="button"
                  class={`trim-step-btn shrink-0 relative z-10 flex items-center gap-2.5 px-3.5 py-2 rounded-xl border transition-all cursor-pointer ${
                    isActive
                      ? 'active-trim bg-blue-500/15 dark:bg-blue-600/30 border-blue-500 dark:border-blue-400 text-blue-900 dark:text-white shadow-sm ring-1 ring-blue-400/40'
                      : 'bg-slate-100 dark:bg-slate-900/90 border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-white/25'
                  }`}
                  data-idx={vIdx}
                  data-name={v.name}
                  data-price={v.price ? formatPriceFull(v.price) : (v.priceLabel || car.price)}
                  data-diff={diffText}
                  data-chip={v.highlights || "Spesifikasi Lengkap APM"}
                  data-power={v.power_output || car.hp}
                  data-battery={v.battery_range || car.consumption}
                  data-range-num={vRange.number}
                  data-range-cycle={vRange.cycle}
                  data-battery-type={vBatType}
                  data-charging={v.charging_time || variants[0]?.charging_time || "DC Fast Charge Siap"}
                  data-wallbox={v.wall_charger_info || variants[0]?.wall_charger_info || "7 kW AC Wallbox"}
                  data-wheel={vWheel.summaryText}
                  data-wheel-inch={vWheel.inch}
                  data-wheel-front={vWheel.frontTire}
                  data-wheel-rear={vWheel.rearTire}
                  data-wheel-single={vWheel.singleTire}
                  data-wheel-summary={vWheel.summaryText}
                  data-power-only={vPowerOnly}
                  data-torque-only={vTorqueOnly}
                  data-range-clean={vRangeClean}
                  data-dc-clean={vDcClean}
                  data-ac-clean={vAcClean}
                  data-package-clean={vPackageClean}
                  data-bat-kwh={vBatKwh}
                  data-bat-type={vBatType}
                  data-interior={v.interior_spec || "Standard Eco-Leather"}
                  data-seating={v.seating_layout || `${specs.seating_capacity || 5}-Seater`}
                  data-sunroof={v.sunroof || "Standard Roof"}
                  data-audio={v.audio_display || specs.head_unit_infotainment || "HD Touchscreen Audio"}
                  data-adas={v.safety_adas || specs.safety_adas_full || specs.adas_name || "Level 2 ADAS"}
                  data-tax={sortedVariants[vIdx]?.annual_tax ? (typeof sortedVariants[vIdx].annual_tax === 'number' ? `Rp ${sortedVariants[vIdx].annual_tax.toLocaleString('id-ID')}/tahun` : String(sortedVariants[vIdx].annual_tax)) : (specs.annual_tax_estimate || "Rp 0 - 350.000 / tahun (Bebas PKB)")}
                  data-drivetrain={vDrivetrain}
                >
                  <span class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-black shrink-0 ${
                    isActive ? 'bg-blue-600 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
                  }`}>
                    {vIdx + 1}
                  </span>
                  <div class="text-left">
                    <span class="text-[11px] font-bold text-slate-900 dark:text-white block whitespace-nowrap">
                      {v.name.replace(car.name, '').trim() || v.name}
                    </span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-bold block">
                      {v.price ? formatPriceShort(v.price) : ''}
                    </span>
                  </div>
                </button>
              );
            })}
          </div>

          <!-- PANEL SPESIFIKASI LENGKAP DARI TRIM TERPILIH -->
          <div id="selected-trim-spec-panel" class="pt-3 border-t border-slate-200/80 dark:border-white/10 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Rincian Trim Aktif:</span>
                <span id="trim-panel-name" class="text-xs font-black text-slate-900 dark:text-white px-2 py-0.5 rounded-lg bg-blue-500/15 dark:bg-blue-500/20 border border-blue-400/30">
                  {sortedVariants[0]?.name}
                </span>
              </div>
              <span id="trim-panel-price" class="text-xs font-mono font-extrabold text-emerald-600 dark:text-emerald-400">
                {sortedVariants[0]?.price ? formatPriceFull(sortedVariants[0].price) : sortedVariants[0]?.priceLabel || car.price}
              </span>
            </div>

            <!-- Grid 6 Spesifikasi Kunci Varian -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Jarak Tempuh & Baterai</span>
                <span id="trim-spec-battery" class="font-bold text-emerald-600 dark:text-emerald-300 block leading-tight">
                  {initRangeClean}
                </span>
              </div>
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Tenaga & Torsi</span>
                <span id="trim-spec-power" class="font-bold text-sky-600 dark:text-sky-300 block leading-tight">
                  {initPowerOnly} / {initTorqueOnly}
                </span>
              </div>
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Velg & Roda</span>
                <span id="trim-spec-wheel" class="font-semibold text-slate-900 dark:text-white block truncate leading-tight">
                  {initWheel.summaryText}
                </span>
              </div>
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Interior & Kursi</span>
                <span id="trim-spec-interior" class="font-semibold text-slate-900 dark:text-white block truncate leading-tight">
                  {sortedVariants[0]?.interior_spec || sortedVariants[0]?.seating_layout || "7-Seater Leather"}
                </span>
              </div>
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Atap & Sunroof</span>
                <span id="trim-spec-sunroof" class="font-semibold text-slate-900 dark:text-white block truncate leading-tight">
                  {sortedVariants[0]?.sunroof || "Standard Roof"}
                </span>
              </div>
              <div class="glass p-2.5 rounded-xl border border-slate-200/80 dark:border-white/5 space-y-0.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Fitur Unggulan Trim</span>
                <span id="trim-spec-highlights" class="font-semibold text-amber-600 dark:text-amber-300 block truncate leading-tight">
                  {sortedVariants[0]?.highlights || "Kelengkapan Lengkap APM"}
                </span>
              </div>
            </div>
          </div>
        </div>
      )}
    </section>

    <!-- ======================================================== -->
    <!-- BAGIAN 3: SPESIFIKASI TEKNIS & INSTRUMEN EV -->
    <!-- ======================================================== -->
    <section id="spek" class="mx-auto max-w-5xl px-3 sm:px-6 my-4 sm:my-6 space-y-4 scroll-mt-28">
      <div class="flex items-center justify-between mb-1">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-3.5 rounded-full bg-cyan-400"></span>
          <h2 class="text-xs sm:text-sm font-extrabold text-white tracking-tight">
            Instrumen Data Spesifikasi Utama
          </h2>
        </div>
        <span class="text-[10px] text-slate-400 font-medium sm:hidden">Geser kartu ›</span>
      </div>

      <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-3 overflow-x-auto sm:overflow-visible snap-x snap-mandatory scrollbar-none gap-3 pb-1.5 -mx-3 px-3 sm:mx-0 sm:px-0">
        
        <!-- Widget 1: Gauge Busur 240° Jarak Tempuh -->
        <div class="w-65 sm:w-auto shrink-0 snap-start glass-card p-3.5 sm:p-4 border border-emerald-500/25 bg-linear-to-br from-slate-900/90 to-slate-950 text-center flex flex-col items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 block">Jarak Tempuh Baterai</span>
          
          <!-- SVG 240 Degree Instrument Gauge -->
          <div class="relative w-36 h-28 flex items-center justify-center my-1">
            <svg class="w-36 h-28" viewBox="0 0 140 100">
              <path
                d="M 20 85 A 55 55 0 1 1 120 85"
                fill="none"
                stroke="rgba(255,255,255,0.1)"
                stroke-width="10"
                stroke-linecap="round"
              />
              <path
                d="M 20 85 A 55 55 0 1 1 120 85"
                fill="none"
                stroke="#34e0a1"
                stroke-width="10"
                stroke-dasharray="240"
                stroke-dashoffset="40"
                stroke-linecap="round"
                class="drop-shadow-[0_0_8px_#34e0a1]"
              />
            </svg>
            <div class="absolute top-10 flex flex-col items-center">
              <span id="detail-active-range" class="text-2xl font-black text-white font-metric leading-none">
                {initialRangeInfo.number}
              </span>
              <span id="detail-active-range-cycle" class="text-[9px] text-slate-400 font-bold uppercase mt-1">
                km ({initialRangeInfo.cycle})
              </span>
            </div>
          </div>

          <span class="text-[10px] text-slate-400" id="detail-active-battery-desc">
            Kapasitas: <strong class="text-white font-bold" id="detail-active-battery-cap">{specs.battery_capacity_kwh || 60} kWh</strong> ({specs.battery_type || "LFP Blade Battery"})
          </span>
        </div>

        <!-- Widget 2: Dua Busur Konsentris Daya & Torsi -->
        <div class="w-65 sm:w-auto shrink-0 snap-start glass-card p-3.5 sm:p-4 border border-sky-500/25 bg-linear-to-br from-slate-900/90 to-slate-950 text-center flex flex-col items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400 block">Keluaran Motor Penggerak</span>
          
          <div class="relative w-36 h-28 flex items-center justify-center my-1">
            <svg class="w-36 h-28" viewBox="0 0 140 100">
              <path d="M 15 85 A 60 60 0 1 1 125 85" fill="none" stroke="rgba(46,155,255,0.2)" stroke-width="8" stroke-linecap="round" />
              <path d="M 15 85 A 60 60 0 1 1 125 85" fill="none" stroke="#2e9bff" stroke-width="8" stroke-dasharray="260" stroke-dashoffset="60" stroke-linecap="round" />
              <path d="M 30 85 A 45 45 0 1 1 110 85" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="6" stroke-linecap="round" />
              <path d="M 30 85 A 45 45 0 1 1 110 85" fill="none" stroke="#38bdf8" stroke-width="6" stroke-dasharray="190" stroke-dashoffset="50" stroke-linecap="round" />
            </svg>
            <div class="absolute top-10 flex flex-col items-center">
              <span id="detail-active-power" class="text-xl font-black text-white font-metric leading-none">
                {sortedVariants[0]?.power_output?.split('/')[0]?.trim() || car.hp || "204 PS"}
              </span>
              <span id="detail-active-torque" class="text-[9px] text-sky-300 font-bold">{sortedVariants[0]?.power_output?.split('/')[1]?.trim() || car.torque || "310 Nm"}</span>
            </div>
          </div>

          <span class="text-[10px] text-slate-400">Akselerasi 0-100 km/j: <strong class="text-white font-bold">{car.acc || "7.5s"}</strong> (<span id="detail-active-drive-badge">{sortedVariants[0]?.name?.includes("AWD") ? "AWD" : (specs.drivetrain || "FWD")}</span>)</span>
        </div>

        <!-- Widget 3: Kurva Pengisian Cepat 10-80% Sparkline -->
        <div class="w-65 sm:w-auto shrink-0 snap-start glass-card p-3.5 sm:p-4 border border-white/15 bg-linear-to-br from-slate-900/90 to-slate-950 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-300">Kurva Pengisian DC</span>
            <span class="text-[10px] font-bold text-emerald-400">10–80% · ~30 Menit</span>
          </div>

          <div class="my-2 h-16 w-full flex items-center justify-center">
            <svg class="w-full h-16" viewBox="0 0 200 60" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chgGrad2" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#34e0a1" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#34e0a1" stop-opacity="0.0" />
                </linearGradient>
              </defs>
              <path d="M 0 55 Q 30 10, 80 15 T 160 35 L 200 50 L 200 60 L 0 60 Z" fill="url(#chgGrad2)" />
              <path d="M 0 55 Q 30 10, 80 15 T 160 35 L 200 50" fill="none" stroke="#34e0a1" stroke-width="2.5" />
              <circle cx="160" cy="35" r="4" fill="#ffffff" stroke="#34e0a1" stroke-width="2" />
            </svg>
          </div>

          <div class="flex justify-between text-[10px] text-slate-400 font-mono">
            <span>Mulai: 10% (Fast DC)</span>
            <span>Target: 80% (Efisiensi Tinggi)</span>
          </div>
        </div>

      </div>

      <!-- SPESIFIKASI LENGKAP KENDARAAN (Dimensi, Powertrain, Baterai) -->
