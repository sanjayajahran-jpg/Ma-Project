                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ======================================================== -->
    <!-- BAGIAN 5: BERITA & MODEL TERKAIT -->
