                  {initWheel.frontTire && initWheel.rearTire ? (
                    <div>
                      <span class="font-bold text-slate-900 dark:text-white block">{initWheel.inch || "Alloy Wheels"}</span>
                      <span class="text-[11px] text-slate-500 dark:text-slate-400 block leading-tight">{initWheel.frontTire}</span>
                      <span class="text-[11px] text-slate-500 dark:text-slate-400 block leading-tight">{initWheel.rearTire}</span>
