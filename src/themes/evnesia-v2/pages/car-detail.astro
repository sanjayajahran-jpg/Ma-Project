---
// car-detail.astro — EVnesia V2 Mobile-First Complete Technical Showroom
const { request, params } = Astro.props as any;

import BaseLayout from "../layouts/BaseLayout.astro";
import CarCardRail from "../components/CarCardRail.astro";
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";
import { fetchAllArticlesFromApi, fetchCategoriesFromApi, fetchSiteConfigFromApi, isFallbackDataEnabled } from "@/lib/api";
import { allArticles } from "@/data";
import { getBrandLogo, getOptimizedCarImg } from "../lib/brand-utils";

const rawSlug = (params?.slug || Astro.params.slug || "").toLowerCase().trim();
const normalizedSearch = rawSlug.replace(/[^a-z0-9]/g, "");

// Robust exact + longest-match + token matching for authentic car data
const car = ELECTRIFIED_CARS_DATA.find((c: any) => {
  const s = (c.slug || "").toLowerCase();
  return s === rawSlug || s.replace(/[^a-z0-9]/g, "") === normalizedSearch;
}) || ELECTRIFIED_CARS_DATA.find((c: any) => {
  const n = (c.name || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  return n === normalizedSearch;
}) || (() => {
  // Longest-match prioritization ensures 'bmw-ix1' is chosen before 'bmw-ix', 'byd-sealion-7' before 'byd-seal'
  const matches = ELECTRIFIED_CARS_DATA.filter((c: any) => {
    const s = (c.slug || "").toLowerCase();
    return s.includes(rawSlug) || (rawSlug.length > 3 && rawSlug.includes(s));
  });
  if (matches.length > 0) {
    return matches.sort((a: any, b: any) => (b.slug?.length || 0) - (a.slug?.length || 0))[0];
  }
  return null;
})() || ELECTRIFIED_CARS_DATA.find((c: any) => {
  const tokens = rawSlug.split(/[-_ ]+/).filter((t: string) => t.length > 2 && t !== "ev" && t !== "mobil" && t !== "seri");
  const haystack = `${c.brand || ""} ${c.name || ""} ${c.slug || ""}`.toLowerCase();
  return tokens.length > 0 && tokens.every((tok: string) => haystack.includes(tok));
}) || ELECTRIFIED_CARS_DATA[0];

const specs: any = car?.specs || {};
const variants: any[] = car?.variants || [];

// Urutkan varian descending berdasarkan harga (trim tertinggi di sebelah kiri/index 0)
const sortedVariants = [...variants].sort((a: any, b: any) => {
  const pA = typeof a.price === 'number' ? a.price : parseFloat(String(a.price || 0).replace(/[^0-9.]/g, '')) || 0;
  const pB = typeof b.price === 'number' ? b.price : parseFloat(String(b.price || 0).replace(/[^0-9.]/g, '')) || 0;
  return pB - pA;
});

function formatPriceShort(val: number | undefined | null): string {
  if (!val || val <= 0) return "";
  if (val >= 1_000_000_000) {
    const inM = val / 1_000_000_000;
    const formatted = (Math.round(inM * 100) / 100).toLocaleString('id-ID');
    return `Rp ${formatted} M`;
  }
  const inJt = val / 1_000_000;
  const formatted = (Math.round(inJt * 10) / 10).toLocaleString('id-ID');
  return `Rp ${formatted} Jt`;
}

function formatPriceFull(val: number | undefined | null): string {
  if (!val || val <= 0) return "";
  return `Rp ${Math.round(val).toLocaleString('id-ID')}`;
}

function formatPriceDiff(diff: number): string {
  const absDiff = Math.abs(diff);
  const sign = diff < 0 ? '-' : '+';
  if (absDiff >= 1_000_000_000) {
    const inM = (Math.round((absDiff / 1_000_000_000) * 100) / 100).toLocaleString('id-ID');
    return `${sign}Rp ${inM} M`;
  }
  const inJt = Math.round(absDiff / 1_000_000);
  return `${sign}Rp ${inJt} Jt`;
}

// Helper function untuk parsing angka dan siklus jarak tempuh tanpa bug konkatenasi
function parseRangeInfo(str: string | number | undefined, fallback: number = 400) {
  if (!str) return { number: String(fallback), cycle: "CLTC", label: `${fallback} km` };
  if (typeof str === 'number') return { number: String(str), cycle: "Siklus Uji", label: `${str} km` };
  
  const s = String(str);
  const cycleMatch = s.match(/(CLTC|NEDC|WLTP|EPA|Combined|Real-world)/i);
  const cycle = cycleMatch ? cycleMatch[1].toUpperCase() : "Siklus Uji";

  const rangeMatch = s.match(/(\d+(?:\.\d+)?)\s*(?:-\s*(\d+(?:\.\d+)?))?\s*km/i);
  if (rangeMatch) {
    if (rangeMatch[2]) {
      return {
        number: `${rangeMatch[1]} - ${rangeMatch[2]}`,
        cycle,
        label: `${rangeMatch[1]} - ${rangeMatch[2]} km ${cycle}`
      };
    }
    return {
      number: rangeMatch[1],
      cycle,
      label: `${rangeMatch[1]} km ${cycle}`
    };
  }

  const nums = s.match(/\d+(?:\.\d+)?/g);
  if (nums) {
    const valid = nums.map(n => parseFloat(n)).filter(n => n >= 50 && n <= 3000);
    if (valid.length > 0) {
      const val = valid[valid.length - 1];
      return { number: String(val), cycle, label: `${val} km ${cycle}` };
    }
  }

  return { number: String(fallback), cycle: "CLTC", label: `${fallback} km` };
}

// Helper untuk menyederhanakan info Baterai & Jarak (Baterai di atas, Jarak + klaim di bawah, tanpa gimmick)
function parseCleanBatteryAndRange(v: any, specs: any, defaultRange: string = "") {
  const fullText = `${v.battery_range || ""} ${v.battery_type || ""} ${specs.battery_type || ""} ${defaultRange}`;
  
  // 1. Kapasitas kWh
  let kwh = "";
  const kwhMatch = fullText.match(/(\d+(?:[.,]\d+)?)\s*kWh/i);
  if (kwhMatch) {
    kwh = `${kwhMatch[1]} kWh`;
  } else if (specs.battery_capacity_kwh) {
    kwh = `${specs.battery_capacity_kwh} kWh`;
  }

  // 2. Jenis Baterai (LFP, NMC, dsb.)
  let chemistry = "";
  if (/LFP|Blade/i.test(fullText)) chemistry = "LFP";
  else if (/NMC|Ternary/i.test(fullText)) chemistry = "NMC";
  else if (/Lithium/i.test(fullText)) chemistry = "Li-ion";
  
  let batteryTop = "-";
  if (kwh && chemistry) batteryTop = `${kwh} ${chemistry}`;
  else if (kwh) batteryTop = kwh;
  else if (chemistry) batteryTop = `${chemistry} Battery`;
  else if (v.battery_type) batteryTop = v.battery_type;

  // 3. Jarak tempuh + klaim (WLTP/NEDC/CLTC/EPA)
  let rangeBottom = "-";
  const rangeMatch = fullText.match(/(\d+(?:[.,]\d+)?)\s*km(?:\s*(WLTP|NEDC|CLTC|EPA))?/i);
  if (rangeMatch) {
    const std = rangeMatch[2] ? rangeMatch[2].toUpperCase() : (specs.range_standard || "WLTP");
    rangeBottom = `${rangeMatch[1]} km ${std}`;
  } else if (specs.electric_range_km) {
    rangeBottom = `${specs.electric_range_km} km ${specs.range_standard || "WLTP"}`;
  }

  return { batteryTop, rangeBottom };
}

// Helper untuk menyederhanakan Tenaga & Torsi (Tenaga/Torsi di atas, Drivetrain & 0-100 di bawah)
function parseCleanPowerAndDrivetrain(v: any, specs: any, defaultHp: string = "") {
  const fullText = `${v.power_output || ""} ${v.highlights || ""} ${v.name || ""} ${defaultHp}`;

  // 1. Tenaga & Torsi
  const hpMatch = fullText.match(/(\d+(?:[.,]\d+)?)\s*(?:HP|PS|dk)/i);
  const nmMatch = fullText.match(/(\d+(?:[.,]\d+)?)\s*Nm/i);

  const hpVal = hpMatch ? `${hpMatch[1]} HP` : (specs.horsepower ? `${specs.horsepower} HP` : "");
  const nmVal = nmMatch ? `${nmMatch[1]} Nm` : (specs.torque_nm ? `${specs.torque_nm} Nm` : "");

  let powerTop = "-";
  if (hpVal && nmVal) powerTop = `${hpVal} / ${nmVal}`;
  else if (hpVal) powerTop = hpVal;
  else if (nmVal) powerTop = nmVal;
  else if (v.power_output) {
    powerTop = v.power_output.replace(/\(.*?\)/g, "").trim() || v.power_output;
  } else if (defaultHp) {
    powerTop = defaultHp;
  }

  // 2. Penggerak Roda & Akselerasi 0-100
  let drivetrain = "";
  if (/\bAWD\b|\b4WD\b|All-Wheel/i.test(fullText)) drivetrain = "AWD";
  else if (/\bRWD\b|Rear-Wheel/i.test(fullText)) drivetrain = "RWD";
  else if (/\bFWD\b|Front-Wheel/i.test(fullText)) drivetrain = "FWD";
  else if (specs.drivetrain) drivetrain = specs.drivetrain;

  let acc = "";
  const accMatch = fullText.match(/0-100\s*(?:km\/h)?\s*(?:dlm|dalam)?\s*(\d+(?:[.,]\d+)?)\s*s/i);
  if (accMatch) {
    acc = `0-100 ${accMatch[1]}s`;
  } else if (specs.acceleration_0_100) {
    acc = `0-100 ${specs.acceleration_0_100}s`;
  }

  const bottomParts = [];
  if (drivetrain) bottomParts.push(drivetrain);
  if (acc) bottomParts.push(acc);
  const drivetrainBottom = bottomParts.length > 0 ? bottomParts.join(" · ") : "-";

  return { powerTop, drivetrainBottom };
}

// Helper untuk membersihkan Velg & Roda (hanya inch & ukuran ban; jika beda depan belakang, ditulis atas bawah)
function parseCleanWheelSpec(raw: string | undefined) {
  const s = String(raw || "").trim();
  if (!s || s === "Alloy Wheels" || s === "Steel Wheels") {
    return { inch: s || "Alloy Wheels", frontTire: "", rearTire: "", singleTire: "", summaryText: s || "Alloy Wheels" };
  }

  // Extract inch: e.g. "21 inch", "20-inch", "19 inch", "14 inch"
  const inchMatch = s.match(/(\d{2})\s*(?:-?\s*inch|-?\s*in|\")/i);
  const inch = inchMatch ? `${inchMatch[1]} inch` : "";

  // Extract tire sizes: \d{3}/\d{2}\s*R\d{2}
  const tireMatches = s.match(/\d{3}\/\d{2}\s*R\d{2}/gi) || [];
  const hasFrontRear = /(?:front|depan).*(?:rear|belakang)|(?:rear|belakang).*(?:front|depan)/i.test(s);

  const t0 = tireMatches[0];
  const t1 = tireMatches[1];

  if (tireMatches.length >= 2 && t0 && t1 && (hasFrontRear || t0.toUpperCase() !== t1.toUpperCase())) {
    const frontTire = t0.toUpperCase();
    const rearTire = t1.toUpperCase();
    return {
      inch: inch || "Alloy Wheels",
      frontTire: `Depan: ${frontTire}`,
      rearTire: `Belakang: ${rearTire}`,
      singleTire: "",
      summaryText: inch ? `${inch} (${frontTire} / ${rearTire})` : `${frontTire} / ${rearTire}`
    };
  }

  if (tireMatches.length >= 1 && t0) {
    const singleTire = t0.toUpperCase();
    return {
      inch: inch || "Alloy Wheels",
      frontTire: "",
      rearTire: "",
      singleTire,
      summaryText: inch ? `${inch} (${singleTire})` : singleTire
    };
  }

  return {
    inch: inch || "Alloy Wheels",
    frontTire: "",
    rearTire: "",
    singleTire: "",
    summaryText: inch || "Alloy Wheels"
  };
}

// Helper untuk membersihkan Torsi Puncak (hanya nilai torsi tanpa gimmick dalam kurung)
function cleanTorque(str: string | undefined, specsTorque: any = ""): string {
  const s = String(str || "");
  const match = s.match(/(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?)\s*Nm/i);
  if (match) return `${match[1]} Nm`;
  if (specsTorque) {
    const sMatch = String(specsTorque).match(/(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?)\s*Nm/i);
    if (sMatch) return `${sMatch[1]} Nm`;
    const num = String(specsTorque).match(/\d+/);
    if (num) return `${num[0]} Nm`;
  }
  return "-";
}

// Helper untuk membersihkan Tenaga (hanya nilai HP/PS tanpa embel-embel)
function cleanPower(str: string | undefined, defaultHp: string = ""): string {
  const s = String(str || "");
  const match = s.match(/(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?)\s*(?:HP|PS|dk|kW)/i);
  if (match) return `${match[1]} HP`;
  if (defaultHp) {
    const dMatch = String(defaultHp).match(/(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?)\s*(?:HP|PS|dk|kW)/i);
    if (dMatch) return `${dMatch[1]} HP`;
    return defaultHp.split('/')[0]?.trim() || defaultHp;
  }
  return "-";
}

// Helper untuk membersihkan Jarak Tempuh (Hanya jarak & klaim NEDC/WLTP/CLTC tanpa kapasitas kWh atau kata 'Jarak')
function cleanRangeOnly(str: string | undefined, specs: any = {}, engineType: string = "BEV"): string {
  const s = String(str || "");
  const eng = String(engineType || "BEV").toLowerCase();

  const withoutKwh = s.replace(/\d+(?:[.,]\d+)?\s*kWh/gi, "")
                      .replace(/LFP|Blade|Battery|Baterai/gi, "")
                      .replace(/\(?\s*Jarak\s*/gi, "")
                      .replace(/\)/g, "")
                      .trim();

  const rangeMatches = withoutKwh.match(/(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?\s*km(?:\s*(?:WLTP|NEDC|CLTC|EPA|Combined))?)/gi);
  if (rangeMatches && rangeMatches.length > 0) {
    let result = rangeMatches.join(" / ").trim();
    if (!/(?:WLTP|NEDC|CLTC|EPA|Combined)/i.test(result)) {
      result += ` ${specs.range_standard || "WLTP"}`;
    }
    return result;
  }

  if (specs.electric_range_km) {
    return `${specs.electric_range_km} km ${specs.range_standard || "WLTP"}`;
  }

  if (eng.includes("hev") && !eng.includes("phev")) {
    if (specs.fuel_consumption_kmpl) return `${specs.fuel_consumption_kmpl} km/L`;
    return "-";
  }

  return "450 km WLTP";
}

// Helper untuk Fast Charging (DC) (Hanya info DC murni, tanpa mengulang info AC)
function cleanDcCharging(str: string | undefined, engineType: string = "BEV"): string {
  const eng = String(engineType || "BEV").toLowerCase();
  if (eng.includes("hev") && !eng.includes("phev")) return "-";

  const s = String(str || "").trim();
  if (!s || /tidak didukung|^-$|non-colok|\b0\s*kW\b/i.test(s)) return "-";

  const dcMatch = s.match(/(DC\s*(?:Fast\s*Charging\s*|Max\s*)?[\d.,]+\s*kW(?:\s*\([^)]+\))?)/i);
  if (dcMatch) {
    const res = dcMatch[1].replace(/DC\s*(?:Fast\s*Charging\s*|Max\s*)/i, "DC ");
    if (/DC\s*0\s*kW\b/i.test(res)) return "-";
    return res;
  }

  if (/^DC/i.test(s)) {
    const part = s.split('/')[0].trim();
    const res = part.replace(/DC\s*(?:Fast\s*Charging\s*|Max\s*)/i, "DC ");
    if (/DC\s*0\s*kW\b/i.test(res)) return "-";
    return res;
  }

  if (/^AC/i.test(s) && !s.includes("DC")) return "-";
  return s.includes("DC") ? "DC Fast Charging Siap" : "-";
}

// Helper untuk Pengisian AC (Hanya info AC murni)
function cleanAcCharging(chargingStr: string | undefined, wallboxStr: string | undefined, engineType: string = "BEV"): string {
  const eng = String(engineType || "BEV").toLowerCase();
  if (eng.includes("hev") && !eng.includes("phev")) return "-";

  const c = String(chargingStr || "");
  const w = String(wallboxStr || "");

  if (/\b0\s*kW\b/i.test(c) && !/AC\s*[1-9]/i.test(c)) {
    if (!/AC\s*[1-9]/i.test(w)) return "-";
  }

  const acMatch = c.match(/(AC\s*[\d.,]+\s*kW(?:\s*\([^)]+\))?)/i);
  if (acMatch) {
    if (/AC\s*0\s*kW\b/i.test(acMatch[1])) return "-";
    return acMatch[1];
  }

  if (c.includes("/ AC") || c.includes("/AC")) {
    const part = c.split(/\/ ?AC/i)[1]?.trim();
    if (part && !part.startsWith("0")) return `AC ${part}`;
  }

  const kwMatch = (w + " " + c).match(/([1-9][\d.,]*)\s*kW/i);
  if (kwMatch) return `AC ${kwMatch[1]} kW`;

  return "-";
}

// Helper untuk Paket Charger (Portable Charger / Wall Charger / -)
function cleanChargerPackage(wallboxStr: string | undefined, engineType: string = "BEV"): string {
  const s = String(wallboxStr || "");
  const eng = String(engineType || "BEV").toLowerCase();
  if (eng.includes("hev") && !eng.includes("phev")) return "-";
  if (!s || /Bukan Sistem Colok|Tidak Termasuk Paket Wall Charger|Tidak Didukung|Non-PHEV|Non-Colokan/i.test(s)) return "-";

  const isWallboxIncluded = /(?:Termasuk|Gratis|Bonus).*(?:Wallbox|Wall\s*Charger)/i.test(s) && !/(?:Wallbox|Wall\s*Charger)\s*(?:7\s*kW\s*)?Opsional/i.test(s);
  const isOnlyPortable = /Portable|Portabel|Kabel\s*Cas|Charging\s*Kit|Fleksibel/i.test(s) && !isWallboxIncluded;

  if (isWallboxIncluded) return "Wall Charger";
  if (isOnlyPortable) return "Portable Charger";
  if (/(?:Wallbox|Wall\s*Charger)/i.test(s)) return "Wall Charger";
  if (/Portable|Portabel/i.test(s)) return "Portable Charger";
  return "Wall Charger";
}

// Helper untuk Kapasitas Baterai (kWh murni)
function cleanBatteryKwh(str: string | undefined, fallback: any = ""): string {
  const s = String(str || "");
  const match = s.match(/(\d+(?:[.,]\d+)?)\s*kWh/i);
  if (match) return `${match[1]} kWh`;
  if (fallback) return `${fallback} kWh`;
  return "60 kWh";
}

// Helper untuk Tipe Sel Baterai
function cleanBatteryType(str: string | undefined, fallback: any = ""): string {
  const full = `${str || ""} ${fallback || ""}`;
  if (/Blade/i.test(full)) return "LFP (Blade Battery)";
  if (/LFP/i.test(full)) return "LFP (Lithium Iron Phosphate)";
  if (/NMC|Ternary/i.test(full)) return "NMC Lithium-ion";
  if (/Lithium/i.test(full)) return "Lithium-ion";
  return fallback || "Lithium-ion";
}

// Helper untuk V2L
function cleanV2l(str: string | undefined): string {
  const s = String(str || "");
  if (/tidak|non|bukan/i.test(s)) return "Tidak Didukung";
  const kw = s.match(/(\d+(?:[.,]\d+)?)\s*kW/i);
  if (kw) return `Mendukung (${kw[1]} kW)`;
  return "Mendukung (3.3 kW)";
}

const activeVar = sortedVariants[0] || {};
const initWheel = parseCleanWheelSpec(activeVar.wheel_spec || specs.wheel_spec || "Alloy Wheels");
const initPowerOnly = cleanPower(activeVar.power_output, specs.horsepower || car.hp);
const initTorqueOnly = cleanTorque(activeVar.power_output, specs.torque_nm || car.torque);
const initDrivetrainOnly = activeVar.name?.includes("AWD") ? "AWD" : activeVar.name?.includes("RWD") ? "RWD" : (specs.drivetrain || "FWD");
const initBatKwh = cleanBatteryKwh(activeVar.battery_range, specs.battery_capacity_kwh);
const initBatType = cleanBatteryType(activeVar.battery_type, specs.battery_type);
const initRangeClean = cleanRangeOnly(activeVar.battery_range || car.consumption, specs, car.engineType);
const initDcClean = cleanDcCharging(activeVar.charging_time || specs.charging_time, car.engineType);
const initAcClean = cleanAcCharging(activeVar.charging_time || specs.charging_time, activeVar.wall_charger_info || specs.wall_charger_info, car.engineType);
const initPackageClean = cleanChargerPackage(activeVar.wall_charger_info || specs.wall_charger_info, car.engineType);
const initV2lClean = activeVar.v2l_support ? cleanV2l(activeVar.v2l_support) : cleanV2l(specs.v2l_support);

const initialRangeInfo = parseRangeInfo(sortedVariants[0]?.battery_range || car.consumption || specs.electric_range_km, specs.electric_range_km || 400);
const brandLogo = getBrandLogo(car.brand);

const [apiCategories, siteConfig, apiArticles] = await Promise.all([
  fetchCategoriesFromApi(request),
  fetchSiteConfigFromApi(request),
  fetchAllArticlesFromApi(6, request),
]);

const allowFallback = isFallbackDataEnabled();
const articlesPool = apiArticles.length ? apiArticles : allowFallback ? allArticles : [];

// Filter artikel: Prioritaskan artikel yang secara spesifik menyebutkan brand DAN model mobil ini
const brandL = (car.brand || "").toLowerCase().trim();
const nameL = (car.name || "").toLowerCase().trim();
const modelKeywords = nameL.replace(brandL, '').trim();

const matchedArticles = articlesPool.filter((a: any) => {
  const text = `${a.title || ""} ${a.dek || ""} ${a.bodyHtml || ""}`.toLowerCase();
  const hasBrand = brandL && text.includes(brandL);
  const hasModel = modelKeywords ? text.includes(modelKeywords) : text.includes(nameL);
  return hasBrand && hasModel;
});
const brandArticles = articlesPool.filter((a: any) => {
  if (matchedArticles.includes(a)) return false;
  const text = `${a.title || ""} ${a.dek || ""}`.toLowerCase();
  return brandL && text.includes(brandL);
});
const fallbackArticles = articlesPool.filter((a: any) => !matchedArticles.includes(a) && !brandArticles.includes(a));
const relatedNews = [...matchedArticles, ...brandArticles, ...fallbackArticles].slice(0, 6);

// Sibling models from the same brand
const siblingCars = ELECTRIFIED_CARS_DATA.filter((c: any) =>
  (c.brand || "").toLowerCase() === (car.brand || "").toLowerCase() && c.slug !== car.slug
).slice(0, 6);

// Adjacent cars for Next/Prev switcher
const currentCarIdx = ELECTRIFIED_CARS_DATA.findIndex((c: any) => c.slug === car.slug || c.id === car.id);
const totalCarsCount = ELECTRIFIED_CARS_DATA.length;
const prevCar = ELECTRIFIED_CARS_DATA[(currentCarIdx - 1 + totalCarsCount) % totalCarsCount];
const nextCar = ELECTRIFIED_CARS_DATA[(currentCarIdx + 1) % totalCarsCount];

const brochureUrl = car.brochureUrl || (car as any).brochure_url || `/brosur/${encodeURIComponent(car.name)}.pdf`;

// Galeri Foto Mobil (Interior, Eksterior, Fitur) dari backend CMS
const carPhotos: any[] = [];
if (Array.isArray(car.gallery) && car.gallery.length > 0) {
  carPhotos.push(...car.gallery);
} else if (car.gallery_json) {
  try {
    const parsed = typeof car.gallery_json === 'string' ? JSON.parse(car.gallery_json) : car.gallery_json;
    if (Array.isArray(parsed)) carPhotos.push(...parsed);
  } catch (e) {}
}

variants.forEach((v: any) => {
  if (Array.isArray(v.gallery) && v.gallery.length > 0) {
    v.gallery.forEach((vg: any) => {
      if (vg && vg.url && !carPhotos.some((cp: any) => cp.url === vg.url)) {
        carPhotos.push({ ...vg, caption: vg.caption || `Trim ${v.name}` });
      }
    });
  } else if (v.gallery_json) {
    try {
      const parsed = typeof v.gallery_json === 'string' ? JSON.parse(v.gallery_json) : v.gallery_json;
      if (Array.isArray(parsed)) {
        parsed.forEach((vg: any) => {
          if (vg && vg.url && !carPhotos.some((cp: any) => cp.url === vg.url)) {
            carPhotos.push({ ...vg, caption: vg.caption || `Trim ${v.name}` });
          }
        });
      }
    } catch (e) {}
  }
});

