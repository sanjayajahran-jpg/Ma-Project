            <span class="text-[10px] text-slate-400 font-mono hidden sm:inline">Database Otomotif Resmi</span>
            <button
              type="button"
              class="section-collapse-toggle sm:hidden px-2 py-0.5 rounded-lg bg-white/5 hover:bg-white/10 text-[9px] font-bold text-slate-300 border border-white/10 flex items-center gap-1 cursor-pointer"
              data-collapse-id="collapsible-spek-tables"
              aria-expanded="true"
            >
              <span>Tutup Detail</span>
              <svg class="w-3 h-3 text-slate-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- 3 Grid Sections: Dimensi, Powertrain, Baterai (Collapsible) -->
