            <h4 class="text-xs font-bold text-sky-500 dark:text-sky-400 uppercase tracking-wider flex items-center gap-1.5 pb-1 border-b border-slate-200/60 dark:border-white/10">
              <span>Dimensi & Bobot</span>
            </h4>
            <div class="text-xs">
              <div class="py-2 flex items-start justify-between gap-2.5 border-b border-slate-200/60 dark:border-white/5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">P × L × T</span>
                <span class="text-slate-900 dark:text-white font-semibold text-right">{specs.length_mm || 4500} × {specs.width_mm || 1850} × {specs.height_mm || 1600} mm</span>
              </div>
              <div class="py-2 flex items-start justify-between gap-2.5 border-b border-slate-200/60 dark:border-white/5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">Wheelbase</span>
                <span class="text-slate-900 dark:text-white font-semibold text-right">{specs.wheelbase_mm || 2750} mm</span>
              </div>
              <div class="py-2 flex items-start justify-between gap-2.5 border-b border-slate-200/60 dark:border-white/5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">Ground Clearance</span>
                <span class="text-slate-900 dark:text-white font-semibold text-right">{specs.ground_clearance_mm || 165} mm</span>
              </div>
              <div class="py-2 flex items-start justify-between gap-2.5 border-b border-slate-200/60 dark:border-white/5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">Kapasitas Duduk</span>
                <span class="text-slate-900 dark:text-white font-semibold text-right">{specs.seating_capacity || 5} Penumpang</span>
              </div>
              <div class="py-2 flex items-start justify-between gap-2.5 border-b border-slate-200/60 dark:border-white/5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">Volume Bagasi</span>
                <span class="text-slate-900 dark:text-white font-semibold text-right">{specs.trunk_volume_liters || 440} Liter</span>
              </div>
              <div class="py-2 flex items-start justify-between gap-2.5">
                <span class="text-slate-500 dark:text-slate-400 shrink-0 font-medium">Ukuran Roda</span>
