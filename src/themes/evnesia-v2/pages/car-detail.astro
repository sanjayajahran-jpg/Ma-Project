</BaseLayout>

<script is:inline>
  function formatClientAdas(rawAdas) {
    if (!rawAdas) return '<span class="text-slate-500 dark:text-slate-400 font-medium">Standard Safety Suite</span>';
    const trimmed = String(rawAdas).trim();
    if (trimmed.includes(':')) {
      const colonIdx = trimmed.indexOf(':');
      const suiteName = trimmed.slice(0, colonIdx).trim();
      const details = trimmed.slice(colonIdx + 1).trim();
      const features = details.split(/,\s*(?![^()]*\))/).map(f => f.trim()).filter(Boolean);
      let pillsHtml = '';
      if (features.length > 0) {
        pillsHtml = '<div class="flex flex-wrap gap-1.5 sm:justify-end mt-2">' +
          features.map(f => `<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/10 shadow-2xs">${f}</span>`).join('') +
          '</div>';
      }
      return `<div class="sm:text-right"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-500/30 shadow-2xs"><span class="w-1.5 h-1.5 rounded-full bg-sky-500 dark:bg-sky-400"></span>${suiteName}</span>${pillsHtml}</div>`;
    }
    if (trimmed.includes(',')) {
      const features = trimmed.split(/,\s*(?![^()]*\))/).map(f => f.trim()).filter(Boolean);
      return '<div class="flex flex-wrap gap-1.5 sm:justify-end">' +
        features.map(f => `<span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/10">${f}</span>`).join('') +
        '</div>';
    }
    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-500/30"><span class="w-1.5 h-1.5 rounded-full bg-sky-500 dark:bg-sky-400"></span>${trimmed}</span>`;
  }

  function initTrimLadder() {
    const stepButtons = document.querySelectorAll('.trim-step-btn');
    if (!stepButtons.length) return;

    const priceDisplay = document.getElementById('detail-active-price');
    const diffLabel = document.getElementById('trim-diff-label');
    const powerDisplay = document.getElementById('detail-active-power');
    const torqueDisplay = document.getElementById('detail-active-torque');
    const rangeDisplay = document.getElementById('detail-active-range');
    const rangeCycleDisplay = document.getElementById('detail-active-range-cycle');
    const driveBadge = document.getElementById('detail-active-drive-badge');

    // Selected Trim Panel Elements
    const panelName = document.getElementById('trim-panel-name');
    const panelPrice = document.getElementById('trim-panel-price');
    const panelBattery = document.getElementById('trim-spec-battery');
    const panelPower = document.getElementById('trim-spec-power');
    const panelWheel = document.getElementById('trim-spec-wheel');
    const panelInterior = document.getElementById('trim-spec-interior');
    const panelSunroof = document.getElementById('trim-spec-sunroof');
    const panelHighlights = document.getElementById('trim-spec-highlights');

    // Technical Spec Table Elements
    const specPower = document.getElementById('detail-spec-power');
    const specTorque = document.getElementById('detail-spec-torque');
    const specDrivetrain = document.getElementById('detail-active-drivetrain');
    const specWheel = document.getElementById('detail-spec-wheel');
    const specBatteryCap = document.getElementById('detail-spec-battery-cap');
    const specBatteryType = document.getElementById('detail-spec-battery-type');
    const specRange = document.getElementById('detail-spec-range');
    const specCharging = document.getElementById('detail-spec-charging');
    const specAc = document.getElementById('detail-spec-ac');
    const specPackage = document.getElementById('detail-spec-package');
    const specAdas = document.getElementById('detail-spec-adas');
    const specTax = document.getElementById('detail-spec-tax');

    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        stepButtons.forEach((b) => {
          b.classList.remove('active-trim', 'bg-blue-500/15', 'dark:bg-blue-600/30', 'border-blue-500', 'dark:border-blue-400', 'text-blue-900', 'dark:text-white', 'shadow-sm', 'ring-1', 'ring-blue-400/40');
          b.classList.add('bg-slate-100', 'dark:bg-slate-900/90', 'border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-400');
          const circle = b.querySelector('span:first-child');
          circle?.classList.remove('bg-blue-600', 'text-white');
          circle?.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });

        btn.classList.add('active-trim', 'bg-blue-500/15', 'dark:bg-blue-600/30', 'border-blue-500', 'dark:border-blue-400', 'text-blue-900', 'dark:text-white', 'shadow-sm', 'ring-1', 'ring-blue-400/40');
        btn.classList.remove('bg-slate-100', 'dark:bg-slate-900/90', 'border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-400');
        const activeCircle = btn.querySelector('span:first-child');
        activeCircle?.classList.add('bg-blue-600', 'text-white');
        activeCircle?.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');

        const name = btn.getAttribute('data-name');
        const price = btn.getAttribute('data-price');
        const diff = btn.getAttribute('data-diff');
        const power = btn.getAttribute('data-power');
        const battery = btn.getAttribute('data-battery');
        const rangeNum = btn.getAttribute('data-range-num');
        const rangeCycle = btn.getAttribute('data-range-cycle');
        const charging = btn.getAttribute('data-charging');
        const wallbox = btn.getAttribute('data-wallbox');
        const wheel = btn.getAttribute('data-wheel');
        const wheelInch = btn.getAttribute('data-wheel-inch');
        const wheelFront = btn.getAttribute('data-wheel-front');
        const wheelRear = btn.getAttribute('data-wheel-rear');
        const wheelSingle = btn.getAttribute('data-wheel-single');
        const powerOnly = btn.getAttribute('data-power-only');
        const torqueOnly = btn.getAttribute('data-torque-only');
        const rangeClean = btn.getAttribute('data-range-clean');
        const dcClean = btn.getAttribute('data-dc-clean');
        const acClean = btn.getAttribute('data-ac-clean');
        const packageClean = btn.getAttribute('data-package-clean');
        const batKwh = btn.getAttribute('data-bat-kwh');
        const batType = btn.getAttribute('data-bat-type');
        const interior = btn.getAttribute('data-interior');
        const sunroof = btn.getAttribute('data-sunroof');
        const highlights = btn.getAttribute('data-chip');
        const adas = btn.getAttribute('data-adas');
        const tax = btn.getAttribute('data-tax');
        const drivetrain = btn.getAttribute('data-drivetrain');

        const mainImg = document.getElementById('detail-main-img');
        if (mainImg) {
          mainImg.style.transform = 'scale(0.97)';
          mainImg.style.opacity = '0.75';
          setTimeout(() => {
            mainImg.style.transform = 'scale(1)';
            mainImg.style.opacity = '1';
          }, 180);
        }

        // 1. Update Price in Header and Mobile Floating Dock
        if (priceDisplay && price) priceDisplay.textContent = price;
        const dockPrice = document.getElementById('dock-active-price');
        if (dockPrice && price) dockPrice.textContent = price;
        if (diffLabel && diff) diffLabel.textContent = diff;

        // 2. Update Gauge Instruments (NO 19271000 bug!)
        if (rangeDisplay && rangeNum) rangeDisplay.textContent = rangeNum;
        if (rangeCycleDisplay && rangeCycle) rangeCycleDisplay.textContent = `km (${rangeCycle})`;

        if (powerDisplay && power) {
          const powerParts = power.split('/');
          powerDisplay.textContent = powerOnly || powerParts[0]?.trim() || power;
          if (torqueDisplay && (torqueOnly || powerParts[1])) {
            torqueDisplay.textContent = torqueOnly || powerParts[1].trim();
          }
        }
        if (driveBadge && drivetrain) driveBadge.textContent = drivetrain;

        // 3. Update Selected Trim Details Panel
        if (panelName && name) panelName.textContent = name;
        if (panelPrice && price) panelPrice.textContent = price;
        if (panelBattery) panelBattery.textContent = rangeClean || battery;
        if (panelPower) {
          panelPower.textContent = (powerOnly && torqueOnly) ? `${powerOnly} / ${torqueOnly}` : power;
        }
        if (panelWheel && (wheel || wheelInch)) {
          panelWheel.textContent = wheel || wheelInch;
        }
        if (panelInterior && interior) panelInterior.textContent = interior;
        if (panelSunroof && sunroof) panelSunroof.textContent = sunroof;
        if (panelHighlights && highlights) panelHighlights.textContent = highlights;

        // 4. Update Technical Specs Table Below with Clean Non-Gimmick Values
        if (specPower && (powerOnly || power)) {
          specPower.textContent = powerOnly || power.split('/')[0]?.trim() || power;
        }
        if (specTorque && (torqueOnly || power)) {
          specTorque.textContent = torqueOnly || power.split('/')[1]?.trim() || "-";
        }
        if (specDrivetrain && drivetrain) specDrivetrain.textContent = drivetrain;
        if (specBatteryCap && batKwh) specBatteryCap.textContent = batKwh;
        if (specBatteryType && batType) specBatteryType.textContent = batType;
        if (specRange && rangeClean) specRange.textContent = rangeClean;
        if (specCharging && dcClean) specCharging.textContent = dcClean;
        if (specAc && acClean) specAc.textContent = acClean;
        if (specPackage && packageClean) specPackage.textContent = packageClean;
        if (specAdas && adas) specAdas.innerHTML = formatClientAdas(adas);
        if (specTax && tax) specTax.textContent = tax;

        if (specWheel) {
          if (wheelFront && wheelRear) {
            specWheel.innerHTML = `
              <div>
                <span class="font-bold text-slate-900 dark:text-white block">${wheelInch || 'Alloy Wheels'}</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400 block leading-tight">${wheelFront}</span>
                <span class="text-[11px] text-slate-500 dark:text-slate-400 block leading-tight">${wheelRear}</span>
              </div>
            `;
          } else {
            specWheel.innerHTML = `
              <span class="font-bold text-slate-900 dark:text-white block">
                ${wheelInch || 'Alloy Wheels'}${wheelSingle ? ' (' + wheelSingle + ')' : ''}
              </span>
            `;
          }
        }
      });
    });
  }

  function initCarSwitcher() {
    const prevBtn = document.getElementById('car-nav-prev');
    const nextBtn = document.getElementById('car-nav-next');
    const stageBox = document.getElementById('detail-stage-box');
    const mainImg = document.getElementById('detail-main-img');

    function animateAndNavigate(btn, direction) {
      if (!btn) return;
      if (mainImg) {
        mainImg.style.transform = direction === 'next' ? 'translateX(-30px) scale(0.95)' : 'translateX(30px) scale(0.95)';
        mainImg.style.opacity = '0.3';
      }
      setTimeout(() => {
        btn.click();
      }, 140);
    }

    // Keyboard Arrow navigation (ArrowLeft = prev, ArrowRight = next)
    function handleKey(e) {
      if (['input', 'textarea', 'select'].includes(document.activeElement?.tagName?.toLowerCase())) return;
      if (e.key === 'ArrowLeft' && prevBtn) {
        prevBtn.click();
      } else if (e.key === 'ArrowRight' && nextBtn) {
        nextBtn.click();
      }
    }
    window.addEventListener('keydown', handleKey);

    // Touch Swipe gesture on stageBox
    if (stageBox) {
      let touchStartX = 0;
      let touchEndX = 0;

      stageBox.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      stageBox.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 45) {
          if (diffX < 0 && nextBtn) {
            nextBtn.click(); // Swipe left -> Next car
          } else if (diffX > 0 && prevBtn) {
            prevBtn.click(); // Swipe right -> Prev car
          }
        }
      }, { passive: true });
    }
  }

  function initStickyTabs() {
    const tabs = document.querySelectorAll('.sticky-tab-btn');
    const tabsRail = document.getElementById('sticky-tabs-rail');
    if (!tabs.length) return;

    let isClickScrolling = false;
    let clickScrollTimer = null;

    // High-fluidity Smooth Scroll Helper (Cubic-bezier Easing: 0.25, 1, 0.5, 1)
    function smoothScrollTo(targetY, duration = 650) {
      const startY = window.pageYOffset || document.documentElement.scrollTop;
      const distance = targetY - startY;
      if (Math.abs(distance) < 2) {
        isClickScrolling = false;
        return;
      }

      let startTime = null;

      // EaseOutQuart: Meluncur cepat di awal lalu melambat sangat halus di akhir
      function easeOutQuart(t) {
        return 1 - (--t) * t * t * t;
      }

      function step(currentTime) {
        if (!startTime) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = easeOutQuart(progress);
        
        window.scrollTo(0, Math.round(startY + distance * ease));

        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          window.scrollTo(0, Math.round(targetY));
          setTimeout(() => {
            isClickScrolling = false;
          }, 80);
        }
      }

      window.requestAnimationFrame(step);
    }

    // Smooth click handler with auto-expansion of target section if collapsed
    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = tab.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        isClickScrolling = true;
        if (clickScrollTimer) clearTimeout(clickScrollTimer);
        clickScrollTimer = setTimeout(() => { isClickScrolling = false; }, 850);

        // Auto-expand any collapsed contents in target section
        const collapsedContents = targetEl.querySelectorAll('.collapsible-content');
        collapsedContents.forEach((c) => {
          c.classList.remove('hidden');
          const toggleBtn = targetEl.querySelector(`[data-collapse-id="${c.id}"]`);
          if (toggleBtn) {
            toggleBtn.setAttribute('aria-expanded', 'true');
            const span = toggleBtn.querySelector('span');
            if (span) span.textContent = 'Tutup Detail';
            const svg = toggleBtn.querySelector('svg');
            if (svg) svg.classList.remove('rotate-180');
          }
        });

        // Set visual active tab immediately & gently scroll the tab rail horizontally
        setActiveTab(targetId, true);

        // Hitung posisi setelah DOM reflow
        window.requestAnimationFrame(() => {
          const stickyNav = document.getElementById('car-detail-sticky-tabs');
          const navH = stickyNav ? stickyNav.offsetHeight : 44;
          const headerOffset = 58 + navH + 6;
          const elementPosition = targetEl.getBoundingClientRect().top;
          const targetY = Math.max(0, elementPosition + (window.pageYOffset || document.documentElement.scrollTop) - headerOffset);

          smoothScrollTo(targetY, 600);
        });
      });
    });

    function setActiveTab(activeId, shouldScrollRail = true) {
      tabs.forEach((t) => {
        const isMatch = t.getAttribute('data-target') === activeId;
        if (isMatch) {
          t.classList.add('border-sky-400/50', 'bg-sky-500/20', 'text-sky-300', 'shadow-sm', 'shadow-sky-500/20', 'font-bold');
          t.classList.remove('border-transparent', 'text-slate-400', 'font-medium');
          t.setAttribute('aria-selected', 'true');

          // Geser rel HANYA horizontal jika tab keluar dari layar, JANGAN scroll vertikal parent!
          if (shouldScrollRail && tabsRail) {
            const railRect = tabsRail.getBoundingClientRect();
            const tabRect = t.getBoundingClientRect();
            // Cek jika tab berada di luar batas pandang rel horizontal
            if (tabRect.left < railRect.left || tabRect.right > railRect.right) {
              const scrollLeftTarget = tabsRail.scrollLeft + (tabRect.left - railRect.left) - (railRect.width / 2) + (tabRect.width / 2);
              tabsRail.scrollTo({ left: scrollLeftTarget, behavior: 'smooth' });
            }
          }
        } else {
          t.classList.remove('border-sky-400/50', 'bg-sky-500/20', 'text-sky-300', 'shadow-sm', 'shadow-sky-500/20', 'font-bold');
          t.classList.add('border-transparent', 'text-slate-400', 'font-medium');
          t.setAttribute('aria-selected', 'false');
        }
      });
    }

    // Scroll-Spy with IntersectionObserver (tidak mengganggu animasi klik)
    const sectionIds = ['ringkasan', 'varian', 'spek', 'fitur', 'galeri', 'aksesoris', 'berita'];
    const sectionEls = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

    if ('IntersectionObserver' in window && sectionEls.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        if (isClickScrolling) return; // Abaikan saat user sedang klik tombol tab
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveTab(entry.target.id, false);
          }
        });
      }, {
        rootMargin: '-80px 0px -55% 0px',
        threshold: 0
      });

      sectionEls.forEach(el => observer.observe(el));
    }
  }

  function initCollapsibleSections() {
    const globalToggle = document.getElementById('btn-toggle-dense-collapse');
    const toggleButtons = document.querySelectorAll('.section-collapse-toggle');
    const collapsibleContents = document.querySelectorAll('.collapsible-content');
    let isAllCollapsed = false;

    // Global toggle (Ringkas Detail / Buka Detail)
    if (globalToggle) {
      globalToggle.addEventListener('click', () => {
        isAllCollapsed = !isAllCollapsed;
        const icon = document.getElementById('icon-collapse-state');
        const label = document.getElementById('label-collapse-state');

        collapsibleContents.forEach((c) => {
          if (isAllCollapsed) {
            c.classList.add('hidden');
          } else {
            c.classList.remove('hidden');
          }
        });

        toggleButtons.forEach((btn) => {
          btn.setAttribute('aria-expanded', String(!isAllCollapsed));
          const span = btn.querySelector('span');
          if (span) span.textContent = isAllCollapsed ? 'Buka Detail' : 'Tutup Detail';
          const svg = btn.querySelector('svg');
          if (svg) {
            if (isAllCollapsed) {
              svg.classList.add('rotate-180');
            } else {
              svg.classList.remove('rotate-180');
            }
          }
        });

        if (label) label.textContent = isAllCollapsed ? 'Buka Detail' : 'Ringkas Detail';
        if (icon) {
          if (isAllCollapsed) {
            icon.classList.add('rotate-180');
          } else {
            icon.classList.remove('rotate-180');
          }
        }
        globalToggle.setAttribute('aria-expanded', String(!isAllCollapsed));
      });
    }

    // Individual section collapse toggles
    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-collapse-id');
        const targetContent = document.getElementById(targetId);
        if (!targetContent) return;

        const isCurrentlyHidden = targetContent.classList.contains('hidden');
        if (isCurrentlyHidden) {
          targetContent.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          const span = btn.querySelector('span');
          if (span) span.textContent = 'Tutup Detail';
          const svg = btn.querySelector('svg');
          if (svg) svg.classList.remove('rotate-180');
        } else {
          targetContent.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          const span = btn.querySelector('span');
          if (span) span.textContent = 'Buka Detail';
          const svg = btn.querySelector('svg');
          if (svg) svg.classList.add('rotate-180');
        }
      });
    });
  }

  function initMobileQuickBar() {
    const quickBar = document.getElementById('mobile-quick-action-bar');
    const heroSection = document.getElementById('ringkasan');
    if (!quickBar || !heroSection) return;

    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) {
        quickBar.classList.remove('translate-y-24', 'opacity-0');
        quickBar.classList.add('translate-y-0', 'opacity-100');
      } else {
        quickBar.classList.remove('translate-y-0', 'opacity-100');
        quickBar.classList.add('translate-y-24', 'opacity-0');
      }
    }, { threshold: 0.1 });

    observer.observe(heroSection);
  }

  function initAll() {
    initTrimLadder();
    initCarSwitcher();
    initStickyTabs();
    initCollapsibleSections();
    initMobileQuickBar();
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 110px;
  }

  section[id] {
    scroll-margin-top: 110px;
  }

  #car-detail-sticky-tabs {
    will-change: transform;
  }

  #sticky-tabs-rail {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .sticky-tab-btn {
    transition: background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

