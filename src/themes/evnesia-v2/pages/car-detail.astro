// Helper to format ADAS feature list into clean badges and pills for all cars
function formatAdasHtml(rawAdas: any) {
  if (!rawAdas) return `<span class="text-slate-500 dark:text-slate-400 font-medium">Standard Safety Suite</span>`;
  
  const trimmed = String(rawAdas).trim();
  if (trimmed.includes(':')) {
    const colonIdx = trimmed.indexOf(':');
    const suiteName = trimmed.slice(0, colonIdx).trim();
    const details = trimmed.slice(colonIdx + 1).trim();

    const features = details.split(/,\s*(?![^()]*\))/).map(f => f.trim()).filter(Boolean);

    let pillsHtml = '';
    if (features.length > 0) {
      pillsHtml = `
        <div class="flex flex-wrap gap-1.5 sm:justify-end mt-2">
          ${features.map(f => `
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/10 shadow-2xs">
              ${f}
            </span>
          `).join('')}
        </div>
      `;
    }

    return `
      <div class="sm:text-right">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-500/30 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-500 dark:bg-sky-400"></span>
          ${suiteName}
        </span>
        ${pillsHtml}
      </div>
    `;
  }

  // Jika tidak ada titik dua tapi ada koma-koma pemisah
  if (trimmed.includes(',')) {
    const features = trimmed.split(/,\s*(?![^()]*\))/).map(f => f.trim()).filter(Boolean);
    return `
      <div class="flex flex-wrap gap-1.5 sm:justify-end">
        ${features.map(f => `
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 dark:bg-white/10 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-white/10">
            ${f}
          </span>
        `).join('')}
      </div>
    `;
  }

  return `
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold bg-sky-50 dark:bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-500/30">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-500 dark:bg-sky-400"></span>
      ${trimmed}
    </span>
  `;
}
