---
// archive.astro — EVnesia V2 Central News Archive & Timeline (/indeks, /berita, /arsip)
const { request, params } = Astro.props as any;

import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, allArticles } from "@/data";
import {
  fetchAllArticlesFromApi,
  fetchCategoriesFromApi,
  fetchSiteConfigFromApi,
  isFallbackDataEnabled,
} from "@/lib/api";

const [sourceArticles, sourceCategories, siteConfig] = await Promise.all([
  fetchAllArticlesFromApi(60, request),
  fetchCategoriesFromApi(request),
  fetchSiteConfigFromApi(request),
]);

const allowFallback = isFallbackDataEnabled();
const articles = sourceArticles.length ? sourceArticles : allowFallback ? allArticles : [];
const allCats = sourceCategories.length ? sourceCategories : allowFallback ? categories : [];

const CATEGORY_TABS = [
  { label: "Semua Kategori", slug: "all" },
  { label: "Berita", slug: "berita" },
  { label: "Ulasan Test Drive", slug: "ulasan" },
  { label: "SPKLU", slug: "spklu" },
  { label: "Panduan", slug: "panduan" },
  { label: "Teknologi", slug: "teknologi" },
];
---

<BaseLayout
  title="Indeks Berita & Arsip Otomotif — EVHub.id"
  description="Kumpulan lengkap seluruh berita, artikel ulasan test drive, ekosistem stasiun pengisian SPKLU, dan panduan mobil listrik Indonesia."
  siteConfig={siteConfig}
  navCategories={allCats}
>
  <div class="pt-14 sm:pt-16 pb-28 sm:pb-20">
    <div class="mx-auto max-w-5xl px-3 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="py-2.5 flex items-center gap-1.5 text-xs text-slate-400">
        <a href="/?theme_preview=evnesia-v2" class="hover:text-white transition-colors">Beranda</a>
        <span class="text-slate-600">›</span>
        <span class="text-sky-400 font-semibold">Indeks Berita & Liputan</span>
      </nav>

      <!-- Archive Header -->
      <div class="relative overflow-hidden rounded-2xl glass p-4 sm:p-6 border border-white/10 bg-linear-to-b from-slate-900/90 via-slate-950 to-slate-950 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-sky-400 block mb-1">
              Arsip & Kronologi Berita
            </span>
            <h1 class="text-xl sm:text-3xl font-black text-white tracking-tight">
              Portal Berita Mobil Listrik
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">
              Telusuri liputan terpercaya, ulasan performa, dan regulasi industri kendaraan listrik nasional.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-slate-300">
              {articles.length} Artikel Terkini
            </span>
          </div>
        </div>

        <!-- Category Tabs -->
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center gap-1.5 overflow-x-auto scrollbar-none py-1">
          {CATEGORY_TABS.map((tab) => (
            <a
              href={tab.slug === "all" ? "/indeks" : `/kategori/${tab.slug}`}
              class="shrink-0 px-3 py-1 rounded-full text-xs font-bold bg-slate-900/90 text-slate-400 hover:text-white border border-white/10 hover:border-white/20 transition-all"
            >
              {tab.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {articles.map((art: any) => {
          const catSlug = art.category?.slug || (typeof art.category === 'string' ? art.category.toLowerCase() : 'berita');
          const artHref = `/${catSlug}/${art.slug || art.id}`;
          const imgUrl = art.cover || art.image || "/images/cars/default-car.png";
          const pubDate = art.publishedAt || art.published_at;
          const formattedDate = pubDate 
            ? new Date(pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
            : "Terkini";

          return (
            <a
              href={artHref}
              class="group glass-card rounded-2xl p-3 border border-white/10 hover:border-sky-400/40 active:scale-98 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="w-full h-36 rounded-xl overflow-hidden bg-slate-900 border border-white/10 relative mb-2.5">
                  <img
                    src={imgUrl}
                    alt={art.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-slate-950/80 backdrop-blur-md text-[9px] font-bold text-sky-300 border border-white/15">
                    {art.category?.name || art.category || "Berita"}
                  </span>
                  <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-[9px] font-mono text-slate-300">
                    {art.readingTime || 3} mnt
                  </span>
                </div>

                <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-sky-300 transition-colors line-clamp-2 leading-snug">
                  {art.title}
                </h3>

                <p class="text-[11px] text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                  {art.dek || art.excerpt || ""}
                </p>
              </div>

              <div class="pt-2.5 mt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-slate-400">
                <span class="font-medium text-slate-300 truncate max-w-35">
                  {art.author?.name || "Redaksi"}
                </span>
                <span class="font-mono text-slate-500 shrink-0">
                  {formattedDate}
                </span>
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </div>
</BaseLayout>
