</BaseLayout>

<script is:inline define:vars={{ ALL_CARS, initialCar1Slug: initialCar1.slug, initialCar2Slug: initialCar2.slug }}>
  function initComparator() {
    const carMap = new Map(ALL_CARS.map(c => [c.slug, c]));
    
    // State mobil yang sedang aktif
    let currentCar1 = initialCar1Slug;
    let currentCar2 = initialCar2Slug;

    // Check query params dynamically in browser
    const urlParams = new URLSearchParams(window.location.search);
    const q1 = urlParams.get('car1') || urlParams.get('car_a') || urlParams.get('slug');
    const q2 = urlParams.get('car2') || urlParams.get('car_b');
    if (q1 && carMap.has(q1)) currentCar1 = q1;
    if (q2 && carMap.has(q2)) currentCar2 = q2;

    // Target modal aktif (1 = Kendaraan A, 2 = Kendaraan B)
    let activeModalTarget = 1;

    // Elements
    const modal = document.getElementById('car-picker-modal');
    const modalTitle = document.getElementById('modal-target-badge');
    const btnClose = document.getElementById('btn-close-picker');
    const searchInput = document.getElementById('picker-search-input');
    const carsContainer = document.getElementById('picker-cars-container');
    const emptyState = document.getElementById('picker-empty-state');
    const resetSearchBtn = document.getElementById('btn-reset-picker-search');

    function updateUrlState() {
      try {
        const u = new URL(window.location.href);
        u.searchParams.set('car1', currentCar1);
        u.searchParams.set('car2', currentCar2);
        window.history.replaceState({}, '', u.toString());
      } catch {}
    }

    function updateCarDisplay(num, slug) {
      const car = carMap.get(slug);
      if (!car) return;

      if (num === 1) currentCar1 = slug;
      if (num === 2) currentCar2 = slug;

      // Update Card Preview
      const imgEl = document.getElementById(`img-car-${num}`);
      if (imgEl) {
        imgEl.src = car.image;
        imgEl.alt = car.name;
      }
      const nameEl = document.getElementById(`name-car-${num}`);
      if (nameEl) nameEl.textContent = car.name;
      const stickyNameEl = document.getElementById(`sticky-name-car-${num}`);
      if (stickyNameEl) stickyNameEl.textContent = car.name;
      const priceEl = document.getElementById(`price-car-${num}`);
      if (priceEl) priceEl.textContent = car.price;
      const badgeEl = document.getElementById(`badge-engine-${num}`);
      if (badgeEl) badgeEl.textContent = car.engineType;

      // Update Technical Table
      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val || "-";
      };

      setTxt(`spec-engine-${num}`, car.engineLabel);
      setTxt(`spec-price-${num}`, car.price);
      setTxt(`spec-body-${num}`, car.bodyType);
      setTxt(`spec-assembly-${num}`, car.assembly);
      setTxt(`spec-tax-${num}`, car.annualTax);

      setTxt(`spec-hp-${num}`, car.hp);
      setTxt(`spec-torque-${num}`, car.torque);
      setTxt(`spec-acc-${num}`, car.acc);
      setTxt(`spec-speed-${num}`, car.topSpeed);
      setTxt(`spec-drive-${num}`, car.drivetrain);
      setTxt(`spec-trans-${num}`, car.transmission);

      setTxt(`spec-range-${num}`, car.range);
      setTxt(`spec-battery-${num}`, car.battery);
      setTxt(`spec-batt-type-${num}`, car.batteryType);
      setTxt(`spec-chg-${num}`, car.charging);
      setTxt(`spec-v2l-${num}`, car.v2l);

      setTxt(`spec-dim-${num}`, car.dimensions);
      setTxt(`spec-wheelbase-${num}`, car.wheelbase);
      setTxt(`spec-gc-${num}`, car.groundClearance);
      setTxt(`spec-seat-${num}`, car.seating);
      setTxt(`spec-trunk-${num}`, car.trunk);

      setTxt(`spec-adas-${num}`, car.adas);
      setTxt(`spec-airbags-${num}`, car.airbags);
      setTxt(`spec-gar-batt-${num}`, car.batteryWarranty);
      setTxt(`spec-gar-veh-${num}`, car.vehicleWarranty);

      const linkEl = document.getElementById(`link-detail-${num}`);
      if (linkEl) {
        linkEl.href = `/mobil/${car.slug}`;
        linkEl.textContent = `Buka Spek ${car.brand} →`;
      }

      updateUrlState();
    }

    // Modal Handlers
    function openPicker(targetNum) {
      activeModalTarget = targetNum;
      if (modalTitle) {
        modalTitle.textContent = targetNum === 1 ? 'Kendaraan A' : 'Kendaraan B';
        modalTitle.className = targetNum === 1
          ? 'px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-cyan-500/15 text-cyan-600 dark:text-cyan-400'
          : 'px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-500/15 text-emerald-600 dark:text-emerald-400';
      }
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
      if (searchInput) {
        searchInput.value = '';
        setTimeout(() => searchInput.focus(), 100);
      }
      filterCars();
    }

    function closePicker() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    // Attach Open Trigger Buttons
    const btnOpen1 = document.getElementById('btn-open-picker-1');
    const btnOpen2 = document.getElementById('btn-open-picker-2');
    if (btnOpen1) btnOpen1.addEventListener('click', () => openPicker(1));
    if (btnOpen2) btnOpen2.addEventListener('click', () => openPicker(2));

    if (btnClose) btnClose.addEventListener('click', closePicker);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closePicker();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePicker();
    });

    // Filtering logic
    let activeEngineFilter = 'all';
    let activeBrandFilter = 'all';

    function filterCars() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const items = document.querySelectorAll('.picker-car-item');
      let visibleCount = 0;

      items.forEach((item) => {
        const name = item.dataset.name || '';
        const brand = item.dataset.brand || '';
        const engine = item.dataset.engine || '';

        const matchQuery = !query || name.includes(query) || brand.includes(query);
        const matchEngine = activeEngineFilter === 'all' || engine.includes(activeEngineFilter);
        const matchBrand = activeBrandFilter === 'all' || brand === activeBrandFilter;

        if (matchQuery && matchEngine && matchBrand) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterCars);
    }

    // Filter Buttons (Powertrain)
    document.querySelectorAll('.picker-filter-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.picker-filter-btn').forEach(b => {
          b.className = 'picker-filter-btn shrink-0 px-2.5 py-1 rounded-lg font-bold border transition text-[11px] bg-white/5 text-slate-300 border-white/10 hover:border-cyan-500';
        });
        e.currentTarget.className = 'picker-filter-btn shrink-0 px-2.5 py-1 rounded-lg font-bold border transition text-[11px] bg-cyan-600 text-white border-cyan-600 shadow-sm';
        activeEngineFilter = e.currentTarget.dataset.filter || 'all';
        filterCars();
      });
    });

    // Brand Pills
    document.querySelectorAll('.brand-filter-pill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.brand-filter-pill').forEach(b => {
          b.className = 'brand-filter-pill shrink-0 px-2 py-1 rounded-xl font-bold bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 hover:border-cyan-400/50 transition-all flex items-center gap-1.5 cursor-pointer';
        });
        e.currentTarget.className = 'brand-filter-pill shrink-0 px-2.5 py-1 rounded-xl font-bold bg-cyan-500/25 text-cyan-300 border border-cyan-400/50 transition-all flex items-center gap-1.5 cursor-pointer shadow-xs';
        activeBrandFilter = e.currentTarget.dataset.brand || 'all';
        filterCars();
      });
    });

    if (resetSearchBtn) {
      resetSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeEngineFilter = 'all';
        activeBrandFilter = 'all';
        filterCars();
      });
    }

    // Car Item Click inside Picker
    document.querySelectorAll('.picker-car-item').forEach((item) => {
      item.addEventListener('click', (e) => {
        const slug = e.currentTarget.dataset.slug;
        if (!slug) return;
        updateCarDisplay(activeModalTarget, slug);
        closePicker();
      });
    });

    // Quick Presets
    document.querySelectorAll('.preset-compare-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const c1 = e.currentTarget.dataset.car1;
        const c2 = e.currentTarget.dataset.car2;
        if (c1) updateCarDisplay(1, c1);
        if (c2) updateCarDisplay(2, c2);
      });
    });

    // Initial render from resolved cars
    updateCarDisplay(1, currentCar1);
    updateCarDisplay(2, currentCar2);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComparator);
  } else {
    initComparator();
  }
  document.addEventListener('astro:after-swap', initComparator);
</script>
