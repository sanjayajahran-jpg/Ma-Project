---
// komparasi.astro — Halaman Komparasi Spesifikasi Kendaraan (Theme: evnesia-v2)
import BaseLayout from "../layouts/BaseLayout.astro";
import ELECTRIFIED_CARS_DATA from "@/data/electrified-cars.json";
import ToolsBentoTiles from "../components/ToolsBentoTiles.astro";
import { getBrandLogo } from "../lib/brand-utils";

// Helper: Bersihkan nama mobil agar tidak duplikat dengan nama merek
function cleanCarName(c: any): string {
  if (!c) return "";
  const brandClean = (c.brand || "").replace(/\s*\(.*?\)/, "").trim();
  const nameClean = (c.name || "").trim();
  if (nameClean.toLowerCase().startsWith(brandClean.toLowerCase())) {
    return nameClean;
  }
  return `${brandClean} ${nameClean}`;
}

const ALL_CARS = ELECTRIFIED_CARS_DATA.map((c: any) => {
  const brandClean = (c.brand || "").replace(/\s*\(.*?\)/, "").trim();
  const displayName = cleanCarName(c);
  const sp = c.specs || {};
  const length = sp.length_mm;
  const width = sp.width_mm;
  const height = sp.height_mm;
  const dimensions = length && width && height ? `${length} × ${width} × ${height} mm` : "-";

  return {
    slug: c.slug,
    name: displayName,
    rawName: c.name,
    brand: brandClean,
    fullBrand: c.brand,
    brandLogo: getBrandLogo(c.brand),
    price: c.price || `Rp ${c.priceVal || 500} Juta`,
    priceVal: c.priceVal || 500,
    hp: c.hp || "-",
    torque: c.torque || "-",
    acc: c.acc || "-",
    topSpeed: sp.top_speed_kmh ? `${sp.top_speed_kmh} km/j` : "-",
    battery: sp.battery_capacity_kwh ? `${sp.battery_capacity_kwh} kWh` : "-",
    batteryType: sp.battery_type || "-",
    range: sp.electric_range_km ? `${sp.electric_range_km} km` : (c.consumption || "-"),
    engineType: (c.engineType || "bev").toUpperCase(),
    engineLabel: c.engineLabel || (c.engineType === "hev" ? "🍃 Full Hybrid (HEV)" : c.engineType === "phev" ? "🔌 Plug-in Hybrid (PHEV)" : "⚡ Electric (BEV)"),
    bodyType: (c.bodyType || "SUV").toUpperCase(),
    image: c.img || "/images/cars/byd-seal.png",
    transmission: sp.transmission || "Otomatis",
    drivetrain: sp.drivetrain || "FWD",
    seating: sp.seating_capacity ? `${sp.seating_capacity} Kursi` : (c.seating || "5 Kursi"),
    charging: sp.dc_charging_time_min ? `${sp.dc_charging_time_min} mnt (DC)` : (c.charging || "-"),
    v2l: sp.v2l_support || "Tidak",
    dimensions,
    wheelbase: sp.wheelbase_mm ? `${sp.wheelbase_mm} mm` : "-",
    groundClearance: sp.ground_clearance_mm ? `${sp.ground_clearance_mm} mm` : "-",
    trunk: sp.trunk_volume_liters ? `${sp.trunk_volume_liters} Liter` : "-",
    adas: sp.adas_name || (sp.safety_adas_full ? "Level 2 ADAS" : "-"),
    airbags: sp.airbag_count ? `${sp.airbag_count} Airbags` : "-",
    assembly: sp.assembly_status || "CBU",
    annualTax: sp.annual_tax_estimate || (c.engineType === "bev" ? "Rp 0 - 350.000 / thn (Bebas PKB)" : "Pajak Reguler"),
    batteryWarranty: sp.warranty_battery || "8 Tahun / 160.000 km",
    vehicleWarranty: sp.warranty_vehicle || "5 Tahun / 150.000 km",
    video: c.video || {
      youtube_id: c.youtube_video_id || "kYJvM9e2V34",
      youtube_url: c.youtube_url || `https://www.youtube.com/watch?v=${c.youtube_video_id || "kYJvM9e2V34"}`,
      search_url: `https://www.youtube.com/results?search_query=${encodeURIComponent(displayName + " review indonesia")}`,
      channel: "YouTube Review",
      title: `Review ${displayName} Indonesia`,
      duration: "18:00",
      views_label: "300 rb tayangan"
    },
  };
});

// Brand list for quick filter chips in picker with logos
const UNIQUE_BRANDS = Array.from(new Set(ALL_CARS.map(c => c.brand)))
  .sort()
  .map(b => ({
    name: b,
    logo: getBrandLogo(b)
  }));

// Preset komparasi populer
const PRESETS = [
  {
    title: "MG S5 EV vs Omoda E5",
    car1Slug: "mg-s5-ev",
    car2Slug: "chery-omoda-e5",
  },
  {
    title: "Sedan Premium: BYD Seal vs Ioniq 6",
    car1Slug: "byd-seal",
    car2Slug: "hyundai-ioniq-6",
  },
  {
    title: "Family EV: BYD M6 vs Aletra L8",
    car1Slug: "byd-m6",
    car2Slug: "aletra-l8",
  },
  {
    title: "Compact City: Binguo EV vs Neta V-II",
    car1Slug: "wuling-binguo-ev",
    car2Slug: "neta-v-ii",
  },
];

// Resolusi parameter URL (car1, car_a, slug, car2, car_b)
const urlCar1 = Astro.url.searchParams.get("car1") || Astro.url.searchParams.get("car_a") || Astro.url.searchParams.get("slug");
const urlCar2 = Astro.url.searchParams.get("car2") || Astro.url.searchParams.get("car_b");

const initialCar1 = (urlCar1 && ALL_CARS.find(c => c.slug === urlCar1)) || ALL_CARS.find(c => c.slug === "mg-s5-ev") || ALL_CARS[0];

// Cari mobil pembanding yang relevan jika car2 tidak diisi secara eksplisit
const initialCar2 = (urlCar2 && ALL_CARS.find(c => c.slug === urlCar2)) ||
  ALL_CARS.find(c => c.slug !== initialCar1.slug && (c.bodyType === initialCar1.bodyType || Math.abs(c.priceVal - initialCar1.priceVal) < 150)) ||
  ALL_CARS.find(c => c.slug !== initialCar1.slug) ||
  ALL_CARS[1];
---

<BaseLayout
  title={`Komparasi ${initialCar1.name} vs ${initialCar2.name} | EVHub.id`}
  description="Bandingkan harga OTR, jarak tempuh baterai, tenaga motor listrik, dimensi, dan fitur keselamatan ADAS secara berdampingan."
  currentPath="/komparasi"
>
  <div class="max-w-5xl mx-auto px-3.5 sm:px-6 pt-14 sm:pt-16 pb-28 sm:pb-16 space-y-6 sm:space-y-8">
    
    <!-- Hero Header -->
    <div class="text-center space-y-2 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        Head-to-Head Comparison
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Komparasi Spesifikasi Kendaraan
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
        Bandingkan 2 mobil listrik atau hybrid secara berdampingan. Klik tombol ganti untuk mencari dari 146 unit mobil resmi di Indonesia.
      </p>
    </div>

    <!-- Quick Preset Chips -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
      <span class="text-xs font-bold text-slate-400 shrink-0">Preset:</span>
      {PRESETS.map((p) => (
        <button
          type="button"
          class="preset-compare-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-cyan-500 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all cursor-pointer shadow-2xs"
          data-car1={p.car1Slug}
          data-car2={p.car2Slug}
        >
          {p.title}
        </button>
      ))}
    </div>

    <!-- Car Selector Row (Premium Interactive Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Mobil A Card -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3.5 relative overflow-hidden group">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 shadow-sm"></span>
            <span class="text-xs font-black text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">Kendaraan A</span>
          </div>
          <button
            type="button"
            id="btn-open-picker-1"
            class="touch-spring inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 border border-cyan-500/25 hover:border-cyan-500/50 text-xs font-bold transition-all cursor-pointer"
            title="Ganti Kendaraan A"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Ganti Mobil A</span>
          </button>
        </div>
        
        <!-- Preview Display A -->
        <div id="preview-car-1" class="text-center space-y-2.5 pt-1">
          <div class="aspect-video w-full max-w-72 mx-auto rounded-xl bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-3 border border-slate-100 dark:border-white/5 relative group-hover:scale-102 transition-transform duration-300">
            <img
              id="img-car-1"
              src={initialCar1.image}
              alt={initialCar1.name}
              class="max-h-full max-w-full object-contain drop-shadow-md"
              loading="eager"
              onerror="this.onerror=null; this.src='/images/cars/default-car.png';"
            />
            <span id="badge-engine-1" class="absolute bottom-2 left-2 px-2 py-0.5 rounded-md text-[9px] font-extrabold uppercase bg-cyan-500/15 border border-cyan-400/30 text-cyan-700 dark:text-cyan-300">
              {initialCar1.engineType}
            </span>
          </div>
          <div class="space-y-0.5">
            <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white" id="name-car-1">
              {initialCar1.name}
            </h2>
            <div class="text-sm font-extrabold text-cyan-600 dark:text-cyan-400 font-mono" id="price-car-1">
              {initialCar1.price}
            </div>
          </div>
        </div>
      </div>

      <!-- Mobil B Card -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm space-y-3.5 relative overflow-hidden group">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm"></span>
            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Kendaraan B</span>
          </div>
          <button
            type="button"
            id="btn-open-picker-2"
            class="touch-spring inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25 hover:border-emerald-500/50 text-xs font-bold transition-all cursor-pointer"
            title="Ganti Kendaraan B"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Ganti Mobil B</span>
          </button>
        </div>

        <!-- Preview Display B -->
        <div id="preview-car-2" class="text-center space-y-2.5 pt-1">
          <div class="aspect-video w-full max-w-72 mx-auto rounded-xl bg-slate-50 dark:bg-slate-950 flex items-center justify-center p-3 border border-slate-100 dark:border-white/5 relative group-hover:scale-102 transition-transform duration-300">
            <img
              id="img-car-2"
              src={initialCar2.image}
              alt={initialCar2.name}
              class="max-h-full max-w-full object-contain drop-shadow-md"
              loading="eager"
              onerror="this.onerror=null; this.src='/images/cars/default-car.png';"
            />
            <span id="badge-engine-2" class="absolute bottom-2 left-2 px-2 py-0.5 rounded-md text-[9px] font-extrabold uppercase bg-emerald-500/15 border border-emerald-400/30 text-emerald-700 dark:text-emerald-300">
              {initialCar2.engineType}
            </span>
          </div>
          <div class="space-y-0.5">
            <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white" id="name-car-2">
              {initialCar2.name}
            </h2>
            <div class="text-sm font-extrabold text-emerald-600 dark:text-emerald-400 font-mono" id="price-car-2">
              {initialCar2.price}
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Side-by-Side Specs Comparison Table (25+ Parameter Lengkap Terstruktur) -->
    <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-100 dark:border-white/10 bg-slate-50/80 dark:bg-slate-950/80 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Matriks Perbandingan Spesifikasi Teknis</h2>
        </div>
        <span class="text-[10px] text-slate-400 font-mono">Berdasarkan Data & Brosur Resmi APM</span>
      </div>

      <!-- Sticky Column Indicator on Mobile -->
      <div class="sticky top-14 sm:top-16 z-20 bg-slate-950/95 backdrop-blur-md border-b border-white/10 px-3 py-2 grid grid-cols-12 items-center text-xs shadow-md">
        <div class="col-span-4 text-[10px] uppercase font-bold text-slate-400">Parameter</div>
        <div class="col-span-4 font-bold text-white text-[11px] truncate flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shrink-0"></span>
          <span id="sticky-name-car-1" class="truncate">{initialCar1.name}</span>
        </div>
        <div class="col-span-4 font-bold text-white text-[11px] truncate flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span id="sticky-name-car-2" class="truncate">{initialCar2.name}</span>
        </div>
      </div>

      <div class="divide-y divide-slate-100 dark:divide-white/10 text-xs">
        
        <!-- ========================================== -->
        <!-- SEKSI 1: RINGKASAN & HARGA OTR -->
        <!-- ========================================== -->
        <div class="px-3.5 py-2.5 bg-slate-100/70 dark:bg-slate-950/70 font-extrabold text-[11px] text-slate-600 dark:text-slate-300 uppercase tracking-wider">
          1. Harga & Identitas Resmi
        </div>

        <!-- Tipe Powertrain -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Tipe Kendaraan</div>
          <div id="spec-engine-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.engineLabel}</div>
          <div id="spec-engine-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.engineLabel}</div>
        </div>

        <!-- Harga OTR -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Estimasi Harga OTR</div>
          <div id="spec-price-1" class="col-span-4 font-bold text-cyan-600 dark:text-cyan-400 font-mono">{initialCar1.price}</div>
          <div id="spec-price-2" class="col-span-4 font-bold text-emerald-600 dark:text-emerald-400 font-mono">{initialCar2.price}</div>
        </div>

        <!-- Tipe Bodi -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Tipe Bodi (Segment)</div>
          <div id="spec-body-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.bodyType}</div>
          <div id="spec-body-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.bodyType}</div>
        </div>

        <!-- Status Perakitan -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Status Produksi / Perakitan</div>
          <div id="spec-assembly-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.assembly}</div>
          <div id="spec-assembly-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.assembly}</div>
        </div>

        <!-- Pajak PKB Tahunan -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Estimasi Pajak PKB Tahunan</div>
          <div id="spec-tax-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.annualTax}</div>
          <div id="spec-tax-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.annualTax}</div>
        </div>

        <!-- ========================================== -->
        <!-- SEKSI 2: PERFORMA & POWERTRAIN -->
        <!-- ========================================== -->
        <div class="px-3.5 py-2.5 bg-slate-100/70 dark:bg-slate-950/70 font-extrabold text-[11px] text-slate-600 dark:text-slate-300 uppercase tracking-wider">
          2. Performa & Motor Penggerak
        </div>

        <!-- Tenaga Maksimum -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Tenaga Maksimum</div>
          <div id="spec-hp-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.hp}</div>
          <div id="spec-hp-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.hp}</div>
        </div>

        <!-- Torsi Maksimum -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Torsi Puncak</div>
          <div id="spec-torque-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.torque}</div>
          <div id="spec-torque-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.torque}</div>
        </div>

        <!-- Akselerasi 0-100 -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Akselerasi 0-100 km/j</div>
          <div id="spec-acc-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.acc}</div>
          <div id="spec-acc-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.acc}</div>
        </div>

        <!-- Kecepatan Puncak -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Kecepatan Maksimum</div>
          <div id="spec-speed-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.topSpeed}</div>
          <div id="spec-speed-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.topSpeed}</div>
        </div>

        <!-- Penggerak Roda -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Sistem Penggerak</div>
          <div id="spec-drive-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.drivetrain}</div>
          <div id="spec-drive-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.drivetrain}</div>
        </div>

        <!-- Transmisi -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Transmisi</div>
          <div id="spec-trans-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.transmission}</div>
          <div id="spec-trans-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.transmission}</div>
        </div>

        <!-- ========================================== -->
        <!-- SEKSI 3: BATERAI & PENGISIAN DAYA -->
        <!-- ========================================== -->
        <div class="px-3.5 py-2.5 bg-slate-100/70 dark:bg-slate-950/70 font-extrabold text-[11px] text-slate-600 dark:text-slate-300 uppercase tracking-wider">
          3. Baterai & Pengisian Daya
        </div>

        <!-- Jarak Tempuh (Range) -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Jarak Tempuh (Range)</div>
          <div id="spec-range-1" class="col-span-4 font-bold text-cyan-600 dark:text-cyan-400">{initialCar1.range}</div>
          <div id="spec-range-2" class="col-span-4 font-bold text-emerald-600 dark:text-emerald-400">{initialCar2.range}</div>
        </div>

        <!-- Kapasitas Baterai -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Kapasitas Baterai</div>
          <div id="spec-battery-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.battery}</div>
          <div id="spec-battery-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.battery}</div>
        </div>

        <!-- Tipe Sel Baterai -->
        <div class="grid grid-cols-12 p-3 items-center">
          <div class="col-span-4 font-semibold text-slate-500 dark:text-slate-400">Teknologi Sel Baterai</div>
          <div id="spec-batt-type-1" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar1.batteryType}</div>
          <div id="spec-batt-type-2" class="col-span-4 font-bold text-slate-900 dark:text-white">{initialCar2.batteryType}</div>
        </div>

        <!-- Fast Charging DC -->
        <div class="grid grid-cols-12 p-3 items-center bg-slate-50/50 dark:bg-slate-950/40">
