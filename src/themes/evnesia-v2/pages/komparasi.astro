                  <img src={car.brandLogo} alt={`Logo ${car.brand}`} class="w-full h-full object-contain" />
                </div>
                <span class="text-[10px] font-black uppercase text-cyan-400 truncate tracking-wide">{car.brand}</span>
                <span class="text-[8px] font-extrabold px-1.5 py-0.2 rounded-full bg-white/10 text-slate-300 uppercase shrink-0 border border-white/5">{car.engineType}</span>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-white truncate group-hover:text-cyan-300 transition-colors">
                {car.name}
