---
// MobileDock.astro — V2 56px Mobile Action Dock (Section 3.1 & 9 of UI_DESIGN_SPEC_EVNESIA_V2_MOBILE_FIRST.md)
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const DOCK_ITEMS = [
  {
    label: "Beranda",
    href: "/?theme_preview=evnesia-v2",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    activeMatch: (p: string) => p === "/" || p.includes("theme_preview=evnesia-v2")
  },
  {
    label: "Katalog",
    href: "/katalog-mobil",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>`,
    activeMatch: (p: string) => p.includes("/katalog-mobil") || p.includes("/mobil/")
  },
  {
    label: "Bandingkan",
    href: "/komparasi",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    activeMatch: (p: string) => p.includes("/komparasi")
  },
  {
    label: "Berita",
    href: "/kategori/berita",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>`,
    activeMatch: (p: string) => p.includes("/kategori/berita") || p.includes("/berita")
  },
  {
    label: "Tools",
    href: "/kalkulator",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
    activeMatch: (p: string) => p.includes("/kalkulator") || p.includes("/spklu")
  }
];
---

<nav
  id="v2-mobile-dock"
  class="md:hidden fixed bottom-2 left-1/2 -translate-x-1/2 z-40 w-[calc(100%-20px)] max-w-sm pointer-events-auto"
  aria-label="Menu Bawah Cepat Mobile"
>
  <div class="glass glass-pill px-2 py-1.5 h-14 flex items-center justify-around border border-slate-200/80 dark:border-white/20 bg-white/90 dark:bg-slate-950/90 shadow-2xl backdrop-blur-xl">
    {DOCK_ITEMS.map((item) => {
      const isActive = item.activeMatch(currentPath);
      return (
        <a
          href={item.href}
          class={`touch-spring flex flex-col items-center justify-center min-w-[52px] min-h-[44px] py-1 px-1.5 rounded-full active:scale-95 transition-all duration-300 ${
            isActive
              ? "text-sky-600 dark:text-sky-400 bg-sky-500/15 dark:bg-sky-500/20 font-bold border border-sky-400/35 shadow-[0_0_12px_rgba(46,155,255,0.25)]"
              : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/5"
          }`}
          aria-label={item.label}
        >
          <div class="relative transition-transform duration-300">
            <Fragment set:html={item.icon} />
            {isActive && (
              <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34e0a1] animate-pulse"></span>
            )}
          </div>
          <span class="text-[10px] mt-0.5 tracking-tight font-medium leading-none">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  @supports (padding-bottom: env(safe-area-inset-bottom)) {
    #v2-mobile-dock {
      bottom: calc(8px + env(safe-area-inset-bottom));
    }
  }
</style>
