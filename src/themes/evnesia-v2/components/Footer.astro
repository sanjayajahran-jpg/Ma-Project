<footer class="mt-8 border-t border-slate-200 dark:border-white/10 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md relative z-10" aria-label="Footer Portal">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8">
