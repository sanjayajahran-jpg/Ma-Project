---
// ToolsBentoTiles.astro — 4 Compact Tools Tiles (Section 5.1 & 6 of UI_DESIGN_SPEC_EVNESIA_V2_MOBILE_FIRST.md)
---

<section class="my-4 sm:my-6 mb-28 sm:mb-8 px-4 sm:px-6" aria-label="Alat & Fitur Tambahan">
  <div class="mb-2.5 flex items-center gap-1.5">
    <span class="w-1.5 h-3.5 rounded-full bg-blue-500"></span>
    <h2 class="text-xs sm:text-sm font-extrabold text-slate-900 dark:text-white tracking-tight">
      Tools & Ekosistem EV Pintar
    </h2>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
    <a
      href="/spklu"
      class="rounded-2xl glass-card p-3 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 hover:border-emerald-400/40 shadow-xs dark:shadow-none active:scale-97 transition-all flex flex-col justify-between group"
    >
      <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-2 group-hover:scale-110 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-300">Peta SPKLU</h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">1.200+ stasiun fast charging</p>
      </div>
    </a>

    <a
      href="/komparasi"
      class="rounded-2xl glass-card p-3 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 hover:border-sky-400/40 shadow-xs dark:shadow-none active:scale-97 transition-all flex flex-col justify-between group"
    >
      <div class="w-8 h-8 rounded-lg bg-sky-500/15 border border-sky-400/30 flex items-center justify-center text-sky-600 dark:text-sky-400 mb-2 group-hover:scale-110 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-300">Komparasi</h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">Adu spesifikasi head-to-head</p>
      </div>
    </a>

    <a
      href="/katalog-mobil"
      class="rounded-2xl glass-card p-3 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 hover:border-blue-400/40 shadow-xs dark:shadow-none active:scale-97 transition-all flex flex-col justify-between group"
    >
      <div class="w-8 h-8 rounded-lg bg-blue-500/15 border border-blue-400/30 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-2 group-hover:scale-110 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-300">146+ Mobil EV</h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">Katalog & harga OTR resmi</p>
      </div>
    </a>

    <a
      href="/pedoman-pemberitaan"
      class="rounded-2xl glass-card p-3 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 hover:border-amber-400/40 shadow-xs dark:shadow-none active:scale-97 transition-all flex flex-col justify-between group"
    >
      <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-amber-600 dark:text-amber-400 mb-2 group-hover:scale-110 transition-transform">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-300">Insentif PPN 1%</h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">Bebas ganjil-genap & PKB 0%</p>
      </div>
    </a>
  </div>
</section>
