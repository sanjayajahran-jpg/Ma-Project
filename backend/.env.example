# Server Configuration
PROJECT_NAME="AutoDrive PRO API"
API_V1_STR="/api/v1"
SECRET_KEY="autodrive-super-secret-key-change-this-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 Hours

# Database Configuration
# Untuk SQLite (Default, langsung jalan tanpa setup):
DATABASE_URL="sqlite:///./autodrive.db"
# Untuk MySQL (Uncomment jika menggunakan MySQL):
# DATABASE_URL="mysql+pymysql://root:@localhost:3306/autodrive?charset=utf8mb4"

# CORS Origins (Frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321","http://localhost:3000"]

# -------------------------------------------------------------
# Cloud Storage S3 / Cloudflare R2 Configuration
# -------------------------------------------------------------
# Biarkan kosong jika ingin menggunakan penyimpanan lokal.
# Isi kredensial jika ingin langsung tersimpan di Cloud Storage S3.
S3_ENDPOINT_URL=""           # Contoh Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""          # Access Key ID dari AWS / Cloudflare R2
S3_SECRET_ACCESS_KEY=""      # Secret Access Key
S3_BUCKET_NAME=""            # Nama Bucket S3
S3_REGION_NAME="ap-southeast-1"
S3_PUBLIC_DOMAIN=""          # Domain Publik / CDN URL (cth: https://pub-xxx.r2.dev)
